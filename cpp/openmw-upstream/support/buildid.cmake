# Writes OUT (generated/buildid.hpp) with the commit SOURCE is checked out at, -dirty with uncommitted changes, and the
# time; the file is left alone while a clean commit is the same (a dirty tree is written each build, for its time)
find_package(Git QUIET)
set(commit "unknown")
if (GIT_FOUND)
    execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SOURCE} describe --always --dirty --abbrev=10
        OUTPUT_VARIABLE described OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE failed ERROR_QUIET)
    if (NOT failed AND described)
        set(commit ${described})
    endif()
endif()
if (EXISTS ${OUT} AND NOT commit MATCHES "-dirty$")
    file(READ ${OUT} old)
    if (old MATCHES "ALPHA3_BUILD_COMMIT \"${commit}\"")
        return()
    endif()
endif()
string(TIMESTAMP now "%Y-%m-%d %H:%M")
file(WRITE ${OUT} "// Written by support/buildid.cmake\n#pragma once\n#define ALPHA3_BUILD_COMMIT \"${commit}\"\n#define ALPHA3_BUILD_TIME \"${now}\"\n")
