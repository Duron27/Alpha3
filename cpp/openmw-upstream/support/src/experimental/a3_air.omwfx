uniform_bool uA3DustOn {
    default = true;
    description = "Dust, ash and snow in the wind, motes in the light";
    display_name = "Dust in the wind";
}

uniform_bool uA3ShaftsOn {
    default = true;
    description = "Shafts of sunlight";
    display_name = "Light shafts";
}

uniform_float uA3Dust {
    default = 1.0;
    min = 0.0;
    max = 3.0;
    step = 0.05;
    description = "Dust, ash and snow blown along in the wind, motes drifting in the light";
    display_name = "Dust strength";
}

uniform_float uA3Shafts {
    default = 1.0;
    min = 0.0;
    max = 3.0;
    step = 0.05;
    description = "Shafts of sunlight through trees and gaps";
    display_name = "Light shaft strength";
}

uniform_float uA3StormHaze {
    default = 1.0;
    min = 0.0;
    max = 2.0;
    step = 0.05;
    description = "Haze of blown dust in ash and blight storms and blizzards";
    display_name = "Storm haze";
}

render_target RT_A3Shafts {
    width_ratio = 0.25;
    height_ratio = 0.25;
    internal_format = rgba16f;
    source_type = half_float;
    source_format = rgba;
}

fragment shafts(target=RT_A3Shafts) {
    // The shafts of sunlight at quarter resolution: from each pixel looking toward the sun, how much open sky lies
    // between it and the sun on the screen (red)


    omw_In vec2 omw_TexCoord;

    float a3Dither(vec2 uv)
    {
        vec2 p = uv * omw.resolution;
        return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
    }

    void main()
    {
        vec2 uv = omw_TexCoord;
        omw_FragColor = vec4(0.0);
        if (uA3ShaftsOn) {
        vec3 sunDir = normalize(omw.sunPos.xyz);
        if (omw.isInterior || omw.sunVis < 0.01 || sunDir.z < -0.05)
            return;
        vec3 dir = normalize(omw_GetWorldPosFromUV(uv) - omw.eyePos.xyz);
        float facing = pow(max(dot(dir, sunDir), 0.0), 3.0);
        vec4 sunClip = omw.projectionMatrix * (omw.viewMatrix * vec4(sunDir, 0.0));
        if (sunClip.w <= 0.0 || facing < 0.02)
            return;
        vec2 sunUv = sunClip.xy / sunClip.w * 0.5 + 0.5;
        vec2 off = max(abs(sunUv - 0.5) - 0.5, 0.0);
        float onScreen = 1.0 - smoothstep(0.0, 0.6, length(off));
        if (onScreen <= 0.0)
            return;
        const int samples = 12;
        vec2 delta = (sunUv - uv) / float(samples) * 0.85;
        vec2 p = uv + delta * a3Dither(uv);
        float lit = 0.0;
        float weight = 1.0;
        for (int i = 0; i < samples; ++i)
        {
            lit += (omw_GetLinearDepth(p) >= omw.far * 0.98 ? 1.0 : 0.0) * weight;
            weight *= 0.9;
            p += delta;
        }
        omw_FragColor = vec4(lit / float(samples) * facing * onScreen, 0.0, 0.0, 1.0);
        }
    }
}

fragment air(rt1=RT_A3Shafts) {
    // (OpenMW's .omwfx parser reads comments only inside blocks of GLSL, so this file's notes are here)
    // The air of the experimental graphics (F2 menu: wind dust, light shafts), served as shaders/a3_air.omwfx
    // every setting live in the F2 menu (shaders.yaml keeps them).
    //  - dust: specks in three layers at different distances, fixed in the world and carried by the wind (storms blow
    //    toward +Y), stretched into streaks when it blows hard; ash grey in ash storms, red in blight, white in snow;
    //    sparse motes glinting in the sun otherwise
    //  - shafts: the sky's light smeared from the sun across the screen, blocked by what stands in front of it


    omw_In vec2 omw_TexCoord;

    float a3Hash3(vec3 p)
    {
        p = mod(p, 289.0);
        p = fract(p * 0.3183099 + 0.1);
        p *= 17.0;
        return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
    }

    float a3Dither(vec2 uv)
    {
        vec2 p = uv * omw.resolution;
        return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
    }

    // a storm's kind of weather (ash 6, blight 7, blizzard 9), blended through transitions
    float a3IsStorm(int id)
    {
        return id == 6 || id == 7 || id == 9 ? 1.0 : 0.0;
    }

    vec3 a3StormColour(int id)
    {
        if (id == 7)
            return vec3(0.55, 0.32, 0.25);
        if (id == 9)
            return vec3(0.85, 0.88, 0.92);
        return vec3(0.5, 0.45, 0.4);
    }

    void main()
    {
        vec2 uv = omw_TexCoord;
        vec3 c = omw_GetLastShader(uv).rgb;
        if (omw.isInterior)
        {
            omw_FragColor = vec4(c, 1.0);
            return;
        }
        vec3 eye = omw.eyePos.xyz;
        vec3 world = omw_GetWorldPosFromUV(uv);
        float sceneDistance = length(world - eye);
        vec3 dir = (world - eye) / max(sceneDistance, 0.001);
        vec3 sunDir = normalize(omw.sunPos.xyz);
        float time = omw.simulationTime;
        float transition = omw.weatherTransition;
        float storm = mix(a3IsStorm(omw.weatherID), a3IsStorm(omw.nextWeatherID), transition);
        vec3 stormColour = mix(a3StormColour(omw.weatherID), a3StormColour(omw.nextWeatherID), transition);
        vec3 light = omw.ambientColor.rgb + omw.sunColor.rgb * omw.sunVis * max(sunDir.z, 0.0);

        if (uA3DustOn) {
        if (uA3Dust > 0.0)
        {
            // a steady speed (the time scaled by the wind or the storm as they are now would jump as they change); the
            // storm shows in the streaks and how many
            vec3 blow = vec3(0.15, 1.0, 0.0) * time * 260.0;
            float specks = 0.0;
            for (int i = 0; i < 2; ++i)
            {
                float d = 140.0 * pow(3.2, float(i));
                if (d > sceneDistance)
                    break;
                // the cell the ray is in at that distance, and the speck in it: how near the ray passes it
                float cell = 40.0 * (1.0 + float(i));
                vec3 squash = vec3(1.0, mix(1.0, 0.25, storm), 1.0); // streaks along the wind in a storm
                vec3 bob = vec3(0.0, 0.0, sin(time * 0.7 + float(i)) * 20.0);
                vec3 origin = (eye + blow + bob) / cell * squash;
                vec3 ray = normalize(dir * squash);
                vec3 id = floor(origin + ray * d / cell);
                float h = a3Hash3(id);
                // most cells have no speck: nothing more to work out there
                if (h < 1.0 - mix(0.12, 0.9, storm))
                    continue;
                vec3 offset = vec3(a3Hash3(id + 7.1), a3Hash3(id + 3.3), a3Hash3(id + 1.7)) - 0.5;
                vec3 centre = id + 0.5 + offset * 0.6;
                vec3 toCentre = centre - origin;
                float along = dot(toCentre, ray);
                float miss = length(toCentre - ray * along);
                float size = 0.022 + 0.02 * h;
                float speck = (1.0 - smoothstep(size * 0.35, size, miss)) * step(0.0, along)
                    * step(along * cell, sceneDistance);
                float present = step(1.0 - mix(0.12, 0.9, storm), h);
                specks += speck * present / (1.0 + float(i));
            }
            // motes glint in the sun, storm dust shows in any light
            float glint = 0.7 + 2.0 * pow(max(dot(dir, sunDir), 0.0), 6.0) * omw.sunVis;
            vec3 speckColour = mix(vec3(1.0, 0.95, 0.8) * glint, stormColour, storm);
            c = mix(c, speckColour * light * 1.2, clamp(specks * uA3Dust * mix(0.35, 0.85, storm), 0.0, 0.85));
            // the storm's haze, thicker with distance
            float haze = storm * uA3StormHaze * (1.0 - exp(-sceneDistance / 2500.0)) * 0.55 * min(uA3Dust, 1.0);
            c = mix(c, stormColour * light, haze);
        }
        }

        if (uA3ShaftsOn) {
        // worked out at quarter resolution by the pass before
        if (uA3Shafts > 0.0)
            c += omw.sunColor.rgb * omw_Texture2D(RT_A3Shafts, uv).r * omw.sunVis * uA3Shafts * 0.5 * (1.0 - 0.7 * storm);
        }

        omw_FragColor = vec4(c, 1.0);
    }
}

technique {
    description = "Alpha3 experimental: dust in the wind, motes and shafts of light";
    version = "1.0";
    author = "Alpha3";
    passes = shafts, air;
    flags = disable_interiors, disable_underwater;
}
