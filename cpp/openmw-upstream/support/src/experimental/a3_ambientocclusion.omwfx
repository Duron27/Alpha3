render_target RT_A3Occlusion {
    width_ratio = 0.5;
    height_ratio = 0.5;
    internal_format = r16f;
    source_type = half_float;
    source_format = red;
    min_filter = linear;
    mag_filter = linear;
}

uniform_float uA3Radius {
    default = 60.0;
    min = 10.0;
    max = 300.0;
    step = 5.0;
    description = "How far around a point (game units) the scene darkens it";
}

uniform_float uA3Strength {
    default = 1.0;
    min = 0.0;
    max = 3.0;
    step = 0.05;
    description = "How dark the occlusion is";
}

fragment occlusion(target=RT_A3Occlusion) {
    // (OpenMW's .omwfx parser reads comments only inside blocks of GLSL, so this file's notes are here)
    // Ambient occlusion of the experimental graphics ([Experimental] ambient occlusion): corners, the ground under things
    // and the gaps between rocks darkened by how much of the scene around a point faces it. Served in the VFS as
    // shaders/a3_ambientocclusion.omwfx and put in the post-processing chain by src/experimental.cpp.
    //
    // The occlusion is worked out at half the resolution from the depth alone (the view position of a pixel from its linear
    // depth, its normal from the positions next to it), in the manner of McGuire's Alchemy AO, then blurred with a filter
    // that keeps to the depth and multiplied into the scene's colour.

    omw_In vec2 omw_TexCoord;

    vec3 a3ViewPos(vec2 uv)
    {
        float depth = omw_GetLinearDepth(uv);
        vec2 ndc = uv * 2.0 - 1.0;
        return vec3(ndc.x / omw.projectionMatrix[0][0], ndc.y / omw.projectionMatrix[1][1], -1.0) * depth;
    }

    void main()
    {
        vec2 uv = omw_TexCoord;
        float depth = omw_GetLinearDepth(uv);
        if (depth > omw.far * 0.9 || depth > 6000.0)
        {
            omw_FragColor = vec4(1.0);
            return;
        }
        vec3 p = a3ViewPos(uv);
        vec2 px = omw.rcpResolution * 2.0;
        vec3 n = normalize(cross(a3ViewPos(uv + vec2(px.x, 0.0)) - p, a3ViewPos(uv + vec2(0.0, px.y)) - p));
        if (dot(n, p) > 0.0)
            n = -n; // toward the camera

        // the radius on the screen, and a spiral of samples turned by a per-pixel angle (the blur evens it out)
        float screenRadius = uA3Radius * omw.projectionMatrix[1][1] * 0.5 / depth;
        screenRadius = min(screenRadius, 0.1);
        float angle = fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453) * 6.2831853;
        const int count = 10;
        float sum = 0.0;
        for (int i = 0; i < count; ++i)
        {
            float t = (float(i) + 0.5) / float(count);
            float a = angle + float(i) * 2.3999632; // the golden angle
            vec2 offset = vec2(cos(a), sin(a)) * screenRadius * t;
            vec3 v = a3ViewPos(uv + offset) - p;
            float vv = dot(v, v);
            // what is beyond the radius does not count, so a far wall behind an edge does not darken it
            float range = 1.0 - smoothstep(uA3Radius * uA3Radius, 4.0 * uA3Radius * uA3Radius, vv);
            sum += max(dot(v, n) - 0.02 * depth, 0.0) / (vv + 1.0) * range;
        }
        float occlusion = max(0.0, 1.0 - 2.0 * uA3Strength * sum * uA3Radius / float(count));
        // fades out with distance: far off it only shows as noise
        occlusion = mix(occlusion, 1.0, smoothstep(3000.0, 6000.0, depth));
        omw_FragColor = vec4(occlusion, occlusion, occlusion, 1.0);
    }
}

fragment apply(rt1=RT_A3Occlusion) {
    omw_In vec2 omw_TexCoord;

    void main()
    {
        vec2 uv = omw_TexCoord;
        float depth = omw_GetLinearDepth(uv);
        // 3x3 taps of the half size occlusion, weighted down where the depth differs (an edge)
        float sum = 0.0;
        float weights = 0.0;
        for (int y = -1; y <= 1; ++y)
            for (int x = -1; x <= 1; ++x)
            {
                vec2 offset = vec2(float(x), float(y)) * omw.rcpResolution * 2.0;
                float d = omw_GetLinearDepth(uv + offset);
                float w = 1.0 / (1.0 + abs(d - depth) * 40.0 / max(depth, 1.0));
                sum += omw_Texture2D(RT_A3Occlusion, uv + offset).r * w;
                weights += w;
            }
        float occlusion = sum / weights;
        // less in fog, and none on the sky
        occlusion = mix(occlusion, 1.0, omw_EstimateFogCoverageFromUV(uv));
        vec4 colour = omw_GetLastShader(uv);
        omw_FragColor = vec4(colour.rgb * occlusion, colour.a);
    }
}

technique {
    description = "Alpha3 experimental: ambient occlusion from the depth";
    version = "1.0";
    author = "Alpha3";
    passes = occlusion, apply;
    flags = disable_underwater;
}
