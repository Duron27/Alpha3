diff --git a/components/sdlutil/drawablesize.hpp b/components/sdlutil/drawablesize.hpp
new file mode 100644
index 0000000000..2f5eb933d9
--- /dev/null
+++ b/components/sdlutil/drawablesize.hpp
@@ -0,0 +1,20 @@
+#ifndef OPENMW_COMPONENTS_SDLUTIL_DRAWABLESIZE_H
+#define OPENMW_COMPONENTS_SDLUTIL_DRAWABLESIZE_H
+
+#include <SDL_metal.h>
+#include <SDL_video.h>
+
+namespace SDLUtil
+{
+    // The size of the window in pixels. SDL_GL_GetDrawableSize only knows SDL's own OpenGL views: for a Metal window
+    // (iOS with ANGLE) it gives the size in points, the Metal layer has the pixels.
+    inline void getDrawableSize(SDL_Window* window, int* width, int* height)
+    {
+        if (SDL_GetWindowFlags(window) & SDL_WINDOW_METAL)
+            SDL_Metal_GetDrawableSize(window, width, height);
+        else
+            SDL_GL_GetDrawableSize(window, width, height);
+    }
+}
+
+#endif
