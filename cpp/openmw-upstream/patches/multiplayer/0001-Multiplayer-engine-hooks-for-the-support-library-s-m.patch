+    void CustomMarkerCollection::setTransient(std::vector<PlayerMarker> markers)
+    {
+        TransientContainerType next;
+        for (PlayerMarker& marker : markers)
+        {
+            const ESM::RefId cell = marker.mMarker.mCell;
+            next.emplace(cell, std::move(marker));
+        }
+
+        // Who is on the map, in which cell and in which colour. While that is unchanged only positions moved, and
+        // rebuilding every marker widget each time the list is refreshed makes the markers flicker and vanish.
+        auto describe = [](const TransientContainerType& players) {
+            std::map<std::string, std::tuple<ESM::RefId, bool, bool>> result;
+            for (const auto& [cell, player] : players)
+                result.emplace(player.mMarker.mNote, std::make_tuple(cell, player.mGroup, player.mExterior));
+            return result;
+        };
+        const bool sameSet = next.size() == mTransient.size() && describe(next) == describe(mTransient);
+        bool moved = false;
+        if (sameSet)
+        {
+            for (const auto& [cell, player] : next)
+            {
+                const PlayerMarker* before = findTransient(player.mMarker.mNote);
+                if (!before || before->mMarker.mWorldX != player.mMarker.mWorldX
+                    || before->mMarker.mWorldY != player.mMarker.mWorldY || before->mInfo != player.mInfo)
+                {
+                    moved = true;
+                    break;
+                }
+            }
+        }
+
+        mTransient = std::move(next);
+        if (!sameSet)
+            eventMarkersChanged();
+        else if (moved)
+            eventTransientMoved();
+    }
+
+    CustomMarkerCollection::TransientRangeType CustomMarkerCollection::getTransientMarkers(
+        const ESM::RefId& cellId) const
+    {
+        return mTransient.equal_range(cellId);
+    }
+
+    const PlayerMarker* CustomMarkerCollection::findTransient(std::string_view name) const
+    {
+        for (const auto& [cell, player] : mTransient)
+        {
+            if (player.mMarker.mNote == name)
+                return &player;
+        }
+        return nullptr;
+    }
