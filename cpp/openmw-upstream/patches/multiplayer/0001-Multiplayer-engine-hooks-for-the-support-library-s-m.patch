     }
     engine.addContentFile("builtin.omwscripts");
     std::set<std::string> contentDedupe{ "builtin.omwscripts" };
+    // Other built-in script lists (resources/vfs/*.omwscripts, e.g. the multiplayer mod's mp.omwscripts). They are
+    // separate files so that a file of the same name in a client mod folder, which comes later in the data directories,
+    // replaces them.
+    {
+        std::vector<std::string> lists;
+        std::error_code listError;
+        const std::filesystem::path vfsDir = variables["resources"].as<Files::MaybeQuotedPath>();
+        for (std::filesystem::directory_iterator it(vfsDir / "vfs", listError), end; !listError && it != end;
+             it.increment(listError))
+        {
+            const std::string name = it->path().filename().string();
+            if (it->path().extension() == ".omwscripts" && name != "builtin.omwscripts")
+                lists.push_back(name);
+        }
+        std::sort(lists.begin(), lists.end());
+        for (const std::string& list : lists)
+        {
+            engine.addContentFile(list);
+            contentDedupe.insert(list);
+        }
+    }
+    for (const std::string& script : clientModScripts)
+    {
+        if (contentDedupe.insert(script).second)
+            engine.addContentFile(script);
+    }
     for (const auto& contentFile : content)
     {
         if (!contentDedupe.insert(contentFile).second)
@@ -229,6 +266,14 @@ int runApplication(int argc, char* argv[])
