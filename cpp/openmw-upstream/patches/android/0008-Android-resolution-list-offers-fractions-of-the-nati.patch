diff --git a/components/sdlutil/sdlinputwrapper.cpp b/components/sdlutil/sdlinputwrapper.cpp
index f80eb9faa2..44a819271e 100644
--- a/components/sdlutil/sdlinputwrapper.cpp
+++ b/components/sdlutil/sdlinputwrapper.cpp
@@ -266,6 +266,25 @@ namespace SDLUtil
                 if (w == 0 && h == 0)
                     return;
 
+#ifdef ANDROID
+                {
+                    // The stored mouse position is in the old window's coordinates (the in-game resolution list resizes
+                    // the surface): scale it so the on-screen cursor stays where the player last touched.
+                    static int lastWidth = 0;
+                    static int lastHeight = 0;
+                    if (lastWidth > 0 && lastHeight > 0 && (lastWidth != w || lastHeight != h)
+                        && SDL_ShowCursor(SDL_QUERY) == SDL_ENABLE)
+                    {
+                        int mouseX = 0;
+                        int mouseY = 0;
+                        SDL_GetMouseState(&mouseX, &mouseY);
+                        SDL_WarpMouseInWindow(mSDLWindow, mouseX * w / lastWidth, mouseY * h / lastHeight);
+                    }
+                    lastWidth = w;
+                    lastHeight = h;
+                }
+#endif
+
                 mViewer->getCamera()->getGraphicsContext()->resized(x, y, w, h);
 
                 mViewer->getEventQueue()->windowResize(x, y, w, h);
diff --git a/components/sdlutil/sdlvideowrapper.cpp b/components/sdlutil/sdlvideowrapper.cpp
index 69153bb40b..cd3418f939 100644
--- a/components/sdlutil/sdlvideowrapper.cpp
+++ b/components/sdlutil/sdlvideowrapper.cpp
@@ -8,8 +8,39 @@
 
 #include <SDL_video.h>
 
+#ifdef ANDROID
+#include <SDL_system.h>
+#include <jni.h>
+#endif
+
 namespace SDLUtil
 {
+#ifdef ANDROID
+    namespace
+    {
+        // The Android surface has a fixed size that the activity can change (SDLActivity.setSurfaceResolution). SDL then
+        // reports an ordinary resize, which the rest of the engine already handles.
+        bool setAndroidSurfaceResolution(int width, int height)
+        {
+            auto* env = static_cast<JNIEnv*>(SDL_AndroidGetJNIEnv());
+            auto activity = static_cast<jobject>(SDL_AndroidGetActivity());
+            if (env == nullptr || activity == nullptr)
+                return false;
+
+            jclass activityClass = env->GetObjectClass(activity);
+            jmethodID method = env->GetMethodID(activityClass, "setSurfaceResolution", "(II)V");
+            const bool found = method != nullptr;
+            if (found)
+                env->CallVoidMethod(activity, method, width, height);
+            else
+                env->ExceptionClear();
+            env->DeleteLocalRef(activityClass);
+            env->DeleteLocalRef(activity);
+            return found;
+        }
+    }
+#endif
+
 
     VideoWrapper::VideoWrapper(SDL_Window* window, osg::ref_ptr<osgViewer::Viewer> viewer)
         : mWindow(window)
@@ -81,6 +112,11 @@ namespace SDLUtil
 
     void VideoWrapper::setVideoMode(int width, int height, Settings::WindowMode windowMode, bool windowBorder)
     {
+#ifdef ANDROID
+        if (setAndroidSurfaceResolution(width, height))
+            return;
+#endif
+
         SDL_SetWindowFullscreen(mWindow, 0);
 
         if (SDL_GetWindowFlags(mWindow) & SDL_WINDOW_MAXIMIZED)
