 apps/openmw/mwgui/windowmanagerimp.cpp        | 10 ++++
 apps/openmw/mwinput/mousemanager.cpp          |  2 +-
 .../myguiplatform/myguirendermanager.cpp      |  6 +++
 .../myguiplatform/myguirendermanager.hpp      |  3 ++
