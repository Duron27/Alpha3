 8 files changed, 124 insertions(+), 3 deletions(-)

diff --git a/apps/openmw/mwgui/settingswindow.cpp b/apps/openmw/mwgui/settingswindow.cpp
index c692988220..a5541a653d 100644
--- a/apps/openmw/mwgui/settingswindow.cpp
+++ b/apps/openmw/mwgui/settingswindow.cpp
@@ -269,6 +269,27 @@ namespace MWGui
         getWidget(unusedSlider, widgetName);
         unusedSlider->setVisible(false);
 
+#ifdef ANDROID
+        {
+            // Gamma does nothing on Android: its slider sets the interface scale instead, applied at once
+            MyGUI::ScrollBar* scaleSlider;
+            getWidget(scaleSlider, "GammaSlider");
+            scaleSlider->setScrollRange(36); // 0.5 to 4.0 in steps of 0.1
+            scaleSlider->setScrollPage(1);
+            scaleSlider->setScrollWheelPage(1);
+            scaleSlider->setUserString("SettingCategory", "GUI");
+            scaleSlider->setUserString("SettingName", "scaling factor");
+            scaleSlider->setUserString("SettingMin", "0.5");
+            scaleSlider->setUserString("SettingMax", "4.0");
+            scaleSlider->setUserString("SettingLabelCaption", "InterfaceScaleValue");
+            MyGUI::TextBox* textBox;
+            getWidget(textBox, "GammaTextDark");
+            textBox->setCaption("#{OMWEngine:InterfaceScaleSmaller}");
+            getWidget(textBox, "GammaTextLight");
+            textBox->setCaption("#{OMWEngine:InterfaceScaleLarger}");
+        }
+#endif
+
         configureWidgets(mMainWidget, true);
 
         setTitle("#{OMWEngine:SettingsWindow}");
@@ -311,7 +332,7 @@ namespace MWGui
         getWidget(mObjectShadowsButton, "ObjectShadowsButton");
         getWidget(mShadowMapResolution, "ShadowMapResolution");
 
-#ifndef WIN32
+#if !defined(WIN32) && !defined(ANDROID)
         // hide gamma controls since it currently does not work under Linux
         MyGUI::ScrollBar* gammaSlider;
         getWidget(gammaSlider, "GammaSlider");
@@ -379,14 +400,31 @@ namespace MWGui
 
         // fill resolution list
         const int screen = Settings::video().mScreen;
-        int numDisplayModes = SDL_GetNumDisplayModes(screen);
         std::vector<std::pair<int, int>> resolutions;
+#ifdef ANDROID
+        // SDL lists only the native mode on Android. Offer fractions of it: choosing one resizes the surface in place
+        // (see VideoWrapper::setVideoMode), so this works as a render scale.
+        SDL_DisplayMode nativeMode;
+        if (SDL_GetDesktopDisplayMode(screen, &nativeMode) == 0)
+        {
+            const int nativeW = std::max(nativeMode.w, nativeMode.h);
+            const int nativeH = std::min(nativeMode.w, nativeMode.h);
+            for (const int percent : { 100, 90, 80, 75, 67, 60, 50, 40, 33, 25 })
+            {
+                const int w = (nativeW * percent / 100) / 2 * 2;
+                const int h = (nativeH * percent / 100) / 2 * 2;
+                resolutions.emplace_back(w, h);
+            }
+        }
+#else
+        int numDisplayModes = SDL_GetNumDisplayModes(screen);
         for (int i = 0; i < numDisplayModes; i++)
         {
             SDL_DisplayMode mode;
             SDL_GetDisplayMode(screen, i, &mode);
             resolutions.emplace_back(mode.w, mode.h);
         }
+#endif
         std::sort(resolutions.begin(), resolutions.end(), sortResolutions);
         for (std::pair<int, int>& resolution : resolutions)
         {
@@ -504,6 +542,12 @@ namespace MWGui
         if (index == MyGUI::ITEM_NONE)
             return;
 
+#ifdef ANDROID
+        // Applies at once, and a bad pick is one tap away from being undone.
+        onResolutionAccept();
+        return;
+#endif
+
         ConfirmationDialog* dialog = MWBase::Environment::get().getWindowManager()->getConfirmationDialog();
         dialog->askForConfirmation("#{OMWEngine:ConfirmResolution}");
         dialog->eventOkClicked.clear();
