+    void Scene::promoteCell(CellStore& cell, const DetourNavigator::UpdateGuard* navigatorUpdateGuard)
+    {
+        Log(Debug::Info) << "Seamless doors: " << cell.getCell()->getDescription() << " is now a current cell";
+        mSecondaryCells.erase(&cell);
+        mActiveCells.insert(&cell);
+        mRendering.setCellSecondary(&cell, nullptr);
+        addCellNavigation(cell, navigatorUpdateGuard);
+        finishCellLoad(cell, navigatorUpdateGuard);
+    }
+
+    void Scene::demoteCell(CellStore& cell, osg::Group* parent, const DetourNavigator::UpdateGuard* navigatorUpdateGuard)
+    {
+        Log(Debug::Info) << "Seamless doors: " << cell.getCell()->getDescription() << " kept behind the door";
+        removeCellNavigation(cell, navigatorUpdateGuard);
+        mRendering.setCellSecondary(&cell, parent);
+        MWBase::Environment::get().getWindowManager()->removeCell(&cell);
+        mActiveCells.erase(&cell);
+        mSecondaryCells.insert(&cell);
+    }
