+    osg::Vec3f SeamlessDoors::toSpace(const osg::Vec3f& point, const CellStore* from, const CellStore* to) const
+    {
+        const bool fromBehind = behindDoor(from);
+        if (fromBehind == behindDoor(to))
+            return point;
+        return fromBehind ? point * mFromOther : point * mToOther;
+    }
+
+    float SeamlessDoors::yawToSpace(float yaw, const CellStore* from, const CellStore* to) const
+    {
+        const bool fromBehind = behindDoor(from);
+        if (fromBehind == behindDoor(to))
+            return yaw;
+        return fromBehind ? yaw - mYaw : yaw + mYaw;
+    }
+
+    bool SeamlessDoors::doorwayIn(const CellStore* from, DoorwayView& view) const
+    {
+        if (mLiveCells.empty() || !from)
+            return false;
+        view.mHalfWidth = mHalfWidth;
+        view.mHeight = mHeight;
+        if (behindDoor(from))
+        {
+            const osg::Quat turn = mToOther.getRotate();
+            view.mCentre = mCentre * mToOther;
+            // toward the room there (the side away from this one)
+            view.mNormal = -(turn * mNormal);
+            view.mAcross = turn * mAcross;
+            return true;
+        }
+        view.mCentre = mCentre;
+        view.mNormal = mNormal;
+        view.mAcross = mAcross;
+        return true;
+    }
+
+    bool SeamlessDoors::passDoorway(osg::Vec3f& from, const osg::Vec3f& to, osg::Quat& turn, osg::Node* node)
+    {
+        SeamlessDoors* doors = sInstance.get();
+        if (!doors || doors->mLiveCells.empty() || doors->mSwing <= 0.5f)
+            return false;
+        for (const bool behind : { false, true })
+        {
+            DoorwayView view;
+            if (!doors->doorwayIn(behind ? doors->mLiveCells.front() : doors->mDoor.getCell(), view))
+                continue;
+            const float fromOut = (from - view.mCentre) * view.mNormal;
+            const float toOut = (to - view.mCentre) * view.mNormal;
+            if (fromOut < 0.f || toOut >= 0.f)
+                continue;
+            const osg::Vec3f crossing = from + (to - from) * (fromOut / (fromOut - toOut));
+            const osg::Vec3f relative = crossing - view.mCentre;
+            if (std::abs(relative * view.mAcross) > view.mHalfWidth || relative.z() < 0.f
+                || relative.z() > view.mHeight)
+                continue;
+            const osg::Matrixd& place = behind ? doors->mFromOther : doors->mToOther;
+            from = from * place;
+            turn = place.getRotate();
+            // drawn on that side: behind the door, under the live cells' group
+            if (node && doors->mContent && doors->mContent->mLive)
+            {
+                osg::ref_ptr<osg::Node> keep = node;
+                osg::Group* parent = node->getNumParents() > 0 ? node->getParent(0) : nullptr;
+                if (!behind)
+                {
+                    if (parent)
+                        doors->mProjectileRoot = parent;
+                    if (parent)
+                        parent->removeChild(node);
+                    doors->mContent->mLive->addChild(node);
+                }
+                else if (doors->mProjectileRoot.valid())
+                {
+                    if (parent)
+                        parent->removeChild(node);
+                    doors->mProjectileRoot->addChild(node);
+                }
+            }
+            return true;
+        }
+        return false;
+    }
+
+    bool SeamlessDoors::toOtherSide(const ConstPtr& owner, osg::Vec3f& point)
+    {
+        const SeamlessDoors* doors = sInstance.get();
+        if (!doors || doors->mLiveCells.empty() || !owner.isInCell())
+            return false;
+        point = doors->behindDoor(owner.getCell()) ? point * doors->mFromOther : point * doors->mToOther;
+        return true;
+    }
+
+    bool SeamlessDoors::anyLive()
+    {
+        return sInstance && !sInstance->mLiveCells.empty();
+    }
+
+    osg::Vec3f SeamlessDoors::pointFor(const osg::Vec3f& point, const ConstPtr& owner, const ConstPtr& viewer)
+    {
+        const SeamlessDoors* doors = sInstance.get();
+        if (!doors || doors->mLiveCells.empty() || !owner.isInCell() || !viewer.isInCell())
+            return point;
+        return doors->toSpace(point, owner.getCell(), viewer.getCell());
+    }
+
+    osg::Vec3f SeamlessDoors::positionFor(const ConstPtr& ptr, const ConstPtr& viewer)
+    {
+        return pointFor(ptr.getRefData().getPosition().asVec3(), ptr, viewer);
+    }
+
+    bool SeamlessDoors::wayThrough(const ConstPtr& actor, const ConstPtr& target, osg::Vec3f& destination, bool& straight)
+    {
+        if (!apart(actor, target))
+            return false;
+        DoorwayView view;
+        if (!sInstance->doorwayIn(actor.getCell(), view))
+            return false;
+        const osg::Vec3f position = actor.getRefData().getPosition().asVec3();
+        const osg::Vec3f relative = position - view.mCentre;
+        const float out = relative * view.mNormal;
+        const float along = relative * view.mAcross;
+        // in front of the doorway and about level with it: straight through (opening the door if it is shut)
+        straight = out < 160.f && std::abs(along) < view.mHalfWidth + 24.f && std::abs(relative.z()) < 96.f;
+        if (straight && !sInstance->mOpening)
+        {
+            sInstance->mOpening = true;
+            Log(Debug::Verbose) << "Seamless doors: " << actor.getCellRef().getRefId() << " opens the door";
+        }
+        destination = straight ? view.mCentre - view.mNormal * 120.f : view.mCentre + view.mNormal * 80.f;
+        return true;
+    }
+
+    bool SeamlessDoors::heard(const ConstPtr& listener, const ConstPtr& source, float range)
+    {
+        if (!apart(listener, source) || sInstance->mSwing <= 0.f)
+            return false;
+        DoorwayView view;
+        if (!sInstance->doorwayIn(listener.getCell(), view))
+            return false;
+        const osg::Vec3f doorway = view.mCentre + osg::Vec3f(0.f, 0.f, view.mHeight * 0.5f);
+        const float distance = (listener.getRefData().getPosition().asVec3() - doorway).length()
+            + (positionFor(source, listener) - doorway).length();
+        return distance <= range;
+    }
+
+    bool SeamlessDoors::pursued() const
+    {
+        const Ptr player = MWBase::Environment::get().getWorld()->getPlayerPtr();
+        bool found = false;
+        for (CellStore* cell : mLiveCells)
+        {
+            cell->forEach([&](const Ptr& ptr) {
+                if (!ptr.getClass().isActor() || !ptr.getRefData().getBaseNode())
+                    return true;
+                const MWMechanics::CreatureStats& stats = ptr.getClass().getCreatureStats(ptr);
+                if (!stats.isDead()
+                    && (stats.getAiSequence().isInCombat(player) || stats.getAiSequence().isInPursuit()))
+                    found = true;
+                return !found;
+            });
+            if (found)
+                return true;
+        }
+        return false;
+    }
+
+    bool SeamlessDoors::apart(const ConstPtr& a, const ConstPtr& b)
+    {
+        const SeamlessDoors* doors = sInstance.get();
+        if (!doors || doors->mLiveCells.empty() || !a.isInCell() || !b.isInCell())
+            return false;
+        return doors->behindDoor(a.getCell()) != doors->behindDoor(b.getCell());
+    }
+
+    void SeamlessDoors::crossActors()
+    {
+        if (mLiveCells.empty())
+            return;
+        MWBase::World& world = *MWBase::Environment::get().getWorld();
+        MWBase::MechanicsManager& mechanics = *MWBase::Environment::get().getMechanicsManager();
+        WorldModel& worldModel = *MWBase::Environment::get().getWorldModel();
+        const Ptr player = world.getPlayerPtr();
+        const float reach = mHalfWidth + sPassDepth * 2.f;
+        // each side's doorway: an actor of that side through it (past its middle) goes to the other side
+        for (const bool behind : { false, true })
+        {
+            DoorwayView view;
+            if (!doorwayIn(behind ? mLiveCells.front() : mDoor.getCell(), view))
+                continue;
+            const osg::Vec3f& centre = view.mCentre;
+            const osg::Vec3f& normal = view.mNormal;
+            const osg::Vec3f& across = view.mAcross;
+            std::vector<Ptr> near;
+            mechanics.getActorsInRange(centre, reach, near);
+            for (const Ptr& ptr : near)
+            {
+                if (ptr == player || !ptr.isInCell() || behindDoor(ptr.getCell()) != behind
+                    || ptr.getClass().getCreatureStats(ptr).isDead())
+                    continue;
+                const ESM::Position now = ptr.getRefData().getPosition();
+                const osg::Vec3f relative = now.asVec3() - centre;
+                const float out = relative * normal;
+                if (!(out < 0.f && out > -sPassDepth * 2.f && std::abs(relative * across) < mHalfWidth
+                        && relative.z() > -64.f && relative.z() < mHeight))
+                    continue;
+                // to the other side, the same place and heading there
+                const CellStore* from = ptr.getCell();
+                const osg::Vec3f there = behind ? now.asVec3() * mFromOther : now.asVec3() * mToOther;
+                const CellStore* side = behind ? mDoor.getCell() : mLiveCells.front();
+                CellStore* to = nullptr;
+                if (side->getCell()->isExterior())
+                {
+                    const ESM::RefId worldspace = side->getCell()->getWorldSpace();
+                    to = &worldModel.getExterior(ESM::positionToExteriorCellLocation(there.x(), there.y(), worldspace));
+                }
+                else
+                    to = const_cast<CellStore*>(side);
+                if (!MWBase::Environment::get().getWorldScene()->isCellActive(*to))
+                    continue;
+                const float yaw = now.rot[2] + (behind ? -mYaw : mYaw);
+                const Ptr moved = world.moveObject(ptr, to, there);
+                world.rotateObject(moved, osg::Vec3f(now.rot[0], now.rot[1], yaw));
+                Log(Debug::Verbose) << "Seamless doors: " << moved.getCellRef().getRefId() << " through the door from "
+                                    << from->getCell()->getDescription() << " to " << to->getCell()->getDescription();
+            }
+        }
+    }
