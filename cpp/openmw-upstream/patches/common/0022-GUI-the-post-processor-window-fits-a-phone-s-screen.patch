From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Duron27 <duron27@gmail.com>
Date: Sun, 1 Nov 2026 13:30:00 -0400
Subject: [PATCH 22/22] GUI: the post-processor window fits a phone's screen

Its least size was 600 by 600: with the GUI scaled 2x on a 1080 pixel high phone the screen is 540 high, so the window
ran off the bottom and its settings could not be reached. 360 by 300 still shows the lists and the settings.
---
 files/data/mygui/openmw_postprocessor_hud.layout | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/files/data/mygui/openmw_postprocessor_hud.layout b/files/data/mygui/openmw_postprocessor_hud.layout
index 4ed8ecdb36..4ac77fd7c7 100644
--- a/files/data/mygui/openmw_postprocessor_hud.layout
+++ b/files/data/mygui/openmw_postprocessor_hud.layout
@@ -3,7 +3,7 @@
   <Widget type="Window" skin="MW_Window" position="0 0 500 500" layer="Debug" name="_Main" align="Stretch">
     <Property key="Visible" value="false"/>
     <Property key="Caption" value="#{OMWShaders:PostProcessHUD}"/>
-    <Property key="MinSize" value="600 600"/>
+    <Property key="MinSize" value="360 300"/>
 
     <Widget type="TabControl" skin="TabControl_NoBorder" position="8 8 468 450" align="Stretch" name="TabControl">
         <Property key="ButtonAutoWidth" value="true"/>
