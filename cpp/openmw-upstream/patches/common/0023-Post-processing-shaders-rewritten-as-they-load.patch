From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Duron27 <duron27@gmail.com>
Date: Tue, 3 Nov 2026 04:00:00 -0500
Subject: [PATCH 23/23] Post-processing: shaders rewritten as they load

A technique's text goes through the support library's rewriteTechnique before it is parsed, which makes known
shaders cheaper where an [Experimental] setting asks (src/techniquerewrite.cpp: wetworld's reflections traced at half
size). With none of them on, the text is unchanged.
---
diff --git a/components/fx/technique.cpp b/components/fx/technique.cpp
--- a/components/fx/technique.cpp
+++ b/components/fx/technique.cpp
@@ -11,6 +11,7 @@
 
 #include <SDL_opengl_glext.h>
 
+#include <alpha3/upstream.hpp>
 #include <components/debug/debuglog.hpp>
 #include <components/files/conversion.hpp>
 #include <components/misc/strings/algorithm.hpp>
@@ -124,6 +125,7 @@
         try
         {
             std::string source(std::istreambuf_iterator<char>(*mVFS.get(getFileName())), {});
+            Alpha3::rewriteTechnique(mName, source);
 
             parse(std::move(source));
 
