From: Duron27 <duron27@gmail.com>
Date: Sun, 25 Oct 2026 20:40:28 -0400
Subject: [PATCH 12/17] Shaders: the composite map quad and the Adreno
 clustered lighting crash

The composite map vertex shader does not multiply its clip space quad by the model view matrix, and lib/light/util.glsl
avoids two constructs the Adreno compiler crashes on. (Compute shader ripples and clustered lighting turn on by
themselves: Alpha3's support library reports OpenGL ES 3.2 as the desktop GLSL version whose features the converted
shaders get. Reverse-z's 32 bit float depth comes from OSG, which names it GL_ARB_depth_buffer_float on OpenGL ES 3.)
---
 .../compatibility/terrain_composite.vert        |  3 ++-
 files/shaders/lib/light/util.glsl               | 17 +++++++++++++++++
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/files/shaders/compatibility/terrain_composite.vert b/files/shaders/compatibility/terrain_composite.vert
index b3f84c97d1..baa2a39e46 100644
--- a/files/shaders/compatibility/terrain_composite.vert
+++ b/files/shaders/compatibility/terrain_composite.vert
@@ -4,7 +4,8 @@ varying vec2 uv;
 
 void main(void)
 {
-    gl_Position = gl_ModelViewMatrix * gl_Vertex;
+    // the quad is already in clip space
+    gl_Position = gl_Vertex;
 
     uv = gl_MultiTexCoord0.xy;
 }
diff --git a/files/shaders/lib/light/util.glsl b/files/shaders/lib/light/util.glsl
index 31a70f35f6..f8e6008415 100644
--- a/files/shaders/lib/light/util.glsl
+++ b/files/shaders/lib/light/util.glsl
@@ -32,12 +32,22 @@ float lambert(vec3 viewNormal, vec3 lightDir, vec3 viewDir)
 
 float specularIntensity(vec3 viewNormal, vec3 viewDir, float shininess, vec3 lightDir)
 {
+#if @lightingMethodClustered
+    // The Adreno compiler crashes on a normalize under a branch inside the clustered light loop (storage buffer reads)
+    vec3 halfVec = normalize(lightDir - viewDir);
+    if (dot(viewNormal, lightDir) > 0.0)
+    {
+        float NdotH = max(dot(viewNormal, halfVec), 0.0);
+        return pow(NdotH, shininess);
+    }
+#else
     if (dot(viewNormal, lightDir) > 0.0)
     {
         vec3 halfVec = normalize(lightDir - viewDir);
         float NdotH = max(dot(viewNormal, halfVec), 0.0);
         return pow(NdotH, shininess);
     }
+#endif
 
     return 0.0;
 }
@@ -82,6 +92,12 @@ void calcPointLighting(PointLight light, vec3 viewDir, vec3 viewPos, vec3 viewNo
     float lightDistance = length(lightPos);
 
     // cull point lighting by radius, light is guaranteed to not fall outside this bound with our cutoff
+#if @lightingMethodClustered
+    // Not as an early return: the Adreno compiler crashes on the clustered light loop with a branch in it
+    float inRange = float(lightDistance <= light.radius);
+    vec3 lightDir = lightPos / max(lightDistance, 0.0001);
+    float attenuation = calcAttenuation(light, lightDistance) * clusterFade(viewPos, light.radius) * inRange;
+#else
 #if !@classicFalloff
     if (lightDistance > light.radius)
         return;
@@ -90,6 +106,7 @@ void calcPointLighting(PointLight light, vec3 viewDir, vec3 viewPos, vec3 viewNo
     vec3 lightDir = lightPos / lightDistance;
 
     float attenuation = calcAttenuation(light, lightDistance) * clusterFade(viewPos, light.radius);
+#endif
 
     diffuseLight += light.diffuse.xyz * lambert(viewNormal, lightDir, viewDir) * attenuation;
     ambientLight += light.ambient.xyz * attenuation;
