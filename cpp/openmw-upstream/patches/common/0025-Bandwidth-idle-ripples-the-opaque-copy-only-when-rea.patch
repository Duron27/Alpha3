                 continue;
 
+            userTechniques = userTechniques || !technique->getInternal();
+
             if (technique->getGLSLVersion() > mGLSLVersion)
             {
                 Log(Debug::Warning) << "Technique " << technique->getName() << " requires GLSL version "
@@ -730,6 +735,8 @@ namespace MWRender
         }
 
         mCanvases[frameId]->setPasses(Fx::DispatchArray(mTemplateData));
+        // the scene's opaque copy is kept for the depth of the user's techniques
+        Alpha3::setPostProcessingReadsDepth(userTechniques);
 
         if (auto hud = MWBase::Environment::get().getWindowManager()->getPostProcessorHud())
