From: Duron27 <duron27@gmail.com>
Date: Fri, 6 Nov 2026 10:00:00 -0500
Subject: [PATCH 25/25] Bandwidth: idle ripples, the opaque copy only when read,
 buffers discarded

For tile GPUs, through the support library (src/bandwidth.cpp), each a setting:

- [Water] idle ripples: once nothing has touched the water for Alpha3::ripplesIdleAfter() seconds, the ripple map is
  cleared once and the two simulation passes stop until the next ripple. Each pass discards its target first.
- [Video] skip unused opaque copy: the OpaqueResolve bin copies the scene's colour and depth only when
  Alpha3::opaqueCopyWanted says something drawn after reads them; without the copy, the first person model's depth
  is not drawn into it either. The post processor tells it whether its chain has a technique of the user's.
- [Video] discard unused buffers: the post processor's camera discards the window's buffers before drawing over them,
  and the first person model's depth buffer is discarded once drawn.
---
 apps/openmw/mwrender/npcanimation.cpp  | 22 ++++++++++++-------
 apps/openmw/mwrender/opaqueblit.cpp    |  6 +++++-
 apps/openmw/mwrender/postprocessor.cpp |  7 +++++++
 apps/openmw/mwrender/ripples.cpp       | 29 ++++++++++++++++++++++++++
 apps/openmw/mwrender/ripples.hpp       |  4 ++++
 5 files changed, 60 insertions(+), 8 deletions(-)

diff --git a/apps/openmw/mwrender/npcanimation.cpp b/apps/openmw/mwrender/npcanimation.cpp
index df5943d66d..269c308c81 100644
--- a/apps/openmw/mwrender/npcanimation.cpp
+++ b/apps/openmw/mwrender/npcanimation.cpp
@@ -6,6 +6,8 @@
 #include <osgUtil/CullVisitor>
 #include <osgUtil/RenderBin>
 
+#include <alpha3/upstream.hpp>
+
 #include <components/debug/debuglog.hpp>
 
 #include <components/misc/rng.hpp>
@@ -348,19 +350,25 @@ namespace MWRender
             glClear(GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT);
             // color accumulation pass
             bin->drawImplementation(renderInfo, previous);
+            // its depth is not needed again
+            Alpha3::discardDrawBuffers(false, true);
 
             auto primaryFBO = postProcessor->getPrimaryFbo(frameId);
             primaryFBO->apply(*state);
 
-            postProcessor->getFbo(PostProcessor::FBO_OpaqueDepth, frameId)->apply(*state);
+            // into the opaque copy, unless this frame has none
+            if (!Alpha3::opaqueCopySkipped(state->getFrameStamp()->getFrameNumber()))
+            {
+                postProcessor->getFbo(PostProcessor::FBO_OpaqueDepth, frameId)->apply(*state);
 
-            // depth accumulation pass
-            osg::ref_ptr<osg::StateSet> restore = bin->getStateSet();
-            bin->setStateSet(mStateSet);
-            bin->drawImplementation(renderInfo, previous);
-            bin->setStateSet(restore);
+                // depth accumulation pass
+                osg::ref_ptr<osg::StateSet> restore = bin->getStateSet();
+                bin->setStateSet(mStateSet);
+                bin->drawImplementation(renderInfo, previous);
+                bin->setStateSet(restore);
 
-            primaryFBO->apply(*state);
+                primaryFBO->apply(*state);
+            }
 
             state->checkGLErrors("after DepthClearCallback::drawImplementation");
         }
diff --git a/apps/openmw/mwrender/opaqueblit.cpp b/apps/openmw/mwrender/opaqueblit.cpp
index ed643c1722..113573446a 100644
--- a/apps/openmw/mwrender/opaqueblit.cpp
+++ b/apps/openmw/mwrender/opaqueblit.cpp
@@ -2,6 +2,8 @@
 
 #include <osgUtil/RenderStage>
 
+#include <alpha3/upstream.hpp>
+
 #include <components/stereo/multiview.hpp>
 #include <components/stereo/stereomanager.hpp>
 
@@ -10,7 +12,9 @@ namespace MWRender
     void OpaqueColorBinCallback::drawImplementation(
         osgUtil::RenderBin* bin, osg::RenderInfo& renderInfo, osgUtil::RenderLeaf*& previous)
     {
-        resolve(bin, renderInfo);
+        // not in the frames where nothing drawn after reads the copy
+        if (Alpha3::opaqueCopyWanted(*bin, renderInfo))
+            resolve(bin, renderInfo);
         bin->drawImplementation(renderInfo, previous);
     }
 
