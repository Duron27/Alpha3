+        state.mClear = false;
 
         if (mPaused)
             return;
@@ -172,6 +175,20 @@ namespace MWRender
         const osg::Vec2f offset = mCurrentPlayerPos - mLastPlayerPos;
         mLastPlayerPos = mCurrentPlayerPos;
 
+        // Nothing has touched the water for a while: the damping has flattened the waves, the map is cleared once and
+        // left until the next ripple
+        const float idleAfter = Alpha3::ripplesIdleAfter();
+        if (mPositionCount > 0 || idleAfter <= 0.f)
+            mLastRippleTime = simulationTime;
+        else if (simulationTime - mLastRippleTime > idleAfter)
+        {
+            state.mPaused = true;
+            state.mClear = !mIdle;
+            mIdle = true;
+            return;
+        }
+        mIdle = false;
+
         state.mStateset->getUniform("positionCount")->set(static_cast<int>(mPositionCount));
         state.mStateset->getUniform("offset")->set(offset);
 
@@ -211,6 +228,15 @@ namespace MWRender
         osg::State& state = *renderInfo.getState();
         const std::size_t currentFrame = state.getFrameStamp()->getFrameNumber() % 2;
         const State& frameState = mState[currentFrame];
+        if (frameState.mClear)
+        {
+            state.pushStateSet(frameState.mStateset);
+            state.apply();
+            mFBOs[0]->apply(state, osg::FrameBufferObject::DRAW_FRAMEBUFFER);
+            glClearColor(0, 0, 0, 0);
+            glClear(GL_COLOR_BUFFER_BIT);
+            state.popStateSet();
+        }
         if (frameState.mPaused)
         {
             return;
@@ -250,6 +276,8 @@ namespace MWRender
         else
