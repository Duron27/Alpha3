+    void Scene::insertDeferredObjects()
+    {
+        if (mDeferredObjects.empty())
+            return;
+        const auto start = std::chrono::steady_clock::now();
+        const auto budget = std::chrono::duration<float, std::milli>(Alpha3::cellLoadBudget());
+        const bool isInterior = mCurrentCell && !mCurrentCell->isExterior();
+        auto navigatorUpdateGuard = mNavigator.makeUpdateGuard();
+        std::size_t done = 0;
+        while (done < mDeferredObjects.size() && (done == 0 || std::chrono::steady_clock::now() - start < budget))
+        {
+            auto& [cell, ptr] = mDeferredObjects[done++];
+            // gone, hidden, or put in the scene meanwhile (a script enabling it)
+            if (!mActiveCells.contains(cell) || ptr.mRef->isDeleted() || !ptr.getRefData().isEnabled()
+                || ptr.getRefData().getBaseNode() || mPhysics->getActor(ptr))
+                continue;
+            try
+            {
+                addObject(ptr, mWorld, mPagedRefs, *mPhysics, mRendering);
+                addObject(ptr, mWorld, *mPhysics, mLowestPoint, isInterior, mNavigator, navigatorUpdateGuard.get());
+            }
+            catch (const std::exception& e)
+            {
+                Log(Debug::Error) << "failed to render '" << ptr.getCellRef().getRefId() << "': " << e.what();
+            }
+        }
+        navigatorUpdateGuard.reset();
+        mDeferredObjects.erase(mDeferredObjects.begin(), mDeferredObjects.begin() + done);
+
+        static int frames = 0;
+        static std::size_t objects = 0;
+        static float milliseconds = 0.f;
+        ++frames;
+        objects += done;
+        milliseconds += std::chrono::duration<float, std::milli>(std::chrono::steady_clock::now() - start).count();
+        if (mDeferredObjects.empty())
+        {
+            Log(Debug::Verbose) << "Cells loaded over frames: " << objects << " objects in " << frames << " frames, "
+                                << milliseconds << " ms";
+            frames = 0;
+            objects = 0;
+            milliseconds = 0.f;
+        }
+    }
