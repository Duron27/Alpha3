+#ifndef GAME_MWWORLD_SEAMLESSDOORS_H
+#define GAME_MWWORLD_SEAMLESSDOORS_H
+
+#include <memory>
+#include <vector>
+
+#include <osg/Group>
+#include <osg/Matrixd>
+#include <osg/Quat>
+#include <osg/Vec2f>
+#include <osg/Vec3f>
+#include <osg/ref_ptr>
+
+#include <components/esm/refid.hpp>
+
+#include "ptr.hpp"
+
+namespace SceneUtil
+{
+    class PositionAttitudeTransform;
+}
+
+namespace MWRender
+{
+    class Animation;
+}
+
+namespace MWWorld
+{
+    class CellStore;
+
+    // Seamless doors ([Cells] seamless doors, Alpha3): the player opening a door between an exterior and an interior
+    // (either way, or between two interiors) swings it open onto the other side, drawn through the doorway
+    // (Alpha3::makeDoorPortal) and placed so that the door there is where this one is: its objects, its people and
+    // creatures (idling), and outside its ground and sky. The door swings into the interior. The player walks through
+    // the doorway (its door and wall do not stop them, Alpha3::doorwayPassable) and, crossing it, is in the other cell
+    // at the same place and heading, the door there open behind them onto the side they left: with seamless cells
+    // there is no loading screen and no fade, so the change of cells is not seen. What is seen through the door, both
+    // ways, is built a little each frame while it swings open, so that crossing builds nothing. Activating the open
+    // door shuts it.
+    class SeamlessDoors
+    {
+    public:
+        // nullptr when off
+        static SeamlessDoors* get();
+        static void destroy();
+
+        SeamlessDoors();
+        ~SeamlessDoors();
+
+        // Door::activate, the player activating a teleport door: true when it opened (or shut), false for the usual
+        // teleport
+        bool activate(const Ptr& door);
+
+        // every frame of the game running; playerCollision: the player's collision object (for the doorway)
+        void update(float duration, const void* playerCollision);
+
+        // the open door shut at once and the other side gone
+        void close();
+
+        // A door's swinging model: its node, closed attitude and position, hinge and which way it opens
+        struct Leaf
+        {
+            osg::ref_ptr<SceneUtil::PositionAttitudeTransform> mNode;
+            osg::Quat mClosed;
+            osg::Vec3f mClosedPosition;
+            osg::Vec3f mHinge;
+            float mSign = 1.f;
+            // the door on the other side's model on its back (a door's model has a front only)
+            osg::ref_ptr<osg::Node> mBack;
+        };
+
+        // What is seen through a door, built a little at a time: the models of a side's objects (in its own space),
+        // its ground, the door there swinging (the leaf), its people and creatures
+        struct Content
+        {
+            osg::ref_ptr<osg::Group> mGroup;
+            std::vector<Ptr> mObjects;
+            std::vector<osg::Vec2f> mChunks;
+            float mCellSize = 0.f;
+            Ptr mLeafDoor;
+            // seen from an exterior, the leaf is the exterior's door (an interior's door has no back: it is against a
+            // wall), placed in this side's space
+            Ptr mLeafModel;
+            osg::Matrixd mLeafPlace;
+            // the way it opens (its side's front, in its space)
+            osg::Vec3f mLeafFront;
+            Leaf mLeaf;
+            std::vector<Ptr> mActors;
+            std::vector<std::unique_ptr<MWRender::Animation>> mAnimations;
+            // what has been built: each object's or actor's node, and the ground's
+            std::vector<std::pair<Ptr, osg::ref_ptr<osg::Node>>> mBuilt;
+            std::vector<osg::ref_ptr<osg::Node>> mTerrain;
+
+            ~Content();
+            bool done() const { return mObjects.empty() && mChunks.empty() && mActors.empty(); }
+        };
+
+    private:
+        bool open(const Ptr& door, bool alreadyOpen, std::unique_ptr<Content> prebuilt);
+        void cross();
+        void pose();
+        // The other side's view kept in the scene once the player is through, while its cell is put in the scene over
+        // frames ([Cells] load cells over frames): a stand-in for each object until it is in the scene itself
+        void keepStandIn(std::unique_ptr<Content> standIn);
+        void updateStandIn(float duration);
+        void dropStandIn();
+
+        Ptr mDoor;
+        // the door on the other side and its cell
+        Ptr mOther;
+        ESM::RefId mOtherCell;
+        bool mOtherOutside = false;
+        osg::ref_ptr<osg::Group> mPortal;
+        // the other side, and this side as it will be seen from there once the player is through
+        std::unique_ptr<Content> mContent;
+        std::unique_ptr<Content> mReverse;
+        osg::Matrixd mToOther;
+        float mYaw = 0.f;
+        // the doorway: its middle at the floor, its normal toward this side, the horizontal across it
+        osg::Vec3f mCentre;
+        osg::Vec3f mNormal;
+        osg::Vec3f mAcross;
+        float mHalfWidth = 0.f;
+        float mHeight = 0.f;
+        const void* mPlayerCollision = nullptr;
+        // this door: swung (an interior's, toward the player) or hidden (an exterior's: the door there is seen,
+        // swinging into the interior)
+        Leaf mLeaf;
+        bool mHidden = false;
+        unsigned int mNodeMask = 0;
+        // how far open (0 to 1) and whether opening or shutting
+        float mSwing = 0.f;
+        bool mOpening = false;
+        // the stand-in, its cell (an interior's, or the exterior's worldspace) and how long it has been there
+        std::unique_ptr<Content> mStandIn;
+        const CellStore* mStandInCell = nullptr;
+        ESM::RefId mStandInWorldspace;
+        float mStandInAge = 0.f;
+    };
+}
+
+#endif
