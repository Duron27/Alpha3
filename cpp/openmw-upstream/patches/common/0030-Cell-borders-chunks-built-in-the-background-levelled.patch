+        // the creatures getLevelledItem can pick from the list at this level (nested lists followed)
+        void addLevelledModels(const ESM::CreatureLevList& list, int level, const MWWorld::ESMStore& store,
+            std::vector<VFS::Path::NormalizedView>& models, int depth)
+        {
+            if (depth > 8)
+                return;
+            int highestLevel = 0;
+            for (const auto& item : list.mList)
+                if (item.mLevel > highestLevel && item.mLevel <= level)
+                    highestLevel = item.mLevel;
+            const bool allLevels = list.mFlags & ESM::CreatureLevList::AllLevels;
+            for (const auto& item : list.mList)
+            {
+                if (level < item.mLevel || (!allLevels && item.mLevel != highestLevel))
+                    continue;
+                if (const ESM::Creature* creature = store.get<ESM::Creature>().search(item.mId))
+                {
+                    const VFS::Path::NormalizedView model = creature->mModel.getNormalized();
+                    if (!model.empty())
+                        models.push_back(model);
+                }
+                else if (const ESM::CreatureLevList* nested = store.get<ESM::CreatureLevList>().search(item.mId))
+                    addLevelledModels(*nested, level, store, models, depth + 1);
+            }
+        }
+    }
