+    void CreatureLevList::getModelsToPreload(
+        const MWWorld::ConstPtr& ptr, std::vector<VFS::Path::NormalizedView>& models) const
+    {
+        if (!Alpha3::preloadLevelledCreatures())
+            return;
+        // spawned already: the creature is in the cell and preloads its own model
+        if (const MWWorld::CustomData* data = ptr.getRefData().getCustomData())
+            if (!data->asCreatureLevListCustomData().mSpawn)
+                return;
+        const MWWorld::Ptr player = MWMechanics::getPlayer();
+        if (player.isEmpty())
+            return;
+        const int level = player.getClass().getCreatureStats(player).getLevel();
+        addLevelledModels(*ptr.get<ESM::CreatureLevList>()->mBase, level, *MWBase::Environment::get().getESMStore(),
+            models, 0);
+    }
