+    // What a background build needs of its ObjectPaging: cleared (under the mutex) when the ObjectPaging goes, so a
+    // build still queued then does nothing, and one running holds the destructor until it ends
+    struct ObjectPaging::BackgroundOwner
+    {
+        std::mutex mMutex;
+        ObjectPaging* mPaging = nullptr;
+    };
+
+    namespace
+    {
+        class BackgroundChunkItem : public SceneUtil::WorkItem
+        {
+        public:
+            explicit BackgroundChunkItem(std::function<void()> work)
+                : mWork(std::move(work))
+            {
+            }
+            void doWork() override { mWork(); }
+
+        private:
+            std::function<void()> mWork;
+        };
+    }
+
+    ObjectPaging::~ObjectPaging()
+    {
+        std::lock_guard<std::mutex> lock(mBackgroundOwner->mMutex);
+        mBackgroundOwner->mPaging = nullptr;
+    }
+
+    osg::ref_ptr<osg::Node> ObjectPaging::standIn(const ChunkId& id)
+    {
+        {
+            std::lock_guard<std::mutex> lock(mBackgroundMutex);
+            if (auto found = mStaleChunks.find(id); found != mStaleChunks.end())
+                return found->second.first;
+        }
+        // the same place on the other side of the active grid's edge: the cell just went in or out of the grid
+        const ChunkId other = std::make_tuple(std::get<0>(id), std::get<1>(id), !std::get<2>(id));
+        if (const osg::ref_ptr<osg::Object> obj = mCache->getRefFromObjectCache(other))
+            return static_cast<osg::Node*>(obj.get());
+        std::lock_guard<std::mutex> lock(mBackgroundMutex);
+        if (auto found = mStaleChunks.find(other); found != mStaleChunks.end())
+            return found->second.first;
+        return nullptr;
+    }
+
+    void ObjectPaging::keepAsStandIn(const ChunkId& id, const osg::Vec3f& objectPosition)
+    {
+        if (!Alpha3::backgroundObjectPaging())
+            return;
+        // not next to the player: there a chunk still showing the object (a door opening) would be seen; the objects of
+        // cells loading at the grid's edge are a cell away
+        const MWBase::World* world = MWBase::Environment::get().getWorld();
+        const MWWorld::ConstPtr player = world ? world->getPlayerConstPtr() : MWWorld::ConstPtr();
+        constexpr float nearPlayer = 3072;
+        if (!player.isEmpty()
+            && (player.getRefData().getPosition().asVec3() - objectPosition).length2() < nearPlayer * nearPlayer)
+            return;
+        if (const osg::ref_ptr<osg::Object> obj = mCache->getRefFromObjectCache(id))
+        {
+            std::lock_guard<std::mutex> lock(mBackgroundMutex);
+            mStaleChunks[id] = { static_cast<osg::Node*>(obj.get()), std::chrono::steady_clock::now() };
+        }
+    }
+
+    void ObjectPaging::buildInBackground(const ChunkId& id, const osg::Vec3f& viewPoint, unsigned char lod)
+    {
+        {
+            std::lock_guard<std::mutex> lock(mBackgroundMutex);
+            if (!mBuilding.insert(id).second)
+                return;
+        }
+        const unsigned changes = mChunkChanges;
+        std::shared_ptr<BackgroundOwner> owner = mBackgroundOwner;
+        mWorkQueue->addWorkItem(std::make_shared<BackgroundChunkItem>([owner, id, viewPoint, lod, changes] {
+            std::lock_guard<std::mutex> ownerLock(owner->mMutex);
+            ObjectPaging* paging = owner->mPaging;
+            if (paging == nullptr)
+                return;
+            osg::ref_ptr<osg::Node> node;
+            try
+            {
+                node = paging->createChunk(std::get<1>(id), std::get<0>(id), std::get<2>(id), viewPoint, true, lod);
+            }
+            catch (const std::exception& e)
+            {
+                Log(Debug::Warning) << "Object paging: background chunk failed: " << e.what();
+            }
+            // what the chunk holds changed while it was built: not cached, the view asks again and it is rebuilt
+            if (node && paging->mChunkChanges == changes)
+                paging->mCache->addEntryToObjectCache(id, node.get());
+            std::lock_guard<std::mutex> lock(paging->mBackgroundMutex);
+            paging->mBuilding.erase(id);
+            if (node && paging->mChunkChanges == changes)
+                paging->mStaleChunks.erase(id);
+            paging->mBackgroundChunksReady = true;
+        }),
+            true);
+    }
+
+    bool ObjectPaging::takeBackgroundChunks()
+    {
+        const auto now = std::chrono::steady_clock::now();
+        std::lock_guard<std::mutex> lock(mBackgroundMutex);
+        // stand-ins nobody asked to replace (the view moved on) are let go after a while
+        for (auto it = mStaleChunks.begin(); it != mStaleChunks.end();)
+        {
+            if (!mBuilding.count(it->first) && now - it->second.second > std::chrono::seconds(10))
+                it = mStaleChunks.erase(it);
+            else
+                ++it;
+        }
+        if (!mBackgroundChunksReady)
+            return false;
+        // one view rebuild for the chunks of a cell change, or a few a second while they come in
+        if (!mBuilding.empty() && now - mLastViewRebuild < std::chrono::milliseconds(250))
+            return false;
+        mBackgroundChunksReady = false;
+        mLastViewRebuild = now;
+        return true;
+    }
