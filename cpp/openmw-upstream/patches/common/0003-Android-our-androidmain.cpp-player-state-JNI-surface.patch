+extern "C++"
+{
+template <class T>
+static T snapshotValue(T PlayerSnapshot::*member)
+{
+  std::lock_guard<std::mutex> lock(sSnapshotMutex);
+  return sSnapshot.*member;
+}
+}
+
+// The returned text stays valid until the calling thread asks for the same value again
+static const char* snapshotText(std::string PlayerSnapshot::*member)
+{
+  thread_local std::string texts[4];
+  std::string& text = member == &PlayerSnapshot::cellName ? texts[0]
+      : member == &PlayerSnapshot::inventorySummary      ? texts[1]
+      : member == &PlayerSnapshot::selectedWeapon        ? texts[2]
+                                                         : texts[3];
+  std::lock_guard<std::mutex> lock(sSnapshotMutex);
+  text = sSnapshot.*member;
+  return text.c_str();
+}
+
+bool omw_is_game_running() { return snapshotValue(&PlayerSnapshot::running); }
