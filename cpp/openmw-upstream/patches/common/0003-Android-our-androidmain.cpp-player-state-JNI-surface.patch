+// The last frame intervals of the main loop, for the launcher's performance overlay
+static constexpr size_t sFrameHistory = 240;
+static std::mutex sFrameMutex;
+static float sFrameTimes[sFrameHistory];
+static size_t sFrameCount = 0;
+
+void omw_record_frame_time(float milliseconds)
+{
+  std::lock_guard<std::mutex> lock(sFrameMutex);
+  sFrameTimes[sFrameCount++ % sFrameHistory] = milliseconds;
+}
