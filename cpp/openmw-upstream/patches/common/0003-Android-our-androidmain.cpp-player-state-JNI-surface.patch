+// The player state the app polls from its UI thread is copied from the game on the engine's main thread
+// (omw_frame_update, about ten times a second). The UI thread never touches the game's objects: they are not thread
+// safe, and the engine destroys them while the app may still be polling, when the game quits.
+struct PlayerSnapshot
+{
+  bool running = false;
+  float healthCurrent = 0.f, healthModified = 0.f, healthBase = 0.f;
+  float magickaCurrent = 0.f, magickaModified = 0.f;
+  float fatigueCurrent = 0.f, fatigueModified = 0.f;
+  int level = 0;
+  float x = 0.f, y = 0.f, z = 0.f;
+  std::string cellName = "Main Menu / Loading";
+  std::string inventorySummary = "Main Menu / Loading";
+  int drawState = 0;
+  std::string selectedWeapon;
+  std::string selectedSpell;
+};
+
+static std::mutex sSnapshotMutex;
+static PlayerSnapshot sSnapshot;
+static std::atomic<bool> sQuitRequested{ false };
+// The inventory list walks every item and builds text; it is only made while the app's overlay keeps asking for it
+static std::atomic<std::int64_t> sInventoryAskedAt{ 0 };
+
+static std::int64_t steadyMillis()
+{
+  return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+static PlayerSnapshot takeSnapshot(const PlayerSnapshot& previous)
+{
+  PlayerSnapshot snapshot;
+  try
+  {
+    auto& env = liveEnvironment();
+    auto stateMgr = env.getStateManager();
+    snapshot.running = stateMgr && stateMgr->getState() == MWState::StateManager::State_Running;
+  }
+  catch (...)
+  {
+  }
+  // The world exists before there is a player (the intro video plays while the engine starts, and World::getPlayerPtr
+  // does not check), so the player is read only while a game runs
+  if (!snapshot.running)
+    return snapshot;
+  snapshot.cellName = "Unknown Cell";
+  snapshot.inventorySummary = "(No Inventory)";
+
+  auto player = getPlayerPtrSafely();
+  if (player.isEmpty())
+    return snapshot;
+  try
+  {
+    auto& stats = player.getClass().getCreatureStats(player);
+    snapshot.healthCurrent = stats.getHealth().getCurrent();
+    snapshot.healthModified = stats.getHealth().getModified();
+    snapshot.healthBase = stats.getHealth().getBase();
+    snapshot.magickaCurrent = stats.getMagicka().getCurrent();
+    snapshot.magickaModified = stats.getMagicka().getModified();
+    snapshot.fatigueCurrent = stats.getFatigue().getCurrent();
+    snapshot.fatigueModified = stats.getFatigue().getModified();
+    snapshot.level = stats.getLevel();
+    snapshot.drawState = static_cast<int>(stats.getDrawState());
+    const osg::Vec3f position = player.getRefData().getPosition().asVec3();
+    snapshot.x = position.x();
+    snapshot.y = position.y();
+    snapshot.z = position.z();
+    const auto spellId = stats.getSpells().getSelectedSpell();
+    if (!spellId.empty())
+      snapshot.selectedSpell = spellId.toDebugString();
+  }
+  catch (...)
+  {
+  }
+
+  try
+  {
+    if (player.isInCell() && player.getCell())
+    {
+      auto cell = player.getCell()->getCell();
+      if (cell)
+      {
+        auto name = cell->getDisplayName();
+        if (name.empty())
+          name = cell->getNameId();
+        snapshot.cellName = std::string(name);
+      }
+    }
+  }
+  catch (...)
+  {
+  }
+
+  try
+  {
+    if (player.getClass().hasInventoryStore(player))
+    {
+      auto& invStore = player.getClass().getInventoryStore(player);
+      if (steadyMillis() - sInventoryAskedAt.load() > 3000)
+        snapshot.inventorySummary = previous.inventorySummary;
+      else
+      {
+        std::string summary;
+        int count = 0;
+        for (auto it = invStore.begin(); it != invStore.end(); ++it)
+        {
+          if (it->isEmpty()) continue;
+          if (!it->getClass().showsInInventory(*it)) continue;
+          if (count > 0) summary += ", ";
+          int itemCount = 1;
+          try {
+            itemCount = it->getCellRef().getCount();
+          } catch (...) {}
+          summary += std::string(it->getClass().getName(*it)) + " (x" + std::to_string(itemCount) + ")";
+          count++;
+          if (count > 30) { summary += ", ..."; break; }
+        }
+        snapshot.inventorySummary = summary.empty() ? "(Empty Inventory)" : summary;
+      }
+
+      auto weapon = invStore.getSlot(MWWorld::InventoryStore::Slot_CarriedRight);
+      if (weapon != invStore.end() && !weapon->isEmpty())
+        snapshot.selectedWeapon = std::string(weapon->getClass().getName(*weapon));
+    }
+  }
+  catch (...)
+  {
+  }
+
+  if (snapshot.selectedSpell.empty())
+  {
+    try
+    {
+      auto winMgr = liveEnvironment().getWindowManager();
+      if (winMgr)
+      {
+        auto spellId = winMgr->getSelectedSpell();
+        if (!spellId.empty())
+          snapshot.selectedSpell = spellId.toDebugString();
+      }
+    }
+    catch (...)
+    {
+    }
+  }
+  return snapshot;
+}
