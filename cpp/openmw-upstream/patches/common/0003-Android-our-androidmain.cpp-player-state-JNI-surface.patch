+// The viewer's own camera (the one the window's context draws for), which the engine has placed for this frame by now
+static osg::Camera* viewerCamera()
+{
+  for (osg::GraphicsContext* gc : osg::GraphicsContext::getAllRegisteredGraphicsContexts())
+    for (osg::Camera* camera : gc->getCameras())
+      if (camera->getView() != nullptr && camera->getView()->getCamera() == camera)
+        return camera;
+  return nullptr;
+}
+
+// Frame generation makes the frame between two rendered ones from the camera's motion and the scene's depth: hands over
+// this frame's camera and the post processor's textures it is drawn into
+static void submitFrameGenView()
+{
+  if (!Alpha3::frameGenWanted())
+    return;
+  try
+  {
+    auto& env = liveEnvironment();
+    auto stateMgr = env.getStateManager();
+    MWBase::World* world = env.getWorld();
+    if (!stateMgr || stateMgr->getState() != MWState::StateManager::State_Running || world == nullptr)
+      return;
+    MWRender::PostProcessor* postProcessor = world->getPostProcessor();
+    osg::Camera* camera = viewerCamera();
+    if (postProcessor == nullptr || camera == nullptr || camera->getView()->getFrameStamp() == nullptr)
+      return;
+    // the post processor's camera draws the scene into the window before the GUI: frame generation copies it there
+    static bool captureAdded = false;
+    if (!captureAdded)
+    {
+      postProcessor->getHUDCamera()->addFinalDrawCallback(Alpha3::frameGenPreGuiCapture());
+      captureAdded = true;
+    }
+    Alpha3::FrameGenView view;
+    view.frame = camera->getView()->getFrameStamp()->getFrameNumber();
+    view.view = camera->getViewMatrix();
+    view.projection = camera->getProjectionMatrix();
+    view.reversedDepth = SceneUtil::AutoDepth::isReversed();
+    view.postProcessing = postProcessor->isEnabled();
+    const unsigned frameId = view.frame % 2;
+    view.scene = postProcessor->getTexture(MWRender::PostProcessor::Tex_Scene, frameId);
+    view.depth = postProcessor->getTexture(MWRender::PostProcessor::Tex_Depth, frameId);
+    view.opaqueDepth = postProcessor->getTexture(MWRender::PostProcessor::Tex_OpaqueDepth, frameId);
+    Alpha3::frameGenSubmitView(std::move(view));
+  }
+  catch (...)
+  {
+  }
+}
+
+// Alpha3's support library calls it on the engine's main thread before each frame is rendered
+void omw_frame_update()
+{
+  submitFrameGenView();
+
+  if (sQuitRequested.exchange(false))
+  {
+    try
+    {
+      auto stateMgr = liveEnvironment().getStateManager();
+      if (stateMgr)
+        stateMgr->requestQuit();
+    }
+    catch (...)
+    {
+    }
+  }
+
+  static std::chrono::steady_clock::time_point last;
+  const auto now = std::chrono::steady_clock::now();
+  if (now - last < std::chrono::milliseconds(100))
+    return;
+  last = now;
+  PlayerSnapshot previous;
+  {
+    std::lock_guard<std::mutex> lock(sSnapshotMutex);
+    previous.inventorySummary = sSnapshot.inventorySummary;
+  }
+  PlayerSnapshot snapshot = takeSnapshot(previous);
+  std::lock_guard<std::mutex> lock(sSnapshotMutex);
+  sSnapshot = std::move(snapshot);
+}
