+
+    bool FileSystemArchive::loadListing(const std::filesystem::path& cacheFile)
+    {
+        std::ifstream in(cacheFile, std::ios::binary);
+        if (!in)
+            return false;
+        std::string line;
+        if (!std::getline(in, line) || line != "OVFL1")
+            return false;
+        if (!std::getline(in, line) || line != Files::pathToUnicodeString(mPath))
+            return false;
+        std::size_t dirCount = 0;
+        if (!std::getline(in, line))
+            return false;
+        dirCount = std::stoull(line);
+        // Every folder must still be as it was: a file or folder added to or removed from a folder changes its time
+        for (std::size_t i = 0; i < dirCount; ++i)
+        {
+            if (!std::getline(in, line))
+                return false;
+            const std::size_t tab = line.find('\t');
+            if (tab == std::string::npos)
+                return false;
+            const std::int64_t saved = std::stoll(line.substr(0, tab));
+            const std::string relative = line.substr(tab + 1);
+            const std::filesystem::path dir = relative.empty() ? mPath : mPath / std::filesystem::u8path(relative);
+            if (modificationTime(dir) != saved)
+                return false;
+        }
+        if (!std::getline(in, line))
+            return false;
+        const std::size_t fileCount = std::stoull(line);
+        std::map<VFS::Path::Normalized, FileSystemArchiveFile, std::less<>> index;
+        for (std::size_t i = 0; i < fileCount; ++i)
+        {
+            if (!std::getline(in, line))
+                return false;
+            index.emplace(VFS::Path::Normalized(std::string_view{ line }),
+                FileSystemArchiveFile(mPath / std::filesystem::u8path(line)));
+        }
+        if (!std::getline(in, line) || line != "END")
+            return false;
+        mIndex = std::move(index);
+        return true;
+    }
+
+    void FileSystemArchive::saveListing(const std::filesystem::path& cacheFile,
+        const std::vector<std::pair<std::filesystem::path, std::int64_t>>& dirs) const
+    {
+        const std::string root = Files::pathToUnicodeString(mPath);
+        std::string text = "OVFL1\n" + root + "\n" + std::to_string(dirs.size()) + "\n";
+        for (const auto& [dir, time] : dirs)
+        {
+            std::string relative = Files::pathToUnicodeString(dir.lexically_relative(mPath));
+            if (relative == ".")
+                relative.clear();
+            if (relative.find('\n') != std::string::npos)
+                return;
+            text += std::to_string(time) + "\t" + relative + "\n";
+        }
+        text += std::to_string(mIndex.size()) + "\n";
+        for (const auto& [name, file] : mIndex)
+        {
+            const std::string relative = Files::pathToUnicodeString(file.getPath().lexically_relative(mPath));
+            if (relative.find('\n') != std::string::npos)
+                return;
+            text += relative + "\n";
+        }
+        text += "END\n";
+        std::error_code ec;
+        std::filesystem::create_directories(cacheFile.parent_path(), ec);
+        const std::filesystem::path temporary = cacheFile.string() + ".tmp";
+        {
+            std::ofstream out(temporary, std::ios::binary | std::ios::trunc);
+            out << text;
+            if (!out)
+                return;
+        }
+        std::filesystem::rename(temporary, cacheFile, ec);
+    }
 
