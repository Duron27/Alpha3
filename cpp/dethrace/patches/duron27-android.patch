+void resolve_full_path(char* path, size_t path_size, const char* argv0) {
+    if (argv0[0] == '/') { // run with absolute path
+        strncpy(path, argv0, path_size - 1);
+        path[path_size - 1] = '\0';
+    } else { // run with relative path
+        if (NULL == getcwd(path, path_size)) {
+            perror("getcwd error");
+            return;
+        }
+
+        // Check if we have enough space for "/" + argv0
+        size_t current_len = strlen(path);
+        size_t needed = current_len + 1 + strlen(argv0) + 1;
+
+        if (needed > path_size) {
+            // Truncate or handle error
+            fprintf(stderr, "Warning: Path too long, truncating\n");
+            return;
+        }
+
+        strcat(path, "/");
+        strcat(path, argv0);
+    }
+}
+
+void OS_InstallSignalHandler(char* program_name) {
+    resolve_full_path(_program_name, sizeof(_program_name), program_name);
+
+    /* setup alternate stack */
+    {
+        stack_t ss = {};
+        signal_alternative_stack = malloc(2 * MINSIGSTKSZ);
+        ss.ss_sp = signal_alternative_stack;
+        if (ss.ss_sp == NULL) {
+            err(1, "malloc");
+        }
+        ss.ss_size = 2 * MINSIGSTKSZ;
+        ss.ss_flags = 0;
+
+        if (sigaltstack(&ss, NULL) != 0) {
+            err(1, "sigaltstack");
+        }
+    }
+
+    /* register our signal handlers */
+    {
+        struct sigaction sig_action = {};
+        sig_action.sa_sigaction = signal_handler;
+        sigemptyset(&sig_action.sa_mask);
+
+        sig_action.sa_flags = SA_SIGINFO | SA_ONSTACK;
+
+        if (sigaction(SIGSEGV, &sig_action, NULL) != 0) {
+            err(1, "sigaction");
+        }
+        if (sigaction(SIGFPE, &sig_action, NULL) != 0) {
+            err(1, "sigaction");
+        }
+        if (sigaction(SIGINT, &sig_action, NULL) != 0) {
+            err(1, "sigaction");
+        }
+        if (sigaction(SIGILL, &sig_action, NULL) != 0) {
+            err(1, "sigaction");
+        }
+        if (sigaction(SIGTERM, &sig_action, NULL) != 0) {
+            err(1, "sigaction");
+        }
+        if (sigaction(SIGABRT, &sig_action, NULL) != 0) {
+            err(1, "sigaction");
+        }
+    }
+}
+
+void OS_RemoveSignalHandler(void) {
+    struct sigaction sig_action = {};
+    sig_action.sa_handler = SIG_DFL;
+    sigemptyset(&sig_action.sa_mask);
+
+    /* Unregister our signal handlers */
+    if (sigaction(SIGSEGV, &sig_action, NULL) != 0
+        || sigaction(SIGFPE, &sig_action, NULL) != 0
+        || sigaction(SIGINT, &sig_action, NULL) != 0
+        || sigaction(SIGILL, &sig_action, NULL) != 0
+        || sigaction(SIGTERM, &sig_action, NULL) != 0
+        || sigaction(SIGABRT, &sig_action, NULL) != 0) {
+        err(1, "sigaction");
+    }
+
+    /* remove alternate stack */
+    {
+        stack_t ss = {};
+        ss.ss_flags = SS_DISABLE;
+
+        if (sigaltstack(&ss, NULL) != 0) {
+            err(1, "sigaltstack");
+        }
+        free(signal_alternative_stack);
+        signal_alternative_stack = NULL;
+    }
+}
