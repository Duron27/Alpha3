+#define ARRAY_SIZE(A) (sizeof(A) / sizeof(A[0]))
+#define MAX_STACK_FRAMES 64
+#define TRACER_PID_STRING "TracerPid:"
+
+static int stack_nbr = 0;
+static char _program_name[1024];
+static void* signal_alternative_stack = NULL;
+
+static void* stack_traces[MAX_STACK_FRAMES];
+static char name_buf[4096];
+static DIR* directory_iterator;
+
+typedef struct {
+    void **current;
+    void **end;
+} backtrace_state_t;
+
+struct dl_iterate_callback_data {
+    int initialized;
+    intptr_t start;
+} dethrace_dl_data;
+
+static _Unwind_Reason_Code unwind_callback(struct _Unwind_Context *context, void *arg) {
+    backtrace_state_t *state = (backtrace_state_t *)arg;
+    uintptr_t pc = _Unwind_GetIP(context);
+
+    if (pc == 0) {
+        return _URC_END_OF_STACK;
+    }
+
+    if (state->current == state->end) {
+        return _URC_END_OF_STACK;
+    }
+
+    *state->current++ = (void *)pc;
+    return _URC_NO_REASON;
+}
+
+static int android_backtrace(void **buffer, int size) {
+    backtrace_state_t state = {buffer, buffer + size};
+    _Unwind_Backtrace(unwind_callback, &state);
+    return state.current - buffer;
+}
+
+static char** android_backtrace_symbols(void *const *buffer, int size) {
+    char **symbols = malloc(size * sizeof(char*));
+    if (!symbols) return NULL;
+
+    for (int i = 0; i < size; i++) {
+        Dl_info info;
+        if (dladdr(buffer[i], &info) && info.dli_sname) {
+            symbols[i] = malloc(512);
+            if (symbols[i]) {
+                snprintf(symbols[i], 512, "%s(%s+0x%lx) [%p]",
+                         info.dli_fname ? info.dli_fname : "??",
+                         info.dli_sname,
+                         (unsigned long)((char*)buffer[i] - (char*)info.dli_saddr),
+                         buffer[i]);
+            }
+        } else {
+            symbols[i] = malloc(128);
+            if (symbols[i]) {
+                snprintf(symbols[i], 128, "[%p]", buffer[i]);
+            }
+        }
+    }
+    return symbols;
+}
+
+static int dl_iterate_callback(struct dl_phdr_info* info, size_t size, void* data) {
+    struct dl_iterate_callback_data* callback_data = data;
+
+    if (strcmp(info->dlpi_name, "") == 0) {
+        callback_data->start = info->dlpi_addr;
+    }
+    return 0;
+}
+
+static intptr_t get_dethrace_offset(void) {
+    if (!dethrace_dl_data.initialized) {
+        dethrace_dl_data.initialized = 1;
+        dl_iterate_phdr(dl_iterate_callback, &dethrace_dl_data);
+    }
+    return dethrace_dl_data.start;
+}
