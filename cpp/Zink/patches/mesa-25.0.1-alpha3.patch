+static void
+osmesa_free_staging(struct osmesa_buffer *osbuffer, struct pipe_screen *screen)
+{
+   for (unsigned i = 0; i < 2; i++) {
+      if (osbuffer->staging_fence[i])
+         screen->fence_reference(screen, &osbuffer->staging_fence[i], NULL);
+      pipe_resource_reference(&osbuffer->staging[i], NULL);
+   }
+   osbuffer->staging_cur = 0;
+   osbuffer->staging_primed = false;
+}
+
+
+/* Copies the color buffer to the user's memory one frame late (see struct osmesa_buffer). Returns false when the staging
+ * textures cannot be had, so that the caller can fall back to the plain read. */
+static bool
+osmesa_read_color_pipelined(OSMesaContext osmesa, struct osmesa_buffer *osbuffer, struct pipe_resource *res,
+                            void *dst, int dst_stride, bool y_up)
+{
+   struct pipe_context *pipe = osmesa->st->pipe;
+   struct pipe_screen *screen = pipe->screen;
+
+   if (osbuffer->staging[0] &&
+       (osbuffer->staging[0]->width0 != res->width0 || osbuffer->staging[0]->height0 != res->height0 ||
+        osbuffer->staging[0]->format != res->format))
+      osmesa_free_staging(osbuffer, screen);
+
+   if (!osbuffer->staging[0]) {
+      struct pipe_resource templ;
+      memset(&templ, 0, sizeof(templ));
+      templ.target = PIPE_TEXTURE_2D;
+      templ.format = res->format;
+      templ.width0 = res->width0;
+      templ.height0 = res->height0;
+      templ.depth0 = 1;
+      templ.array_size = 1;
+      templ.usage = PIPE_USAGE_STAGING;
+      templ.bind = PIPE_BIND_LINEAR;
+      for (unsigned i = 0; i < 2; i++)
+         osbuffer->staging[i] = screen->resource_create(screen, &templ);
+      if (!osbuffer->staging[0] || !osbuffer->staging[1]) {
+         osmesa_free_staging(osbuffer, screen);
+         return false;
+      }
+   }
+
+   const unsigned cur = osbuffer->staging_cur;
+   struct pipe_box box;
+   u_box_2d(0, 0, res->width0, res->height0, &box);
+   pipe->resource_copy_region(pipe, osbuffer->staging[cur], 0, 0, 0, 0, res, 0, &box);
+
+   struct pipe_fence_handle *fence = NULL;
+   pipe->flush(pipe, &fence, PIPE_FLUSH_ASYNC);
+   osbuffer->staging_fence[cur] = fence;
+
+   /* The previous frame's snapshot, or this one the very first time. */
+   const unsigned show = osbuffer->staging_primed ? cur ^ 1 : cur;
+   if (osbuffer->staging_fence[show]) {
+      screen->fence_finish(screen, pipe, osbuffer->staging_fence[show], OS_TIMEOUT_INFINITE);
+      screen->fence_reference(screen, &osbuffer->staging_fence[show], NULL);
+   }
+
+   struct pipe_transfer *transfer = NULL;
+   const uint8_t *src = pipe->texture_map(pipe, osbuffer->staging[show], 0, PIPE_MAP_READ, &box, &transfer);
+   if (!src)
+      return false;
+
+   if (y_up) {
+      dst = (uint8_t *)dst + (res->height0 - 1) * dst_stride;
