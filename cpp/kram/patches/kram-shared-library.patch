+#if COMPILE_ASTCENC
+// Keeps one astcenc context alive across the mips of an image. Creating a context builds large
+// lookup tables, which is a noticeable cost for every small mip. The settings are the same for
+// all mips, but are compared anyway so a changed setting gets a new context.
+class AstcEncoderCache {
+public:
+    struct Key {
+        astcenc_profile profile;
+        unsigned int blockX, blockY;
+        unsigned int flags;
+        float quality;
+        float cwR, cwG, cwB, cwA;
+        unsigned int threads;
+
+        bool operator==(const Key& o) const
+        {
+            return profile == o.profile && blockX == o.blockX && blockY == o.blockY &&
+                   flags == o.flags && quality == o.quality && cwR == o.cwR && cwG == o.cwG &&
+                   cwB == o.cwB && cwA == o.cwA && threads == o.threads;
+        }
+    };
+
+    AstcEncoderCache() = default;
+    AstcEncoderCache(const AstcEncoderCache&) = delete;
+    AstcEncoderCache& operator=(const AstcEncoderCache&) = delete;
+    ~AstcEncoderCache() { release(); }
+
+    astcenc_context* acquire(const Key& key, const astcenc_config& config, astcenc_error& error)
+    {
+        if (_context && _key == key) {
+            // reset so the next image can be compressed with the same context
+            astcenc_compress_reset(_context);
+            error = ASTCENC_SUCCESS;
+            return _context;
+        }
+        release();
+        error = astcenc_context_alloc(&config, key.threads, &_context);
+        if (error != ASTCENC_SUCCESS) {
+            _context = nullptr;
+            return nullptr;
+        }
+        _key = key;
+        return _context;
+    }
+
+private:
+    void release()
+    {
+        if (_context) {
+            astcenc_context_free(_context);
+            _context = nullptr;
+        }
+    }
+
+    astcenc_context* _context = nullptr;
+    Key _key = {};
+};
+
+// Use every core the OS reports. astcenc hands out work in small tasks, so slower cores just do less.
+static unsigned int astcThreadCount()
+{
+    unsigned int count = std::thread::hardware_concurrency();
+    return count > 0 ? count : 4;
+}
+#else
+class AstcEncoderCache {};
+#endif
