+#if KRAM_SHARED_LIBRARY
+
+// Entry point when kramc is built as a shared library (KRAM_BUILD_SHARED), for hosts that load it
+// and run commands in-process, e.g. an Android app. Unlike main(), it returns the exit code.
+extern "C" __attribute__((visibility("default")))
+int kram_main(int argc, char* argv[])
+{
+    checkSimdSupport();
+    return kram::kramAppMain(argc, argv) != 0 ? 1 : 0;
+}
+
+// Same, but everything the command prints on the calling thread is passed to `output` instead of
+// stdout/the platform log. Calls on different threads can run at the same time.
+extern "C" __attribute__((visibility("default")))
+int kram_main_output(int argc, char* argv[], void (*output)(void* user, const char* text, size_t length), void* user)
+{
+    kram::setThreadLogSink(output, user);
+    int result = kram_main(argc, argv);
+    kram::setThreadLogSink(nullptr, nullptr);
+    return result;
+}
+
+#else
+
 int main(int argc, char* argv[])
 {
     // This will exit if insufficient simd support on x64.
