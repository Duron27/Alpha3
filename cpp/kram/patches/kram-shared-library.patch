+// Optional per-thread output sink. While set, log messages and command output produced on the calling
+// thread go to the sink instead of stdout/the platform log, so a host that runs kram in-process can
+// capture the output of several runs on different threads at once. Pass nullptr to restore the default.
+typedef void (*LogSinkFunc)(void* user, const char* text, size_t length);
+void setThreadLogSink(LogSinkFunc sink, void* user);
+
+// Writes command output (as opposed to log messages) to stdout, or to the thread's sink when one is set.
+void writeCommandOutput(const char* text, size_t length);
