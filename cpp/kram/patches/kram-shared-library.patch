@@ -838,10 +838,43 @@ void setMessageFields(LogMessage& msg, char threadName[kMaxThreadName])
     msg.timestamp = currentTimestamp();
 }
 
+struct ThreadLogSink {
+    LogSinkFunc func = nullptr;
+    void* user = nullptr;
+};
+static thread_local ThreadLogSink gThreadLogSink;
+
+void setThreadLogSink(LogSinkFunc sink, void* user)
+{
+    gThreadLogSink.func = sink;
+    gThreadLogSink.user = user;
+}
+
+void writeCommandOutput(const char* text, size_t length)
+{
+    if (gThreadLogSink.func) {
+        gThreadLogSink.func(gThreadLogSink.user, text, length);
+    }
+    else {
+        fwrite(text, 1, length, stdout);
+    }
+}
+
 static int32_t logMessageImpl(const LogMessage& msg)
 {
     // TODO: add any filtering up here, or before msg is built
 
+    // a host capturing this thread's output gets the message instead of the platform log
+    if (gThreadLogSink.func) {
+        char tokens[kMaxTokens] = {};
+        getFormatTokens(tokens, msg, Debugger);
+
+        string text;
+        formatMessage(text, msg, tokens);
+        gThreadLogSink.func(gThreadLogSink.user, text.c_str(), text.size());
+        return (msg.logLevel == LogLevelError) ? 1 : 0;
+    }
+
     mylock lock(gLogState.lock);
 
     // this means caller needs to know all errors to display in the hud
