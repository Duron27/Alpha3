+	                       work->image_out, &work->swizzle, thread_id);
+
+	// This is a racy update, so which error gets returned is a random, but it
+	// will reliably report an error if an error occurs
+	if (error != ASTCENC_SUCCESS)
+	{
+		work->error = error;
+	}
+}
