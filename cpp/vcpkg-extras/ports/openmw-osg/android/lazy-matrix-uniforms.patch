+void State::computeDerivedMatrixUniforms(bool modelViewProjection, bool normal)
+{
+    if (modelViewProjection && _modelViewProjectionMatrixDirty && _modelViewProjectionMatrixUniform.valid())
+    {
+        _modelViewProjectionMatrixUniform->set((*_modelView) * (*_projection));
+        _modelViewProjectionMatrixDirty = false;
+    }
+    if (normal && _normalMatrixDirty && _normalMatrixUniform.valid())
+    {
+        // The transpose of the inverse of the upper 3x3 of the model view matrix is its cofactor matrix over its
+        // determinant: no 4x4 inverse
+        const Matrix& m = *_modelView;
+        const double c00 = m(1,1)*m(2,2) - m(1,2)*m(2,1);
+        const double c01 = m(1,2)*m(2,0) - m(1,0)*m(2,2);
+        const double c02 = m(1,0)*m(2,1) - m(1,1)*m(2,0);
+        const double det = m(0,0)*c00 + m(0,1)*c01 + m(0,2)*c02;
+        if (det != 0.0)
+        {
+            const double r = 1.0 / det;
+            const double c10 = m(0,2)*m(2,1) - m(0,1)*m(2,2);
+            const double c11 = m(0,0)*m(2,2) - m(0,2)*m(2,0);
+            const double c12 = m(0,1)*m(2,0) - m(0,0)*m(2,1);
+            const double c20 = m(0,1)*m(1,2) - m(0,2)*m(1,1);
+            const double c21 = m(0,2)*m(1,0) - m(0,0)*m(1,2);
+            const double c22 = m(0,0)*m(1,1) - m(0,1)*m(1,0);
+            _normalMatrixUniform->set(Matrix3(c00*r, c01*r, c02*r,
+                                              c10*r, c11*r, c12*r,
+                                              c20*r, c21*r, c22*r));
+        }
+        _normalMatrixDirty = false;
     }
 }
 
