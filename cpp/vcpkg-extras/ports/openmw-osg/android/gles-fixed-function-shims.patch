+ * OpenSceneGraph Public License for more details.
+*/
+
+#ifndef OSG_GLESFIXEDFUNCTIONSHIMS
+#define OSG_GLESFIXEDFUNCTIONSHIMS 1
+
+// Alpha3: the client vertex array calls of fixed function OpenGL for code that draws with them directly (OpenMW's
+// MyGUI renderer), built with OSG for OpenGL ES 3. Included by <osg/GL> when OSG_GLES_FIXED_FUNCTION_SHIMS is defined
+// by the code that wants them. The arrays go to the generic attributes OSG's compact vertex attribute aliasing binds
+// gl_Vertex, gl_Color and gl_MultiTexCoord0 to (0, 2 and 3), for texture unit 0 only.
+
+#if defined(OSG_GLES2_AVAILABLE) || defined(OSG_GLES3_AVAILABLE)
+
+#ifndef GL_VERTEX_ARRAY
+    #define GL_VERTEX_ARRAY        0x8074
+#endif
+#ifndef GL_COLOR_ARRAY
+    #define GL_COLOR_ARRAY         0x8076
+#endif
+#ifndef GL_TEXTURE_COORD_ARRAY
+    #define GL_TEXTURE_COORD_ARRAY 0x8078
+#endif
+#ifndef GL_CLIP_PLANE0
+    #define GL_CLIP_PLANE0         0x3000
+#endif
+
+namespace osg_gles_shims
+{
+    inline GLuint attributeOfArray(GLenum array)
+    {
+        switch (array)
+        {
+            case GL_COLOR_ARRAY: return 2;
+            case GL_TEXTURE_COORD_ARRAY: return 3;
+            default: return 0;
+        }
+    }
+}
+
+inline void glEnableClientState(GLenum array) { glEnableVertexAttribArray(osg_gles_shims::attributeOfArray(array)); }
+inline void glDisableClientState(GLenum array) { glDisableVertexAttribArray(osg_gles_shims::attributeOfArray(array)); }
+
+inline void glVertexPointer(GLint size, GLenum type, GLsizei stride, const void* pointer)
+{
+    glVertexAttribPointer(0, size, type, GL_FALSE, stride, pointer);
+}
+
+inline void glColorPointer(GLint size, GLenum type, GLsizei stride, const void* pointer)
+{
+    // colours in bytes are normalised, as the fixed function colour array takes them
+    glVertexAttribPointer(2, size, type, type == GL_UNSIGNED_BYTE || type == GL_BYTE ? GL_TRUE : GL_FALSE, stride, pointer);
+}
+
+inline void glTexCoordPointer(GLint size, GLenum type, GLsizei stride, const void* pointer)
+{
+    glVertexAttribPointer(3, size, type, GL_FALSE, stride, pointer);
+}
+
+#endif
+
+#endif
