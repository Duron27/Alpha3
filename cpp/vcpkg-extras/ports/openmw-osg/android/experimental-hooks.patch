diff --git a/src/osg/Shader.cpp b/src/osg/Shader.cpp
index 7a67166..5454f16 100644
--- a/src/osg/Shader.cpp
+++ b/src/osg/Shader.cpp
@@ -636,7 +636,23 @@ void Shader::PerContextShader::compileShader(osg::State& state)
 
     std::string source = _shader->getShaderSource();
     // Alpha3: an application can change the source for the GL implementation it runs on (OpenMW's GLSL 1.20 for OpenGL ES)
-    if (RuntimeHooks* hooks = RuntimeHooks::get()) hooks->translateShaderSource(*_shader, source);
+    if (RuntimeHooks* hooks = RuntimeHooks::get())
+    {
+        // Alpha3: a state's defines (#pragma import_defines) go in first, after the #version line, for a translation that
+        // runs the preprocessor (glslang); they are put in again below, which redefines them the same
+        if (!_defineStr.empty())
+        {
+            std::string::size_type at = source.find("#version");
+            if (at != std::string::npos)
+            {
+                at = source.find('\n', at);
+                at = at == std::string::npos ? source.size() : at + 1;
+            }
+            else at = 0;
+            source.insert(at, _defineStr);
+        }
+        hooks->translateShaderSource(*_shader, source);
+    }
     // Alpha3: only vertex shaders get their gl_ built-ins renamed. For other stages the declarations OSG inserts can land
     // after the first use, and OpenMW's fragment profile declares the matrices it needs itself. Every stage still gets the
     // $OSG_ variables substituted (osgText's shaders start with one).
@@ -891,5 +907,7 @@ void Shader::_computeShaderDefines()
         pos = eol;
     }
 
+    // Alpha3: defines the application imports for this shader beyond its own pragmas
+    if (RuntimeHooks* hooks = RuntimeHooks::get()) hooks->shaderDefinesComputed(*this, _shaderDefines);
 }
 
