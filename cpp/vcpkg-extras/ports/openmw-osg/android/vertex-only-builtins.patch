     std::string source = _shader->getShaderSource();
-    // if (_shader->getType()==osg::Shader::VERTEX && (state.getUseVertexAttributeAliasing() || state.getUseModelViewAndProjectionUniforms()))
+    // Alpha3: only vertex shaders get their gl_ built-ins renamed. For other stages the declarations OSG inserts can land
+    // after the first use, and OpenMW's fragment profile declares the matrices it needs itself. Every stage still gets the
+    // $OSG_ variables substituted (osgText's shaders start with one).
+    // Shaders in the 320 es dialect declare their own attributes and uniforms: renaming and declaring on top of that would
+    // clash, or put declarations inside an inactive block.
+    const std::string::size_type versionPos = source.find("#version ");
+    const std::string::size_type versionEnd = source.find('\n', versionPos);
+    const bool declaresItself = versionPos != std::string::npos
+        && source.substr(versionPos, versionEnd - versionPos).find(" es") != std::string::npos;
+    if (_shader->getType()==osg::Shader::VERTEX && !declaresItself)
     {
         state.convertVertexShaderSourceToOsgBuiltIns(source);
     }
+    else
+    {
+        state.substituteShaderVariables(source);
+    }
 
 
     GLint compiled = GL_FALSE;
