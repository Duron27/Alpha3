+
 bool State::convertVertexShaderSourceToOsgBuiltIns(std::string& source) const
 {
     OSG_DEBUG<<"State::convertShaderSourceToOsgBuiltIns()"<<std::endl;
@@ -1384,12 +1389,45 @@
         declPos = 0;
     }
 
-    std::string::size_type extPos = source.rfind( "#extension " );
-    if ( extPos != std::string::npos )
+    // Alpha3: the declarations must come after every #extension directive, and must survive the preprocessor. OpenMW
+    // wraps "#extension GL_EXT_gpu_shader4" in "#if @useGPUShader4"; the old search for the last "#extension " put the
+    // declarations inside that block, and with the define at 0 they were compiled out (osg_Vertex undeclared). So only
+    // directives outside any conditional count, and one inside a conditional counts as the end of its outermost block.
     {
-        // found the string, now find the next linefeed and set the insertion point after it.
-        declPos = source.find( '\n', extPos );
-        declPos = declPos != std::string::npos ? declPos+1 : source.length();
+        int depth = 0;
+        bool extensionInBlock = false;
+        std::string::size_type lineStart = declPos;
+        while (lineStart < source.length())
+        {
+            std::string::size_type lineEnd = source.find('\n', lineStart);
+            const std::string::size_type next = lineEnd != std::string::npos ? lineEnd + 1 : source.length();
+            const std::string::size_type first = source.find_first_not_of(" \t", lineStart);
+            if (first != std::string::npos && first < next && source[first] == '#')
+            {
+                const std::string::size_type word = source.find_first_not_of(" \t", first + 1);
+                if (word != std::string::npos && word < next)
+                {
+                    if (source.compare(word, 2, "if") == 0)
+                        ++depth;
+                    else if (source.compare(word, 5, "endif") == 0)
+                    {
+                        if (depth > 0 && --depth == 0 && extensionInBlock)
+                        {
+                            declPos = next;
+                            extensionInBlock = false;
+                        }
+                    }
+                    else if (source.compare(word, 9, "extension") == 0)
+                    {
+                        if (depth == 0)
+                            declPos = next;
+                        else
+                            extensionInBlock = true;
+                    }
+                }
+            }
+            lineStart = next;
+        }
     }
     if (_useModelViewAndProjectionUniforms)
     {
diff --git a/src/osg/Shader.cpp b/src/osg/Shader.cpp
--- a/src/osg/Shader.cpp
