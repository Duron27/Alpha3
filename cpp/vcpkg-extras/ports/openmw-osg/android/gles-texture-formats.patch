+    // Alpha3: OpenGL ES 3 takes only sized depth formats, with a matching source format and type, and no mipmaps of them
+    bool isDepthFormat(GLenum format)
+    {
+        switch (format)
+        {
+            case GL_DEPTH_COMPONENT: case 0x81A5 /*GL_DEPTH_COMPONENT16*/: case 0x81A6 /*GL_DEPTH_COMPONENT24*/:
+            case 0x8CAC /*GL_DEPTH_COMPONENT32F*/: case 0x84F9 /*GL_DEPTH_STENCIL*/: case 0x88F0 /*GL_DEPTH24_STENCIL8*/:
+            case 0x8CAD /*GL_DEPTH32F_STENCIL8*/:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    // number of channels of a sized floating point colour format, 0 for anything else
+    int floatChannels(GLenum format)
+    {
+        switch (format)
+        {
+            case 0x822D /*GL_R16F*/: case 0x822E /*GL_R32F*/: return 1;
+            case 0x822F /*GL_RG16F*/: case 0x8230 /*GL_RG32F*/: return 2;
+            case 0x881B /*GL_RGB16F*/: case 0x8815 /*GL_RGB32F*/: case 0x8C3A /*GL_R11F_G11F_B10F*/: return 3;
+            case 0x881A /*GL_RGBA16F*/: case 0x8814 /*GL_RGBA32F*/: return 4;
+            default: return 0;
+        }
+    }
