+
+#include <osg/RuntimeHooks>
+#include <osg/GraphicsContext>
+#include <osg/GLExtensions>
+#include <osg/State>
+
+using namespace osg;
+
+RuntimeHooks* RuntimeHooks::s_hooks = 0;
+
+void RuntimeHooks::set(RuntimeHooks* hooks)
+{
+    // kept for the life of the library
+    if (hooks) hooks->ref();
+    RuntimeHooks* previous = s_hooks;
+    s_hooks = hooks;
+    if (previous) previous->unref();
+}
+
+bool RuntimeHooks::glesFixes(const State& state)
+{
+    if (!s_hooks) return false;
+    const GLExtensions* extensions = state.get<GLExtensions>();
+    return extensions && extensions->isOpenGLES;
+}
+
+void RuntimeHooks::swapBuffers(GraphicsContext& gc)
+{
+    gc.swapBuffersImplementation();
+}
