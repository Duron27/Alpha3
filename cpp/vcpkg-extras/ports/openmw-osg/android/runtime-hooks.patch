+Program::ShaderList Program::getEffectiveShaders() const
+{
+    RuntimeHooks* hooks = RuntimeHooks::get();
+    if (!hooks) return _shaderList;
+
+    OpenThreads::ScopedLock<OpenThreads::Mutex> lock(_effectiveShadersMutex);
+    if (!_effectiveShadersValid)
+    {
+        _effectiveShaders.clear();
+        std::vector<Shader::Type> types;
+        for (ShaderList::const_iterator itr = _shaderList.begin(); itr != _shaderList.end(); ++itr)
+        {
+            if (std::find(types.begin(), types.end(), (*itr)->getType()) == types.end()) types.push_back((*itr)->getType());
+        }
+        for (std::vector<Shader::Type>::const_iterator type = types.begin(); type != types.end(); ++type)
+        {
+            std::vector<const Shader*> stage;
+            for (ShaderList::const_iterator itr = _shaderList.begin(); itr != _shaderList.end(); ++itr)
+            {
+                if ((*itr)->getType() == *type) stage.push_back(itr->get());
+            }
+            ref_ptr<Shader> merged = stage.size() > 1 ? hooks->mergeShaderStage(stage) : ref_ptr<Shader>();
+            if (merged.valid()) _effectiveShaders.push_back(merged);
+            else
+            {
+                for (std::vector<const Shader*>::const_iterator itr = stage.begin(); itr != stage.end(); ++itr)
+                    _effectiveShaders.push_back(const_cast<Shader*>(*itr));
+            }
+        }
+        _effectiveShadersValid = true;
+    }
+    return _effectiveShaders;
+}
