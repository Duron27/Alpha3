+/** Points where an application can change how OSG drives the GL implementation, without changes to the application
+  * code that uses OSG (Alpha3's Android build of OpenMW: shader translation for OpenGL ES, a program binary cache, frame
+  * pacing, texture conversion). Nothing calls a hook unless a hooks object is installed with RuntimeHooks::set(), and
+  * with none installed OSG behaves as it always did. A static OSG linked into several libraries has one hooks object
+  * per library. */
+class OSG_EXPORT RuntimeHooks : public Referenced
+{
+    public:
+
+        /** Installs the hooks of this copy of OSG, or none with NULL. Meant to be called once, before any context is made. */
+        static void set(RuntimeHooks* hooks);
+
+        /** The installed hooks, NULL if there are none. */
+        static RuntimeHooks* get() { return s_hooks; }
+
+        /** True when hooks are installed and the context is OpenGL ES: OSG then works around what OpenGL ES rejects
+          * (unsized depth formats, mipmapped depth textures, shadow comparison on colour textures, ...). */
+        static bool glesFixes(const State& state);
+
+        /** A context has just been made current, before OSG reads its extensions (GL entry points can be loaded here). */
+        virtual void contextMadeCurrent(GraphicsContext& /*gc*/) {}
+
+        /** The extensions of a context have just been read, with the context current. */
+        virtual void extensionsRead(GLExtensions& /*extensions*/) {}
+
+        /** Swaps the buffers of a context that has no swap callback, in place of its swapBuffersImplementation(). The
+          * default swaps them. */
+        virtual void swapBuffers(GraphicsContext& gc);
+
+        /** Changes the source a shader is compiled from, before OSG's own substitutions. Called on the thread that
+          * compiles the shader. Returns false to compile the source as it is. */
+        virtual bool translateShaderSource(const Shader& /*shader*/, std::string& /*source*/) { return false; }
+
+        /** The shaders of one stage of a program (more than one, in the order of the program). A shader returned is
+          * compiled and attached in their place; NULL keeps them as they are. */
+        virtual ref_ptr<Shader> mergeShaderStage(const std::vector<const Shader*>& /*shaders*/) { return 0; }
+
+        /** Key of the saved binary of a program with these defines; empty for a program that is not saved. */
+        virtual std::string programBinaryKey(const Program& /*program*/, const std::string& /*defines*/, State& /*state*/) { return std::string(); }
+
+        /** The binary saved under the key, NULL if there is none. */
+        virtual ref_ptr<Program::ProgramBinary> loadProgramBinary(const std::string& /*key*/, State& /*state*/) { return 0; }
+
+        /** A program has been linked from its shaders: its binary, to save under the key. */
+        virtual void storeProgramBinary(const std::string& /*key*/, const Program::ProgramBinary& /*binary*/, State& /*state*/) {}
+
+        /** An image a plugin has just read (extension without the dot). Returns the image to use in its place, or NULL
+          * to keep it. Called on the thread that reads the image. */
+        virtual ref_ptr<Image> imageRead(Image& /*image*/, const std::string& /*extension*/) { return 0; }
+
+    protected:
+
+        virtual ~RuntimeHooks() {}
+
+        static RuntimeHooks* s_hooks;
+};
+
+}
