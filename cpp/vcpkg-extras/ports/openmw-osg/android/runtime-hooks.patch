+bool Program::PerContextProgram::linkFromSavedBinary(osg::State& state)
+{
+    _binaryKey.clear();
+    RuntimeHooks* hooks = RuntimeHooks::get();
+    if (!hooks || !_glProgramHandle) return false;
+
+    _binaryKey = hooks->programBinaryKey(*_program, _defineStr, state);
+    if (_binaryKey.empty()) return false;
+
+    _savedBinary = hooks->loadProgramBinary(_binaryKey, state);
+    if (!_savedBinary.valid() || _savedBinary->getSize() == 0)
+    {
+        _savedBinary = 0;
+        return false;
+    }
+
+    linkProgram(state);
+    _savedBinary = 0;
+    if (_loadedBinary) return true;
+
+    // not taken by the driver (or not linked from it): compiled and linked as usual, then saved again
+    requestLink();
+    return false;
+}
