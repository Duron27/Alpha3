diff --git a/CMakeLists.txt b/CMakeLists.txt
index b77fb64a1..520b65eaa 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -307,7 +307,7 @@

 INCLUDE_DIRECTORIES(${OpenSceneGraph_SOURCE_DIR}/include/)

-INCLUDE_DIRECTORIES(SYSTEM ${OPENGL_INCLUDE_DIR})
+INCLUDE_DIRECTORIES(SYSTEM "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/include")

 # Common global definitions
 #ADD_DEFINITIONS(-D)
@@ -585,7 +585,8 @@
         SET(OPENGL_HEADER1 "#include \"TargetConditionals.h\"" CACHE STRING "#include<> line for OpenGL Header")
         SET(OPENGL_HEADER2 "#include <OpenGLES/ES3/gl.h>" CACHE STRING "#include<> line for additional OpenGL Headers if required")
     ELSE()
-        SET(OPENGL_HEADER1 "#include <GLES3/gl3.h>" CACHE STRING "#include<> line for OpenGL Header")
+        #SET(OPENGL_HEADER1 "#include <GLES3/gl3.h>" CACHE STRING "#include<> line for OpenGL Header")
+        SET(OPENGL_HEADER1 "#include <glad/gles2.h>" CACHE STRING "#include<> line for OpenGL Header")
         SET(OPENGL_HEADER2 "" CACHE STRING "#include<> line for additional OpenGL Headers if required")
     ENDIF()
 ELSE()
@@ -652,12 +653,23 @@
                  PATHS
                      ${ANDROID_SYSROOT}/usr/lib)
     ELSEIF(OSG_GLES3_AVAILABLE)
-        FIND_PATH(OPENGL_INCLUDE_DIR GLES3/gl3.h
-              PATHS
-              ${ANDROID_SYSROOT}/usr/include)
-        FIND_LIBRARY(OPENGL_gl_LIBRARY  GLESv3
-                 PATHS
-                     ${ANDROID_SYSROOT}/usr/lib)
+         # Use glad from vcpkg instead of system GLES3 headers.
+        # VCPKG_INSTALLED_DIR and VCPKG_TARGET_TRIPLET are provided by the
+        # vcpkg toolchain file, so this works in both manifest and classic mode
+        # without hardcoding any paths.
+        set(_OSG_GLAD_ROOT "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}")
+
+        FIND_PATH(OPENGL_INCLUDE_DIR glad/gles2.h
+            PATHS
+                ${_OSG_GLAD_ROOT}/include
+                ${ANDROID_SYSROOT}/usr/include
+            NO_DEFAULT_PATH)
+
+        FIND_LIBRARY(OPENGL_gl_LIBRARY glad
+            PATHS
+                ${_OSG_GLAD_ROOT}/lib
+                ${ANDROID_SYSROOT}/usr/lib
+            NO_DEFAULT_PATH)
     ENDIF()
 ENDIF()

diff --git a/src/osg/GLExtensions.cpp b/src/osg/GLExtensions.cpp
index 357796b17..1be315555 100644
--- a/src/osg/GLExtensions.cpp
+++ b/src/osg/GLExtensions.cpp
@@ -336,7 +336,19 @@
         #elif defined(OSG_GLES2_AVAILABLE)
             static void *handle = dlopen("libGLESv2.so", RTLD_NOW);
         #elif defined(OSG_GLES3_AVAILABLE)
-            static void *handle = dlopen("libGLESv3.so", RTLD_NOW);
+            static void *handle;
+            if (getenv("OSG_USE_ZINK") != nullptr)
+            {
+                // Zink through OSMesa (desktop GL): the functions come from OSMesaGetProcAddress
+                typedef void* (*OSMesaProc)(const char*);
+                static void *osmesa = dlopen("libOSMesa_8.so", RTLD_NOW);
+                static OSMesaProc getProc = osmesa ? (OSMesaProc)dlsym(osmesa, "OSMesaGetProcAddress") : nullptr;
+                return getProc ? getProc(funcName) : nullptr;
+            }
+            else if (getenv("OSG_USE_ANGLE") != nullptr)
+                handle = dlopen("libGLESv2_angle.so", RTLD_NOW);
+            else
+                handle = dlopen("libGLESv3.so", RTLD_NOW);
         #elif defined(OSG_GL1_AVAILABLE)
             static void *handle = dlopen("libGL.so", RTLD_NOW);
         #endif
