diff --git a/src/osg/Geometry.cpp b/src/osg/Geometry.cpp
index ebdb8ba..40c6f19 100644
--- a/src/osg/Geometry.cpp
+++ b/src/osg/Geometry.cpp
@@ -890,6 +890,30 @@ void Geometry::drawImplementation(RenderInfo& renderInfo) const
     osg::VertexArrayState* vas = state.getCurrentVertexArrayState();
     vas->setVertexBufferObjectSupported(usingVertexBufferObjects);
 
+    // Alpha3: drawn by code that calls drawImplementation itself (OpenMW's terrain composite maps) instead of through
+    // Drawable::draw, the current vertex array state is the global one, which has no VAO, while the VAO the last geometry
+    // drew with is still bound and would take this geometry's arrays (client arrays, which OpenGL ES does not allow on a
+    // VAO, when it has no VBOs) and element buffer. Draw on VAO 0, as without VAOs; Drawable::draw has bound it already.
+    if (vas->getVertexArrayObject() == 0)
+    {
+        state.bindVertexArrayObject(vas);
+        usingVertexArrayObjects = false;
+        if (state.useVertexArrayObject(false)) // OSG_VERTEX_BUFFER_HINT=VAO
+        {
+            // With VAOs on, what VAO 0 holds is not what this state set last: other states draw on it too (MyGUI's
+            // leaves its colour array on, which the composite maps would take for their overall white and come out
+            // black), and the array buffer binding is the context's, which the VAO geometries change. So everything
+            // is turned off and set again, and drawVertexArraysImplementation, which with VAOs on sets the arrays only
+            // when the state asks for it, is asked to.
+            GLExtensions* ext = state.get<GLExtensions>();
+            ext->glBindBuffer(GL_ARRAY_BUFFER_ARB, 0);
+            ext->glBindBuffer(GL_ELEMENT_ARRAY_BUFFER_ARB, 0);
+            vas->resetBufferObjectPointers();
+            state.disableAllVertexArrays();
+            vas->setRequiresSetArrays(true);
+        }
+    }
+
     bool checkForGLErrors = state.getCheckForGLErrors()==osg::State::ONCE_PER_ATTRIBUTE;
     if (checkForGLErrors) state.checkGLErrors("start of Geometry::drawImplementation()");
 
diff --git a/src/osg/State.cpp b/src/osg/State.cpp
index 0b816f8..bc086d8 100644
--- a/src/osg/State.cpp
+++ b/src/osg/State.cpp
@@ -1136,6 +1136,11 @@ void State::resetVertexAttributeAlias(bool compactAliasing, unsigned int numText
 
 void State::disableAllVertexArrays()
 {
+    // Alpha3: the arrays are those of the current vertex array state. With VAOs on, the VAO a geometry drew with stays
+    // bound after it, and code drawing by itself with the global state (OpenMW's MyGUI renderer, which starts here) would
+    // change that geometry's VAO, or set client arrays on it, which OpenGL ES does not allow. The global state's VAO is 0.
+    if (_vas) bindVertexArrayObject(_vas);
+
     disableVertexPointer();
     disableColorPointer();
     disableFogCoordPointer();
