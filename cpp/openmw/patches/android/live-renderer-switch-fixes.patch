+    /// `#if __VERSION__ >= 450` (alone or leading an &&) is false in every GL dialect (120, 320 es).
+    bool isVulkanOnlyCondition(std::string_view condition)
+    {
+        const auto first = condition.find_first_not_of(" \t");
+        if (first == std::string_view::npos)
+            return false;
+        condition.remove_prefix(first);
+        constexpr std::string_view prefix = "__VERSION__";
+        if (!condition.starts_with(prefix))
+            return false;
+        condition.remove_prefix(prefix.size());
+        const auto operatorAt = condition.find_first_not_of(" \t");
+        if (operatorAt == std::string_view::npos || !condition.substr(operatorAt).starts_with(">="))
+            return false;
+        condition.remove_prefix(operatorAt + 2);
+        const auto numberAt = condition.find_first_not_of(" \t");
+        if (numberAt == std::string_view::npos || !condition.substr(numberAt).starts_with("450"))
+            return false;
+        condition.remove_prefix(numberAt + 3);
+        const auto rest = condition.find_first_not_of(" \t\r");
+        return rest == std::string_view::npos || condition.substr(rest).starts_with("&&")
+            || condition.substr(rest).starts_with("//");
+    }
+
+    /// Removes the blocks only the 450 (Vulkan) dialect compiles, which the GL dialects skip anyway. Mesa's GLSL preprocessor
+    /// mishandles one of these big nested blocks ("Unterminated #if"), and the sources shrink a lot. Dropped lines stay as
+    /// empty ones. A source with an #elif around such a block is left as it is.
+    void dropVulkanOnlyBlocks(std::string& source)
+    {
+        struct Frame
+        {
+            bool mStaticallyFalse = false;
+            bool mParentDropping = false;
+        };
+        std::vector<Frame> stack;
+        std::string result;
+        result.reserve(source.size());
+        bool dropping = false;
+        std::size_t position = 0;
+        while (position < source.size())
+        {
+            std::size_t end = source.find('\n', position);
+            const bool hasNewline = end != std::string::npos;
+            if (!hasNewline)
+                end = source.size();
+            const std::string_view line(source.data() + position, end - position);
+            position = hasNewline ? end + 1 : end;
+
+            std::string_view directive;
+            std::string_view rest;
+            const auto hash = line.find_first_not_of(" \t");
+            if (hash != std::string_view::npos && line[hash] == '#')
+            {
+                std::string_view body = line.substr(hash + 1);
+                const auto word = body.find_first_not_of(" \t");
+                if (word != std::string_view::npos)
+                {
+                    body.remove_prefix(word);
+                    const auto wordEnd = body.find_first_of(" \t(/");
+                    directive = body.substr(0, wordEnd);
+                    rest = wordEnd == std::string_view::npos ? std::string_view() : body.substr(wordEnd);
+                }
+            }
+
+            bool emit = !dropping;
+            if (directive == "if" || directive == "ifdef" || directive == "ifndef")
+            {
+                Frame frame;
+                frame.mParentDropping = dropping;
+                if (!dropping && directive == "if" && isVulkanOnlyCondition(rest))
+                {
+                    frame.mStaticallyFalse = true;
+                    dropping = true;
+                    emit = false;
+                }
+                stack.push_back(frame);
+            }
+            else if (directive == "elif")
+            {
+                if (!stack.empty() && stack.back().mStaticallyFalse)
+                    return;
+            }
+            else if (directive == "else")
+            {
+                if (!stack.empty() && stack.back().mStaticallyFalse)
+                {
+                    dropping = stack.back().mParentDropping;
+                    emit = false;
+                }
+            }
+            else if (directive == "endif")
+            {
+                if (!stack.empty())
+                {
+                    if (stack.back().mStaticallyFalse)
+                    {
+                        dropping = stack.back().mParentDropping;
+                        emit = false;
+                    }
+                    stack.pop_back();
+                }
+            }
+
+            if (emit)
+                result.append(line);
+            if (hasNewline)
+                result.push_back('\n');
+        }
+        source = std::move(result);
+    }
