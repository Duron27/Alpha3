+    void PostProcessor::refreshBackend()
+    {
+        const bool wasUbo = mUBO;
+        osg::GraphicsContext* gc = mViewer->getCamera()->getGraphicsContext();
+        if (gc != nullptr)
+        {
+            osg::GLExtensions* ext = gc->getState()->get<osg::GLExtensions>();
+            if (!ext->glDisablei && ext->glDisableIndexedEXT)
+                ext->glDisablei = ext->glDisableIndexedEXT;
+#ifdef ANDROID
+            ext->glDisablei = nullptr;
+#endif
+            mNormalsSupported = ext->glDisablei != nullptr;
+            mGLSLVersion = static_cast<int>(ext->glslLanguageVersion * 100);
+            mUBO = ext->isUniformBufferObjectSupported && mGLSLVersion >= 330;
+        }
+        else
+        {
+            mGLSLVersion = 460;
+            mUBO = true;
+            mNormalsSupported = true;
+        }
+        if (mUBO != wasUbo)
+        {
+            mStateUpdater = new Fx::StateUpdater(mUBO);
+            setCullCallback(mStateUpdater);
+        }
+
+        // Techniques are rebuilt from their files for the new dialect; the chain is the saved one
+        mTemplates.clear();
+        mQueuedTemplates.clear();
+        mInternalTechniques.clear();
+        auto distortion = loadTechnique("internal_distortion");
+        distortion->setInternal(true);
+        distortion->setLocked(true);
+        mInternalTechniques.push_back(std::move(distortion));
+        loadChain();
+        dirtyTechniques(true);
+    }
