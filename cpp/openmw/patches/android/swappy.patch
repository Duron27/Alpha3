+#ifdef ANDROID
+    void GraphicsWindowSDL2::initSwappy()
+    {
+        mUseSwappy = false;
+        // ANGLE brings its own EGL, which Swappy (it talks to the system's) cannot swap; Zink never gets here.
+        if (std::getenv("OSG_USE_ANGLE") != nullptr || std::getenv("OPENMW_NO_SWAPPY") != nullptr)
+            return;
+        auto* env = static_cast<JNIEnv*>(SDL_AndroidGetJNIEnv());
+        jobject activity = static_cast<jobject>(SDL_AndroidGetActivity());
+        SDL_SysWMinfo info;
+        SDL_VERSION(&info.version);
+        if (env == nullptr || activity == nullptr || !SDL_GetWindowWMInfo(mWindow, &info))
+        {
+            Log(Debug::Warning) << "Frame pacing: no Java environment or native window, using plain swaps";
+            return;
+        }
+        if (!SwappyGL_init(env, activity))
+        {
+            Log(Debug::Warning) << "Frame pacing: Swappy could not start, using plain swaps";
+            return;
+        }
+        if (!SwappyGL_setWindow(info.info.android.window))
+        {
+            Log(Debug::Warning) << "Frame pacing: Swappy rejected the window, using plain swaps";
+            SwappyGL_destroy();
+            return;
+        }
+        // Swappy times the swaps itself and needs the driver's vertical sync on.
+        SDL_GL_SetSwapInterval(1);
+        mUseSwappy = true;
+        Log(Debug::Info) << "Frame pacing: Swappy, display period " << SwappyGL_getRefreshPeriodNanos() / 1.0e6 << " ms";
+    }
+#endif
