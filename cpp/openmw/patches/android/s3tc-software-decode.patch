+    {
+        const bool dxt1 = format == GL_COMPRESSED_RGB_S3TC_DXT1_EXT || format == GL_COMPRESSED_RGBA_S3TC_DXT1_EXT;
+        const bool transparent = format == GL_COMPRESSED_RGBA_S3TC_DXT1_EXT;
+        const std::size_t blockBytes = dxt1 ? 8 : 16;
+        unsigned char palette[4][4];
+        unsigned char alphas[16];
+        for (int row = 0; row < height; row += 4)
+            for (int column = 0; column < width; column += 4)
+            {
+                const unsigned char* colourBlock = source + (dxt1 ? 0 : 8);
+                colourPalette(colourBlock, dxt1, transparent, palette);
+                if (format == GL_COMPRESSED_RGBA_S3TC_DXT3_EXT)
+                {
+                    for (int i = 0; i < 16; ++i)
+                    {
+                        const unsigned nibble = (source[i / 2] >> ((i & 1) * 4)) & 15;
+                        alphas[i] = static_cast<unsigned char>(nibble * 17);
+                    }
+                }
+                else if (format == GL_COMPRESSED_RGBA_S3TC_DXT5_EXT)
+                {
+                    unsigned char ramp[8];
+                    ramp[0] = source[0];
+                    ramp[1] = source[1];
+                    if (ramp[0] > ramp[1])
+                        for (int i = 1; i < 7; ++i)
+                            ramp[i + 1] = static_cast<unsigned char>(((7 - i) * ramp[0] + i * ramp[1]) / 7);
+                    else
+                    {
+                        for (int i = 1; i < 5; ++i)
+                            ramp[i + 1] = static_cast<unsigned char>(((5 - i) * ramp[0] + i * ramp[1]) / 5);
+                        ramp[6] = 0;
+                        ramp[7] = 255;
+                    }
+                    std::uint64_t bits = 0;
+                    for (int i = 0; i < 6; ++i)
+                        bits |= std::uint64_t{ source[2 + i] } << (8 * i);
+                    for (int i = 0; i < 16; ++i)
+                        alphas[i] = ramp[(bits >> (3 * i)) & 7];
+                }
+                const unsigned indices = colourBlock[4] | (colourBlock[5] << 8) | (colourBlock[6] << 16)
+                    | (static_cast<unsigned>(colourBlock[7]) << 24);
+                const int rows = std::min(4, height - row), columns = std::min(4, width - column);
+                for (int y = 0; y < rows; ++y)
+                {
+                    unsigned char* pixel = out + (static_cast<std::size_t>(row + y) * width + column) * channels;
+                    for (int x = 0; x < columns; ++x, pixel += channels)
+                    {
+                        const int texel = y * 4 + x;
+                        const unsigned char* colour = palette[(indices >> (2 * texel)) & 3];
+                        pixel[0] = colour[0];
+                        pixel[1] = colour[1];
+                        pixel[2] = colour[2];
+                        if (channels == 4)
+                            pixel[3] = dxt1 ? colour[3] : alphas[texel];
+                    }
+                }
+                source += blockBytes;
+            }
+    }
