+    // Every mip level the file carried is kept so the GPU does not have to rebuild them.
+    osg::ref_ptr<osg::Image> decompressS3TC(const osg::Image& source)
+    {
+        const GLenum format = source.getPixelFormat();
+        const bool opaque = format == GL_COMPRESSED_RGB_S3TC_DXT1_EXT;
+        const unsigned channels = opaque ? 3 : 4;
+        const std::size_t blockBytes
+            = (format == GL_COMPRESSED_RGB_S3TC_DXT1_EXT || format == GL_COMPRESSED_RGBA_S3TC_DXT1_EXT) ? 8 : 16;
+        const unsigned levels = std::max(1u, source.getNumMipmapLevels());
+
+        std::vector<std::size_t> offsets;
+        std::size_t total = 0, needed = 0;
+        for (unsigned level = 0; level < levels; ++level)
+        {
+            const std::size_t width = std::max(1, source.s() >> level), height = std::max(1, source.t() >> level);
+            offsets.push_back(total);
+            total += width * height * channels;
+            needed += ((width + 3) / 4) * ((height + 3) / 4) * blockBytes;
+        }
+        if (source.getTotalSizeInBytesIncludingMipmaps() < needed)
+            return nullptr;
+
+        auto* data = new unsigned char[total];
+        for (unsigned level = 0; level < levels; ++level)
+            decodeS3TCLevel(format, source.isMipmap() ? source.getMipmapData(level) : source.data(),
+                std::max(1, source.s() >> level), std::max(1, source.t() >> level), channels, data + offsets[level]);
+
+        osg::ref_ptr<osg::Image> result = new osg::Image;
+        const GLenum decoded = opaque ? GL_RGB : GL_RGBA;
+        result->setImage(source.s(), source.t(), 1, decoded, decoded, GL_UNSIGNED_BYTE, data, osg::Image::USE_NEW_DELETE);
+        if (levels > 1)
+            result->setMipmapLevels(osg::Image::MipmapDataType(offsets.begin() + 1, offsets.end()));
+        result->setFileName(source.getFileName());
+        result->setOrigin(source.getOrigin());
+        return result;
+    }
