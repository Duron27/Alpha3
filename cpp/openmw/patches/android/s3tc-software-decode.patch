+    Rgb expand565(unsigned value)
+    {
+        const unsigned r = (value >> 11) & 31, g = (value >> 5) & 63, b = value & 31;
+        return { static_cast<unsigned char>((r << 3) | (r >> 2)), static_cast<unsigned char>((g << 2) | (g >> 4)),
+            static_cast<unsigned char>((b << 3) | (b >> 2)) };
+    }
