+    // The colour half of a DXT block as four RGBA entries. Only DXT1 changes meaning when the first endpoint is not
+    // the larger one: it then holds three colours and a transparent (or black) fourth.
+    void colourPalette(const unsigned char* block, bool dxt1, bool transparent, unsigned char (&palette)[4][4])
+    {
+        const unsigned c0 = block[0] | (block[1] << 8);
+        const unsigned c1 = block[2] | (block[3] << 8);
+        const Rgb a = expand565(c0), b = expand565(c1);
+        const auto put = [&](int i, int r, int g, int bl, int alpha) {
+            palette[i][0] = static_cast<unsigned char>(r);
+            palette[i][1] = static_cast<unsigned char>(g);
+            palette[i][2] = static_cast<unsigned char>(bl);
+            palette[i][3] = static_cast<unsigned char>(alpha);
+        };
+        put(0, a.r, a.g, a.b, 255);
+        put(1, b.r, b.g, b.b, 255);
+        if (!dxt1 || c0 > c1)
+        {
+            put(2, (2 * a.r + b.r) / 3, (2 * a.g + b.g) / 3, (2 * a.b + b.b) / 3, 255);
+            put(3, (a.r + 2 * b.r) / 3, (a.g + 2 * b.g) / 3, (a.b + 2 * b.b) / 3, 255);
+        }
+        else
+        {
+            put(2, (a.r + b.r) / 2, (a.g + b.g) / 2, (a.b + b.b) / 2, 255);
+            put(3, 0, 0, 0, transparent ? 0 : 255);
+        }
+    }
