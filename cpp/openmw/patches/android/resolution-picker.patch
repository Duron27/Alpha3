+#ifdef ANDROID
+        // The Android surface has a fixed size that the activity can change (SDLActivity.setSurfaceResolution). SDL then
+        // reports an ordinary resize, which the rest of the engine already handles.
+        bool setAndroidSurfaceResolution(int width, int height)
+        {
+            auto* env = static_cast<JNIEnv*>(SDL_AndroidGetJNIEnv());
+            auto activity = static_cast<jobject>(SDL_AndroidGetActivity());
+            if (env == nullptr || activity == nullptr)
+                return false;
+
+            jclass activityClass = env->GetObjectClass(activity);
+            jmethodID method = env->GetMethodID(activityClass, "setSurfaceResolution", "(II)V");
+            const bool found = method != nullptr;
+            if (found)
+                env->CallVoidMethod(activity, method, width, height);
+            else
+                env->ExceptionClear();
+            env->DeleteLocalRef(activityClass);
+            env->DeleteLocalRef(activity);
+            return found;
+        }
+#endif
