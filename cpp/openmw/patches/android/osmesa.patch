+            Log(Debug::Error) << "Zink: OSMesaCreateContextAttribs failed";
+            return;
+        }
+        mZinkBuffer = static_cast<unsigned char*>(std::calloc(static_cast<size_t>(mZinkWidth) * mZinkHeight, 4));
+        if (!makeCurrentZink())
+        {
+            Log(Debug::Error) << "Zink: OSMesaMakeCurrent failed";
+            return;
+        }
+
+        const int version = gladLoadGLES2(reinterpret_cast<GLADloadfunc>(api.getProcAddress));
+        if (!version)
+            Log(Debug::Error) << "Failed to initialize GLAD";
+        Log(Debug::Info) << "Zink: OSMesa context " << mZinkWidth << "x" << mZinkHeight;
+
+        api.makeCurrent(nullptr, nullptr, 0, 0, 0);
+
+        _traits->red = 8;
+        _traits->green = 8;
+        _traits->blue = 8;
+        _traits->alpha = 8;
+        _traits->depth = 24;
+        _traits->stencil = stencilBits;
+        _traits->doubleBuffer = true;
+        _traits->sampleBuffers = 0;
+        _traits->samples = 0;
+
+        mValid = true;
+        getEventQueue()->syncWindowRectangleWithGraphicsContext();
+#endif
+    }
