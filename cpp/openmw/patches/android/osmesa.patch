+    void GraphicsWindowSDL2::initZink()
+    {
+#ifdef ANDROID
+        auto& api = osmesa();
+        if (!api.load())
+            return;
+
+        // Dev hook: adb shell setprop debug.alpha3.zinkenv "ZINK_DESCRIPTORS=db;ZINK_DEBUG=nogpl" (Mesa cannot read these
+        // from Android properties inside an app, so apply them as environment variables before Zink starts).
+        {
+            char envList[PROP_VALUE_MAX] = "";
+            if (__system_property_get("debug.alpha3.zinkenv", envList) > 0)
+            {
+                std::string list(envList);
+                std::size_t start = 0;
+                while (start < list.size())
+                {
+                    std::size_t end = list.find(';', start);
+                    if (end == std::string::npos)
+                        end = list.size();
+                    const std::string item = list.substr(start, end - start);
+                    const std::size_t eq = item.find('=');
+                    if (eq != std::string::npos && eq > 0)
+                    {
+                        setenv(item.substr(0, eq).c_str(), item.c_str() + eq + 1, 1);
+                        Log(Debug::Info) << "Zink env: " << item;
+                    }
+                    start = end + 1;
+                }
+            }
+        }
+
+        SDL_SysWMinfo info;
+        SDL_VERSION(&info.version);
+        if (!SDL_GetWindowWMInfo(mWindow, &info) || info.subsystem != SDL_SYSWM_ANDROID)
+        {
+            Log(Debug::Error) << "Zink: no Android native window: " << SDL_GetError();
+            return;
+        }
+        mZinkNativeWindow = info.info.android.window;
+
+        SDL_GL_GetDrawableSize(mWindow, &mZinkWidth, &mZinkHeight);
+        ANativeWindow_setBuffersGeometry(
+            static_cast<ANativeWindow*>(mZinkNativeWindow), mZinkWidth, mZinkHeight, WINDOW_FORMAT_RGBA_8888);
+
+        // Dev probe: adb shell setprop debug.alpha3.zink_stencil 0 asks for a depth buffer without stencil
+        char stencilProp[PROP_VALUE_MAX] = "";
+        const int stencilBits = (__system_property_get("debug.alpha3.zink_stencil", stencilProp) > 0 && stencilProp[0] == '0') ? 0 : 8;
+        const int attribs[] = { OSMESA_FORMAT, OSMESA_RGBA, OSMESA_DEPTH_BITS, 24, OSMESA_STENCIL_BITS, stencilBits,
+            OSMESA_PROFILE, OSMESA_COMPAT_PROFILE, OSMESA_CONTEXT_MAJOR_VERSION, 4, OSMESA_CONTEXT_MINOR_VERSION, 5,
+            0 };
+        mZinkContext = api.createContextAttribs(attribs, nullptr);
+        if (!mZinkContext)
