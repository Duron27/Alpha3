+    bool GraphicsWindowSDL2::makeCurrentZink()
+    {
+#ifdef ANDROID
+        auto& api = osmesa();
+        if (!api.makeCurrent(mZinkContext, mZinkBuffer, GL_UNSIGNED_BYTE_ENUM, mZinkWidth, mZinkHeight))
+            return false;
+        api.pixelStore(OSMESA_Y_UP, 0); // rows top to bottom, like the ANativeWindow
+        return true;
+#else
+        return false;
+#endif
+    }
