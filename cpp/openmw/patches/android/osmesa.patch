+namespace
+{
+    // OSG calls GL through glad's function pointers (the osg glad patch). The Vulkan renderer has no GL context and never
+    // loads glad, so the pointers would be NULL: load the core ones from the system GLES library, where calls without a
+    // context are harmless (what OSG did before it went through glad).
+    GLADapiproc loadSystemGles(const char* name)
+    {
+        static void* lib = dlopen("libGLESv3.so", RTLD_NOW);
+        return lib != nullptr ? reinterpret_cast<GLADapiproc>(dlsym(lib, name)) : nullptr;
+    }
+
+    void loadGladWithoutContext()
+    {
+        static bool done = false;
+        if (!done)
+        {
+            done = true;
+            gladLoadGLES2(loadSystemGles);
+        }
+    }
+}
+#endif
