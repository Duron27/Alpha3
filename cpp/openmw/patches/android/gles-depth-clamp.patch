+// Without GL_DEPTH_CLAMP (OpenGL ES, and Zink as built here) a triangle past the near or far plane is cut away, so the huge
+// water surface loses whole pieces and shadow casters in front of the shadow camera cast nothing. Moving the vertex depth
+// onto the plane keeps them drawn. Vertices behind the eye are left alone, their depth is what the clipping of the part
+// in front interpolates from.
+#if __VERSION__ < 450
+#define osg_ClampDepth(position) if (position.w > 0.0) position.z = clamp(position.z, -position.w, position.w)
+#else
+#define osg_ClampDepth(position)
+#endif
 // clockwork profile end
 #endif
