+// Android has a single SDL window, so unlike the general path above (which creates the new window first and keeps the old
+// one until it works) the old renderer goes first. If the new one cannot start, the old one is created again.
+void OMW::Engine::switchRendererSerial(const RendererSwitch& target, bool recovering)
+{
+    MWRender::RenderingManager* const rendering = mWorld->getRenderingManager();
+    rendering->getCaptureManager().stopTrace();
+    if (mScreenCaptureOperation != nullptr)
+        mScreenCaptureOperation->stop();
+    mViewer->stopThreading();
+#ifdef OPENMW_USE_VULKAN
+    if (mClockwork != nullptr)
+        mClockwork->quiesce();
+#endif
+    mWorkQueue->waitIdle();
+
+    const int oldDevice = Settings::video().mVulkanDevice;
+    const int oldSamples = Settings::video().mAntialiasing;
+    const RendererRequest oldRequest = mRendererRequest;
+    const Settings::RendererStatus oldStatus = Settings::readRendererStatus(mCfgMgr.getLogPath() / "renderer.status");
+    const Settings::RendererEntry oldEntry = mRendererEntry;
+    const double oldReferenceTime = mViewer->getFrameStamp()->getReferenceTime();
+    const int statsLevel = mProfiler == nullptr ? 0 : mProfiler->level();
+    const int statsDetail = mProfiler == nullptr ? 0 : mProfiler->detail();
+    const std::size_t statsPage = mResourceStats == nullptr ? 0 : mResourceStats->page();
+    Log(Debug::Info) << "Switching renderer from " << Settings::rendererEntryName(oldEntry) << " to "
+                     << Settings::rendererEntryName(target.mEntry);
+
+    // The old renderer: its GL objects, its context, its window.
+    auto tearDown = [&]() {
+#ifdef OPENMW_USE_VULKAN
+        if (mClockwork != nullptr)
+        {
+            if (rendering->getGpuScene() != nullptr)
+            {
+                try
+                {
+                    rendering->getGpuScene()->setEnabled(false);
+                }
+                catch (const std::exception& error)
+                {
+                    Log(Debug::Warning) << "Renderer switch: " << error.what();
+                }
+            }
+            rendering->detachClockwork();
+            mClockwork->stop();
+            mClockwork.reset();
+        }
+#endif
+        osg::ref_ptr<osg::GraphicsContext> context = mViewer->getCamera()->getGraphicsContext();
+        if (context != nullptr)
+        {
+            context->makeCurrent();
+            rendering->releaseContext(context->getState());
+            mViewer->getSceneData()->releaseGLObjects(context->getState());
+            osgViewer::Viewer::Cameras cameras;
+            mViewer->getCameras(cameras);
+            for (osg::Camera* camera : cameras)
+                camera->releaseGLObjects(context->getState());
+        }
+        dropStats();
+        if (context != nullptr)
+            osg::flushAllDeletedGLObjects(context->getState()->getContextID());
+        rendering->detachClockwork();
+        if (context != nullptr)
+        {
+            context->releaseContext();
+            SceneUtil::closeContext(*context);
+        }
+        context = nullptr;
+        mViewer->getCamera()->setGraphicsContext(nullptr);
+        if (mWindow != nullptr)
+        {
+            SDL_DestroyWindow(mWindow);
+            mWindow = nullptr;
+        }
+    };
+
+    // Whatever a failed attempt left half-built.
+    auto discard = [&]() {
+#ifdef OPENMW_USE_VULKAN
+        if (mClockwork != nullptr)
+        {
+            mClockwork->stop();
+            mClockwork.reset();
+        }
+#endif
+        osg::ref_ptr<osg::GraphicsContext> context = mViewer->getCamera()->getGraphicsContext();
+        if (context != nullptr)
+            SceneUtil::closeContext(*context);
+        context = nullptr;
+        mViewer->getCamera()->setGraphicsContext(nullptr);
+        if (mWindow != nullptr)
+        {
+            SDL_DestroyWindow(mWindow);
+            mWindow = nullptr;
+        }
+    };
+
+    auto create = [&](Settings::RendererEntry entry, int device) {
+        mWindow = nullptr;
+        mRendererRequest.mEntry = entry;
+        mRendererSwitches.open(RendererSwitch{ entry, device });
+        mRendererStatus = {};
+        Diagnostics::runtime().mRendererReason.clear();
+        Diagnostics::runtime().mFallbackChain.clear();
+        mViewer->setDone(false);
+        try
+        {
+            createWindow(true);
+        }
+        catch (const std::exception& error)
+        {
+            Diagnostics::runtime().mRendererReason = error.what();
+        }
+        mViewer->setReferenceTime(oldReferenceTime);
+        mViewer->stopThreading();
+        if (mRendererStatus.mActual.starts_with("opengl"))
+        {
+            mRendererEntry = Settings::readRendererEntry(mRendererStatus.mActual);
+            Diagnostics::runtime().mRendererEntry = "opengl";
+        }
+        const bool hasOutput = Settings::isOpenGLFamily(entry) ? mWindow != nullptr
+#ifdef OPENMW_USE_VULKAN
+                                                               : mClockwork != nullptr;
+#else
+                                                               : false;
+#endif
+        return hasOutput && mRendererStatus.mActual == Settings::rendererEntryName(entry);
+    };
+
+    tearDown();
+    RendererSwitch active = target;
+    std::string failure;
+    if (!create(target.mEntry, target.mDevice))
+    {
+        failure = Diagnostics::runtime().mRendererReason;
+        Log(Debug::Warning) << "Renderer switch to " << Settings::rendererEntryName(target.mEntry)
+                            << " failed: " << failure << ". Going back to " << Settings::rendererEntryName(oldEntry);
+        discard();
+        Settings::video().mAntialiasing.set(oldSamples);
+        mRendererRequest = oldRequest;
+        active = RendererSwitch{ oldEntry, oldDevice };
+        if (!create(oldEntry, oldDevice))
+        {
+            Log(Debug::Error) << "Renderer switch: the previous renderer cannot be restored either: "
+                              << Diagnostics::runtime().mRendererReason;
+            discard();
+            mStateManager->requestQuit();
+            return;
+        }
+    }
+
+    if (Settings::isOpenGLFamily(active.mEntry))
+    {
+        mRendererEntry = active.mEntry;
+        Diagnostics::runtime().mRendererEntry = "opengl";
+    }
+    osg::ref_ptr<osg::GraphicsContext> newContext
+        = Settings::isOpenGLFamily(active.mEntry) ? mViewer->getCamera()->getGraphicsContext() : nullptr;
+    mViewer->getCamera()->setGraphicsContext(newContext);
+    if (newContext != nullptr)
+        newContext->makeCurrent();
+    else
+        mViewer->setDone(false);
+
+    mWindowManager->setWindow(mWindow);
+    mInputManager->setWindow(mWindow);
+    if (mWindow != nullptr)
+    {
+        Uint32 fullscreen = 0;
+        const Settings::WindowMode windowMode = Settings::video().mWindowMode;
+        if (windowMode == Settings::WindowMode::Fullscreen)
+            fullscreen = SDL_WINDOW_FULLSCREEN;
+        else if (windowMode == Settings::WindowMode::WindowedFullscreen)
+            fullscreen = SDL_WINDOW_FULLSCREEN_DESKTOP;
+        if (SDL_SetWindowFullscreen(mWindow, fullscreen) != 0)
+            Log(Debug::Error) << "Failed to restore fullscreen: " << SDL_GetError();
+        SDL_ShowWindow(mWindow);
+    }
+
+    mResourceSystem->getSceneManager()->getShaderManager().setMaxTextureUnits(mGlMaxTextureImageUnits);
+    resetStats(Settings::isOpenGLFamily(active.mEntry), statsLevel, statsDetail, statsPage);
+    if (newContext != nullptr)
+        newContext->releaseContext();
+#ifdef OPENMW_USE_VULKAN
+    rendering->setClockwork(mClockwork.get());
+    if (mClockwork != nullptr)
+        mClockwork->setStats(mProfiler.get(), mResourceStats.get(), &rendering->getCaptureManager().blackBox());
+#endif
+    if (Settings::isOpenGLFamily(active.mEntry))
+        rendering->refreshRenderer();
+    mViewer->startThreading();
+    mRendererSwitches.restore();
+
+    if (!failure.empty())
+    {
+        Diagnostics::runtime().mRendererReason = failure;
+        Settings::video().mAntialiasing.set(oldSamples);
+        Settings::Manager::resetPendingChanges(
+            { { "Video", "renderer" }, { "Video", "vulkan device" }, { "Video", "antialiasing" } });
+        Settings::writeRendererStatus(mCfgMgr.getLogPath() / "renderer.status", oldStatus);
+        if (!recovering)
+            mWindowManager->rendererReady();
+        else if (!mRendererSwitches.stepDown())
+            mStateManager->requestQuit();
+        return;
+    }
+
+    // What the objects were built for (GL programs, or the Vulkan GPU scene's materials) does not carry over from one
+    // family to the other: build the cells around the player again.
+    if (Settings::isOpenGLFamily(oldEntry) != Settings::isOpenGLFamily(active.mEntry))
+        reloadActiveCells();
+
+    mRendererSwitches.leave(oldEntry);
+    if (std::string reason = mRendererSwitches.present(target); !reason.empty())
+        Diagnostics::runtime().mRendererReason = std::move(reason);
+}
+
+void OMW::Engine::reloadActiveCells()
+{
+    if (mStateManager->getState() != MWState::StateManager::State_Running)
+        return;
+    const MWWorld::Ptr player = mWorld->getPlayerPtr();
+    const MWWorld::CellStore* const cell = player.isEmpty() ? nullptr : player.getCell();
+    if (cell == nullptr)
+        return;
+    Log(Debug::Info) << "Building the active cells again for the new renderer";
+    const ESM::Position position = player.getRefData().getPosition();
+    Loading::Listener* const listener = mWindowManager->getLoadingScreen();
+    listener->loadingOn();
+    MWWorld::Scene& scene = mWorld->getWorldScene();
+    scene.clear();
+    if (cell->isExterior())
+        scene.changeToExteriorCell(cell->getCell()->getId(), position, false, false);
+    else
+        scene.changeToInteriorCell(cell->getCell()->getNameId(), position, false, false);
+    listener->loadingOff();
+}
