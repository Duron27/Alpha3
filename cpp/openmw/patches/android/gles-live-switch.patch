+            SDL_GetWindowSize(mWindow, &w, &h);
+            drawableSize(mWindow, dw, dh);
+        }
+        // the size just chosen, not what the window reports until the surface has been resized
+        mScalingFactor = effectiveScalingFactor(factor, Settings::video().mResolutionX, Settings::video().mResolutionY)
+            * (w > 0 ? dw / w : 1);
+        mGuiPlatform->getRenderManagerPtr()->setUiScalingFactor(mScalingFactor);
