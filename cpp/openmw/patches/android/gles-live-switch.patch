+    void WindowManager::setGuiScalingFactor(float factor)
+    {
+        // The same relation as at start-up: the setting times the ratio of drawable pixels to window units.
+        int w = Settings::video().mResolutionX;
+        int h = Settings::video().mResolutionY;
+        int dw = w;
