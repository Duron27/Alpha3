+    osg::ref_ptr<osg::Shader> ShaderManager::getMergedShader(
+        const osg::ref_ptr<osg::Shader>& shader, const std::vector<osg::ref_ptr<osg::Shader>>& extras)
+    {
+        std::vector<const osg::Shader*> extraKey;
+        for (const osg::ref_ptr<osg::Shader>& extra : extras)
+            extraKey.push_back(extra.get());
+        const auto key = std::make_pair(shader.get(), extraKey);
+        const auto cached = mMergedShaders.find(key);
+        if (cached != mMergedShaders.end())
+            return cached->second;
+
+        std::string source = shader->getShaderSource();
+        std::set<const osg::Shader*> seen{ shader.get() };
+        int moduleNumber = 0;
+        // Modules link modules: take the whole tree, each module once.
+        const auto append = [&](const auto& self, const osg::ref_ptr<osg::Shader>& from) -> void {
+            const auto linkedIt = mLinkedShaders.find(from);
+            if (linkedIt == mLinkedShaders.end())
+                return;
+            for (const osg::ref_ptr<osg::Shader>& module : linkedIt->second)
+            {
+                if (!seen.insert(module.get()).second)
+                    continue;
+                appendModule(source, module->getShaderSource(), ++moduleNumber);
+                self(self, module);
+            }
+        };
+        append(append, shader);
+        for (const osg::ref_ptr<osg::Shader>& extra : extras)
+        {
+            if (!seen.insert(extra.get()).second)
+                continue;
+            appendModule(source, extra->getShaderSource(), ++moduleNumber);
+            append(append, extra);
+        }
+
+        osg::ref_ptr<osg::Shader> merged(new osg::Shader(shader->getType()));
+        merged->setShaderSource(source);
+        merged->setName(shader->getName() + " (merged)");
+        // Instanced twins are found through the template key of the shader a program holds.
+        if (const auto keyIt = mShaderKeys.find(shader.get()); keyIt != mShaderKeys.end())
+            mShaderKeys.emplace(merged.get(), keyIt->second);
+#ifdef ANDROID
+        // Dev probe: adb shell setprop debug.alpha3.shaderdump 1 writes what the driver is given to /sdcard/Alpha3/shaderdump
+        char dumpProp[PROP_VALUE_MAX] = "";
+        if (__system_property_get("debug.alpha3.shaderdump", dumpProp) > 0 && dumpProp[0] == '1')
+        {
+            std::string name = merged->getName();
+            for (char& c : name)
+                if (c == '/' || c == ' ' || c == '(' || c == ')')
+                    c = '_';
+            std::ofstream("/sdcard/Alpha3/shaderdump/" + name + (shader->getType() == osg::Shader::VERTEX ? ".vert" : ".frag"))
+                << source;
+        }
+#endif
+        mMergedShaders.emplace(key, merged);
+        return merged;
+    }
