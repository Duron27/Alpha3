diff --git a/components/shader/shadermanager.cpp b/components/shader/shadermanager.cpp
index d62b710994..00e2b5b572 100644
--- a/components/shader/shadermanager.cpp
+++ b/components/shader/shadermanager.cpp
@@ -2006,6 +2006,14 @@ namespace Shader
             append(append, extra);
         }
 
+        // Clip planes in OpenGL ES vertex shaders need their extension, which has to come before anything else; it is only
+        // asked for when the context has it (a driver that lacks it, such as ANGLE's, refuses the line's users).
+        if (shader->getType() == osg::Shader::VERTEX)
+            if (const auto clip = mGlobalDefines.find("clipDistance"); clip != mGlobalDefines.end() && clip->second == "1")
+                if (const std::size_t lineEnd = source.find('\n'); lineEnd != std::string::npos
+                    && source.compare(0, 8, "#version") == 0)
+                    source.insert(lineEnd + 1, "#extension GL_EXT_clip_cull_distance : enable\n#define OPENMW_CLIP_DISTANCE 1\n");
+
         osg::ref_ptr<osg::Shader> merged(new osg::Shader(shader->getType()));
         merged->setShaderSource(source);
         merged->setName(shader->getName() + " (merged)");
