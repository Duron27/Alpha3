+#if defined(__APPLE__) && TARGET_OS_IPHONE
+        // OpenGL ES cannot link multiple shader objects of the same stage into
+        // one program, so inline the $link'ed library shaders into the main
+        // source instead of attaching them as separate compilation units.
+        std::set<std::string> inlinedTemplates{ templateName };
+        for (size_t i = 0; i < linkedShaderTemplateNames.size(); ++i)
+        {
+            std::string linkedName = linkedShaderTemplateNames[i];
+            if (getRootPrefix(linkedName).empty())
+                linkedName = "compatibility/" + linkedName;
+            if (!inlinedTemplates.insert(linkedName).second)
+                continue;
+
+            TemplateMap::iterator templateIt = mShaderTemplates.find(linkedName);
+            if (templateIt == mShaderTemplates.end())
+            {
+                std::filesystem::path path = mPath / linkedName;
+                std::ifstream stream;
+                stream.open(path);
+                if (stream.fail())
+                {
+                    Log(Debug::Error) << "Failed to open linked shader " << path;
+                    return false;
+                }
+                std::stringstream buffer;
+                buffer << stream.rdbuf();
+                std::string linkedTemplate = buffer.str();
+                int fileNumber = 1;
+                std::set<std::filesystem::path> insertedPaths;
+                if (!addLineDirectivesAfterConditionalBlocks(linkedTemplate)
+                    || !parseIncludes(mPath, linkedTemplate, linkedName, fileNumber, {}, insertedPaths))
+                    return false;
+                templateIt = mShaderTemplates.insert(std::make_pair(linkedName, std::move(linkedTemplate))).first;
+            }
+
+            std::string linkedSource = templateIt->second;
+            std::vector<std::string> nestedLinks;
+            if (!expandTemplate(linkedSource, nestedLinks, linkedName, defines, mGlobalDefines))
+                return false;
+            for (auto& nested : nestedLinks)
+                linkedShaderTemplateNames.push_back(std::move(nested));
+
+            // The combined source keeps the main shader's #version directive.
+            size_t versionPos = linkedSource.find("#version");
+            if (versionPos != std::string::npos)
+                linkedSource.replace(versionPos, 1, "//");
+            source += "\n";
+            source += linkedSource;
+        }
+        linkedShaderTemplateNames.clear();
+#endif
+        return true;
     }
 
