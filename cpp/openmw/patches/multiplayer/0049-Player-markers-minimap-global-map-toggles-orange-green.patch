+        // Who is on the map, in which cell and in which colour. While that is unchanged only positions moved, and
+        // rebuilding every marker widget each time the list is refreshed makes the markers flicker and vanish.
+        auto describe = [](const TransientContainerType& markers) {
+            std::map<std::string, std::tuple<ESM::RefId, bool, bool>> result;
+            for (const auto& [cell, player] : markers)
+                result.emplace(player.mMarker.mNote, std::make_tuple(cell, player.mGroup, player.mExterior));
+            return result;
+        };
+        const bool sameSet = next.size() == mTransient.size() && describe(next) == describe(mTransient);
+        bool moved = false;
+        if (sameSet)
+        {
+            for (const auto& [cell, player] : next)
+            {
+                const PlayerMarker* before = findTransient(player.mMarker.mNote);
+                if (!before || before->mMarker.mWorldX != player.mMarker.mWorldX
+                    || before->mMarker.mWorldY != player.mMarker.mWorldY)
+                {
+                    moved = true;
+                    break;
+                }
+            }
+        }
+
+        mTransient = std::move(next);
+        if (!sameSet)
+            eventMarkersChanged();
+        else if (moved)
+            eventTransientMoved();
     }
 
