From 5a7a272807f5b271c7f02029ad318b051fc3707a Mon Sep 17 00:00:00 2001
From: Duron27 <duron27@gmail.com>
Date: Thu, 15 Oct 2026 08:31:52 -0400
Subject: [PATCH] Client package: official-style layout, bundled runtime,
 container build on an older glibc baseline

Wrapper scripts next to <name>.x86_64 programs, RPATH $ORIGIN/lib on programs and bundled
libraries, qt.conf, preflight check and diagnose.sh. multiplayer/container builds the whole
tree on Ubuntu 24.04 (static OSG/MyGUI/Bullet, own SDL2) so the zips run on other distributions.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 multiplayer/README.md                         |  12 +-
 multiplayer/container/Dockerfile              |  32 ++++
 multiplayer/container/build-client-package.sh |  36 ++++
 multiplayer/package-client.py                 | 174 ++++++++++++++----
 4 files changed, 219 insertions(+), 35 deletions(-)
 create mode 100644 multiplayer/container/Dockerfile
 create mode 100755 multiplayer/container/build-client-package.sh

diff --git a/multiplayer/README.md b/multiplayer/README.md
index 37546f9e28..d02193dba1 100644
--- a/multiplayer/README.md
+++ b/multiplayer/README.md
@@ -50,8 +50,16 @@ built (the game, launcher, wizard, OpenMW-CS and the tools), their resources wit
   install.
 - `...-light.zip`: without the libraries (about 40 MB); its README lists the packages to install.
 
-Linux only for now. The programs need a C library as new as the one that built them, whatever is bundled (the README in the
-zips gives the version), so they only run on a similarly recent distribution. The script behind it is `multiplayer/package-client.py`
+Linux only for now. A package built straight from your own build tree needs a C library as new as yours, so for something
+you hand to others on different distributions, build it in the container instead:
+
+    multiplayer/container/build-client-package.sh [source-dir] [output-dir]
+
+This builds everything (static OpenSceneGraph/MyGUI/Bullet, own SDL2, as upstream's CI does) on Ubuntu 24.04 in Docker and
+packages it there. The result needs glibc 2.38 or newer (Ubuntu 24.04+, Debian 13+, Fedora 40+, current Arch and so on) and
+carries its own libstdc++, Qt, FFmpeg, OpenAL, SDL2 and the rest. From the system it expects only what any graphical desktop
+has: the GPU driver's OpenGL/EGL, X11 or Wayland, libxkbcommon, D-Bus. Tested on clean Ubuntu 24.04, Debian 13 and Fedora 44.
+Older distributions (Ubuntu 22.04, Debian 12) are not covered. The script behind it is `multiplayer/package-client.py`
 (`python3 multiplayer/package-client.py --build-dir <build>` does the same by hand). A dedicated server is a separate zip:
 `--target mpserver-bundle`.
 
diff --git a/multiplayer/container/Dockerfile b/multiplayer/container/Dockerfile
new file mode 100644
index 0000000000..bc20abfd99
--- /dev/null
+++ b/multiplayer/container/Dockerfile
@@ -0,0 +1,32 @@
+# Build environment for the shareable client package.
+# Ubuntu 24.04 (glibc 2.39) is the baseline: binaries built here run on any
+# Linux distribution with glibc >= 2.39 (Ubuntu 24.04+, Debian 13+, Fedora 40+,
+# Arch, openSUSE Tumbleweed, ...). Dependencies follow upstream CI.
+FROM ubuntu:24.04
+ENV DEBIAN_FRONTEND=noninteractive
+RUN apt-get update && apt-get install -y --no-install-recommends \
+    binutils gcc g++ build-essential cmake ninja-build ccache curl unzip git \
+    pkg-config patchelf python3 ca-certificates file xz-utils \
+    libboost-program-options-dev libboost-system-dev libboost-iostreams-dev \
+    libboost-filesystem-dev \
+    libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libswresample-dev \
+    libsdl2-dev libqt6opengl6-dev qt6-tools-dev qt6-tools-dev-tools \
+    qt6-l10n-tools libqt6svg6 libqt6svg6-dev qt6-qpa-plugins \
+    libopenal-dev libunshield-dev libtinyxml-dev liblz4-dev libpng-dev \
+    libjpeg-dev libicu-dev libyaml-cpp-dev librecast-dev libsqlite3-dev \
+    libcollada-dom-dev libfreetype6-dev libgl-dev libvulkan-dev \
+    libx11-dev libxrandr-dev libxi-dev libxext-dev libxcursor-dev \
+    libwayland-dev wayland-protocols libxkbcommon-dev libasound2-dev libpulse-dev \
+    libdecor-0-dev libsndio-dev libdbus-1-dev libudev-dev libxss-dev libxfixes-dev \
+    libxinerama-dev libxcb1-dev libegl-dev libgbm-dev libdrm-dev libpipewire-0.3-dev \
+    && rm -rf /var/lib/apt/lists/*
+
+# SDL2 of our own: the distribution's links audio/window-system libraries directly
+# (libsndio, libdecor, libXss, ...), so a fresh install without them could not start.
+# Built from source, SDL loads them only when it needs them, as upstream's package does.
+RUN curl -fsSL https://github.com/libsdl-org/SDL/releases/download/release-2.32.8/SDL2-2.32.8.tar.gz | tar xz -C /tmp \
+    && cmake -S /tmp/SDL2-2.32.8 -B /tmp/sdl-build -G Ninja -DCMAKE_BUILD_TYPE=Release \
+       -DCMAKE_INSTALL_PREFIX=/opt/sdl2 -DSDL_STATIC=OFF -DSDL_TEST=OFF \
+    && cmake --build /tmp/sdl-build && cmake --install /tmp/sdl-build && rm -rf /tmp/SDL2-2.32.8 /tmp/sdl-build
+ENV PKG_CONFIG_PATH=/opt/sdl2/lib/pkgconfig SDL2DIR=/opt/sdl2
+WORKDIR /build
