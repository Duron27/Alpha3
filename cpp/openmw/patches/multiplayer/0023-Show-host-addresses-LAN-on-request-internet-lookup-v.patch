diff --git a/components/net/address.cpp b/components/net/address.cpp
new file mode 100644
index 0000000000..821e6b4afe
--- /dev/null
+++ b/components/net/address.cpp
@@ -0,0 +1,119 @@
+#include "address.hpp"
+
+#include <algorithm>
+#include <chrono>
+
+#include <boost/asio.hpp>
+
+namespace Net
+{
+    namespace asio = boost::asio;
+    using asio::ip::tcp;
+    using asio::ip::udp;
+
+    std::string localAddress()
+    {
+        try
+        {
+            asio::io_context io;
+            udp::socket socket(io);
+            // Connecting a UDP socket sends nothing; it only makes the OS pick the outgoing interface.
+            socket.connect(udp::endpoint(asio::ip::make_address("8.8.8.8"), 80));
+            return socket.local_endpoint().address().to_string();
+        }
+        catch (const std::exception&)
+        {
+            return {};
+        }
+    }
+
+    namespace
+    {
+        PublicAddressLookup::Result fetch()
+        {
+            using namespace std::chrono_literals;
+            try
+            {
+                asio::io_context io;
+                tcp::resolver resolver(io);
+                tcp::socket socket(io);
+                asio::steady_timer deadline(io, 8s);
+                deadline.async_wait([&socket](const boost::system::error_code& ec) {
+                    if (!ec)
+                    {
+                        boost::system::error_code ignored;
+                        socket.close(ignored);
+                    }
+                });
+                boost::system::error_code ec;
+                const auto endpoints = resolver.resolve("api.ipify.org", "80", ec);
+                if (ec)
+                    return { {}, "could not resolve api.ipify.org: " + ec.message() };
+                asio::connect(socket, endpoints, ec);
+                if (ec)
+                    return { {}, "could not connect: " + ec.message() };
+                const std::string request = "GET / HTTP/1.1\r\nHost: api.ipify.org\r\nConnection: close\r\n"
+                                            "User-Agent: openmw-multiplayer\r\n\r\n";
+                asio::write(socket, asio::buffer(request), ec);
+                if (ec)
+                    return { {}, "request failed: " + ec.message() };
+                std::string response;
+                asio::read(socket, asio::dynamic_buffer(response, 16384), ec); // until the server closes
+                deadline.cancel();
+                const std::size_t bodyStart = response.find("\r\n\r\n");
+                if (response.compare(0, 12, "HTTP/1.1 200") != 0 || bodyStart == std::string::npos)
+                    return { {}, "unexpected reply" };
+                std::string body = response.substr(bodyStart + 4);
+                body.erase(std::remove_if(body.begin(), body.end(), [](unsigned char c) { return c <= ' '; }), body.end());
+                // a bare address: digits, dots, colons and hex letters
+                if (body.empty() || body.size() > 45
+                    || !std::all_of(body.begin(), body.end(), [](unsigned char c) { return std::isxdigit(c) || c == '.' || c == ':'; }))
+                    return { {}, "unexpected reply" };
+                return { std::move(body), {} };
+            }
+            catch (const std::exception& e)
+            {
+                return { {}, e.what() };
+            }
+        }
+    }
+
+    PublicAddressLookup::~PublicAddressLookup()
+    {
+        if (mThread.joinable())
+            mThread.join(); // bounded by the 8 second deadline
+    }
+
+    void PublicAddressLookup::start()
+    {
+        {
+            const std::lock_guard lock(mMutex);
+            if (mRunning)
+                return;
+            mRunning = true;
+            mResult.reset();
+        }
+        if (mThread.joinable())
+            mThread.join();
+        mThread = std::thread([this] {
+            Result result = fetch();
+            const std::lock_guard lock(mMutex);
+            mResult = std::move(result);
+            mRunning = false;
+        });
+    }
+
+    bool PublicAddressLookup::isRunning() const
+    {
+        const std::lock_guard lock(mMutex);
+        return mRunning;
+    }
+
+    std::optional<PublicAddressLookup::Result> PublicAddressLookup::poll()
+    {
+        const std::lock_guard lock(mMutex);
+        std::optional<Result> result;
+        result.swap(mResult);
+        return result;
+    }
+}
diff --git a/components/net/address.hpp b/components/net/address.hpp
new file mode 100644
index 0000000000..7acc13109d
--- /dev/null
+++ b/components/net/address.hpp
@@ -0,0 +1,45 @@
+#ifndef OPENMW_COMPONENTS_NET_ADDRESS_H
+#define OPENMW_COMPONENTS_NET_ADDRESS_H
+
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <thread>
+
+namespace Net
+{
+    // The address of this machine on the network used to reach the internet (usually the LAN address).
+    // Nothing is sent; returns an empty string if there is no route.
+    std::string localAddress();
+
+    // Asks an external service (api.ipify.org, plain HTTP GET) for this machine's public address.
+    // Runs on a background thread; check with poll().
+    class PublicAddressLookup
+    {
+    public:
+        struct Result
+        {
+            std::string mAddress; // empty on failure
+            std::string mError;
+        };
+
+        PublicAddressLookup() = default;
+        ~PublicAddressLookup();
+        PublicAddressLookup(const PublicAddressLookup&) = delete;
+        PublicAddressLookup& operator=(const PublicAddressLookup&) = delete;
+
+        void start();
+        bool isRunning() const;
+        // Returns the result once, after the lookup finished.
+        std::optional<Result> poll();
+
+    private:
+        mutable std::mutex mMutex;
+        std::thread mThread;
+        bool mRunning = false;
+        std::optional<Result> mResult;
+    };
+}
+
+#endif
