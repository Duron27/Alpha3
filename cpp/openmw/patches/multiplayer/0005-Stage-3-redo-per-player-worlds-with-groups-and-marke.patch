+#!/usr/bin/env python3
+"""Fake group member for testing proxies with one game client.
+
+Joins GROUP, waits for the game's `state` (to learn its cell and position), then pretends to own
+a living actor (default: a scrib) that does not exist in the game's world, standing 200 units away.
+Prints damage reported against it. Optionally (--hurt NID) sends damage to one of the game's real actors.
+
+usage: owner_bot.py [host] [port] [group] [--rec scrib] [--hurt morrowind.esm:1234]
+"""
+import json
+import math
+import socket
+import sys
+import time
+
+args = [a for a in sys.argv[1:]]
+def opt(name, default=None):
+    if name in args:
+        i = args.index(name); v = args[i + 1]; del args[i:i + 2]; return v
+    return default
+rec = opt("--rec", "scrib")
+hurt = opt("--hurt")
+host = args[0] if len(args) > 0 else "127.0.0.1"
+port = int(args[1]) if len(args) > 1 else 25565
+group = args[2] if len(args) > 2 else "lobby"
+
+s = socket.create_connection((host, port))
+f = s.makefile("rwb", buffering=0)
+def send(m): f.write((json.dumps(m) + "\n").encode())
+
+send({"t": "profile", "name": "Bot", "race": "dark elf", "class": "acrobat",
+      "head": "b_n_dark elf_m_head_01", "hair": "b_n_dark elf_m_hair_01", "isMale": True})
+send({"t": "group", "name": group})
+me = None
+peer = None
+cell, pos = None, None
+hp = 1.0
+t0 = time.time()
+sent_hurt = False
+s.settimeout(0.2)
+buf = b""
+while True:
+    try:
+        d = s.recv(65536)
+        if not d: break
+        buf += d
+    except socket.timeout:
+        pass
+    while b"\n" in buf:
+        line, buf = buf.split(b"\n", 1)
+        m = json.loads(line)
+        if m["t"] == "hello": me = m["id"]
+        elif m["t"] == "state": cell, pos, peer = m["cell"], m["pos"], m["id"]
+        elif m["t"] == "dmg":
+            hp = max(0.0, hp - m["frac"]); print(f"damage {m['frac']:.2f} on {m['nid']} -> hp {hp:.2f}", flush=True)
+    if pos is not None:
+        a = time.time() - t0
+        mine = {"t": "state", "cell": cell, "pos": [pos[0] + 200, pos[1] + 200, pos[2]], "yaw": 0, "stance": 0}
+        send(mine)
+        if hp > 0:
+            lst = [{"n": "morrowind.esm:16777000", "r": rec, "h": hp,
+                    "p": [pos[0] + 200 + 80 * math.cos(a), pos[1] + 200 + 80 * math.sin(a), pos[2]], "y": 0}]
+            send({"t": "actors", "cell": cell, "list": lst, "dead": []})
+        else:
+            send({"t": "actors", "cell": cell, "list": [], "dead": ["morrowind.esm:16777000"]})
+        if hurt and not sent_hurt and a > 6:
+            send({"t": "dmg", "to": peer, "nid": hurt, "frac": 0.3}); sent_hurt = True
+    time.sleep(0.25)
