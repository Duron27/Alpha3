diff --git a/components/net/client.cpp b/components/net/client.cpp
new file mode 100644
index 0000000000..ba464b99f8
--- /dev/null
+++ b/components/net/client.cpp
@@ -0,0 +1,225 @@
+#include "client.hpp"
+
+#include <atomic>
+#include <deque>
+#include <mutex>
+#include <optional>
+#include <thread>
+
+#include <boost/asio.hpp>
+
+namespace Net
+{
+    namespace asio = boost::asio;
+    using asio::ip::tcp;
+
+    namespace
+    {
+        struct EventQueue
+        {
+            std::mutex mMutex;
+            std::vector<Event> mEvents;
+            std::atomic<bool> mConnected = false;
+
+            void push(Event::Type type, std::string data = {})
+            {
+                const std::lock_guard lock(mMutex);
+                mEvents.push_back({ type, std::move(data) });
+            }
+        };
+
+        // Lives on the io thread; all members except mQueue are touched only there.
+        class Session : public std::enable_shared_from_this<Session>
+        {
+        public:
+            Session(asio::io_context& io, std::shared_ptr<EventQueue> queue)
+                : mResolver(io)
+                , mSocket(io)
+                , mQueue(std::move(queue))
+            {
+            }
+
+            void start(const std::string& host, std::uint16_t port)
+            {
+                mResolver.async_resolve(host, std::to_string(port),
+                    [self = shared_from_this()](const boost::system::error_code& ec, tcp::resolver::results_type r) {
+                        if (ec)
+                            return self->fail(ec);
+                        asio::async_connect(self->mSocket, r,
+                            [self](const boost::system::error_code& connectEc, const tcp::endpoint&) {
+                                if (connectEc)
+                                    return self->fail(connectEc);
+                                boost::system::error_code ignored;
+                                self->mSocket.set_option(tcp::no_delay(true), ignored);
+                                self->mOpen = true;
+                                self->mQueue->mConnected = true;
+                                self->mQueue->push(Event::Type::Connected);
+                                self->read();
+                            });
+                    });
+            }
+
+            void write(std::string line)
+            {
+                if (!mOpen || mClosed)
+                    return;
+                line.push_back('\n');
+                const bool idle = mOut.empty();
+                mOut.push_back(std::move(line));
+                if (idle)
+                    doWrite();
+            }
+
+            void close()
+            {
+                mClosed = true;
+                boost::system::error_code ignored;
+                mResolver.cancel();
+                mSocket.close(ignored);
+            }
+
+        private:
+            void read()
+            {
+                asio::async_read_until(mSocket, asio::dynamic_buffer(mIn, Client::sMaxLineSize), '\n',
+                    [self = shared_from_this()](const boost::system::error_code& ec, std::size_t n) {
+                        if (ec)
+                            return self->fail(ec);
+                        std::size_t len = n - 1;
+                        if (len > 0 && self->mIn[len - 1] == '\r')
+                            --len;
+                        self->mQueue->push(Event::Type::Message, self->mIn.substr(0, len));
+                        self->mIn.erase(0, n);
+                        self->read();
+                    });
+            }
+
+            void doWrite()
+            {
+                asio::async_write(mSocket, asio::buffer(mOut.front()),
+                    [self = shared_from_this()](const boost::system::error_code& ec, std::size_t) {
+                        if (ec)
+                            return self->fail(ec);
+                        self->mOut.pop_front();
+                        if (!self->mOut.empty())
+                            self->doWrite();
+                    });
+            }
+
+            void fail(const boost::system::error_code& ec)
+            {
+                if (mClosed)
+                    return; // closed locally, nobody is listening
+                mClosed = true;
+                mOpen = false;
+                mQueue->mConnected = false;
+                mQueue->push(Event::Type::Disconnected, ec.message());
+                boost::system::error_code ignored;
+                mSocket.close(ignored);
+            }
+
+            tcp::resolver mResolver;
+            tcp::socket mSocket;
+            std::shared_ptr<EventQueue> mQueue;
+            std::string mIn;
+            std::deque<std::string> mOut;
+            bool mOpen = false;
+            bool mClosed = false;
+        };
+    }
+
+    class Client::Impl
+    {
+    public:
+        ~Impl()
+        {
+            if (mThread.joinable())
+            {
+                mWork.reset();
+                mIo.stop();
+                mThread.join();
+            }
+        }
+
+        void connect(const std::string& host, std::uint16_t port)
+        {
+            disconnect();
+            if (!mThread.joinable())
+            {
+                mWork.emplace(asio::make_work_guard(mIo));
+                mThread = std::thread([this] { mIo.run(); });
+            }
+            mQueue = std::make_shared<EventQueue>();
+            mSession = std::make_shared<Session>(mIo, mQueue);
+            asio::post(mIo, [s = mSession, host, port] { s->start(host, port); });
+        }
+
+        void disconnect()
+        {
+            if (mSession)
+                asio::post(mIo, [s = std::move(mSession)] { s->close(); });
+            mSession.reset();
+            mQueue.reset();
+        }
+
+        bool isConnected() const { return mQueue && mQueue->mConnected; }
+
+        bool send(std::string_view line)
+        {
+            if (!isConnected() || line.size() > sMaxLineSize || line.find_first_of("\r\n") != std::string_view::npos)
+                return false;
+            asio::post(mIo, [s = mSession, l = std::string(line)]() mutable { s->write(std::move(l)); });
+            return true;
+        }
+
+        std::vector<Event> poll()
+        {
+            std::vector<Event> result;
+            if (mQueue)
+            {
+                const std::lock_guard lock(mQueue->mMutex);
+                result.swap(mQueue->mEvents);
+            }
+            return result;
+        }
+
+    private:
+        asio::io_context mIo;
+        std::optional<asio::executor_work_guard<asio::io_context::executor_type>> mWork;
+        std::thread mThread;
+        std::shared_ptr<EventQueue> mQueue;
+        std::shared_ptr<Session> mSession;
+    };
+
+    Client::Client()
+        : mImpl(std::make_unique<Impl>())
+    {
+    }
+
+    Client::~Client() = default;
+
+    void Client::connect(const std::string& host, std::uint16_t port)
+    {
+        mImpl->connect(host, port);
+    }
+
+    void Client::disconnect()
+    {
+        mImpl->disconnect();
+    }
+
+    bool Client::isConnected() const
+    {
+        return mImpl->isConnected();
+    }
+
+    bool Client::send(std::string_view line)
+    {
+        return mImpl->send(line);
+    }
+
+    std::vector<Event> Client::poll()
+    {
+        return mImpl->poll();
+    }
+}
