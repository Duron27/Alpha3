new file mode 100644
index 0000000000..6408f8ea62
--- /dev/null
+++ b/components/net/client.hpp
@@ -0,0 +1,59 @@
+#ifndef OPENMW_COMPONENTS_NET_CLIENT_H
+#define OPENMW_COMPONENTS_NET_CLIENT_H
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace Net
+{
+    struct Event
+    {
+        enum class Type
+        {
+            Connected,
+            Disconnected, // mData holds the reason. Not emitted after a local disconnect().
+            Message, // mData holds one received line, without the line terminator.
+        };
+        Type mType;
+        std::string mData;
+    };
+
+    // Line-oriented TCP client. All socket work happens on a background thread;
+    // the owner drives it with non-blocking calls and collects results with poll().
+    // Not thread-safe: use from a single thread.
+    class Client
+    {
+    public:
+        static constexpr std::size_t sMaxLineSize = 1024 * 1024;
+
+        Client();
+        ~Client();
+        Client(const Client&) = delete;
+        Client& operator=(const Client&) = delete;
+
+        // Starts connecting asynchronously, dropping any existing connection.
+        // The outcome is reported by a Connected or Disconnected event.
+        void connect(const std::string& host, std::uint16_t port);
+
+        // Drops the connection and discards pending events.
+        void disconnect();
+
+        bool isConnected() const;
+
+        // Queues a message; a newline is appended. Returns false if not connected,
+        // if the message contains a line break, or if it exceeds sMaxLineSize.
+        bool send(std::string_view line);
+
+        // Returns and clears the events received since the last call.
+        std::vector<Event> poll();
+
+    private:
+        class Impl;
+        std::unique_ptr<Impl> mImpl;
+    };
+}
+
+#endif
