diff --git a/apps/components_tests/net/client.cpp b/apps/components_tests/net/client.cpp
new file mode 100644
index 0000000000..2bb9e43c37
--- /dev/null
+++ b/apps/components_tests/net/client.cpp
@@ -0,0 +1,111 @@
+#include <components/net/client.hpp>
+
+#include <chrono>
+#include <thread>
+
+#include <boost/asio.hpp>
+#include <gtest/gtest.h>
+
+namespace
+{
+    using namespace testing;
+    namespace asio = boost::asio;
+    using asio::ip::tcp;
+
+    std::vector<Net::Event> waitForEvents(Net::Client& client, std::size_t count)
+    {
+        std::vector<Net::Event> result;
+        for (int i = 0; i < 500 && result.size() < count; ++i)
+        {
+            for (Net::Event& e : client.poll())
+                result.push_back(std::move(e));
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        }
+        return result;
+    }
+
+    struct NetClientTest : Test
+    {
+        asio::io_context mIo;
+        tcp::acceptor mAcceptor{ mIo, tcp::endpoint(asio::ip::make_address("127.0.0.1"), 0) };
+        Net::Client mClient;
+
+        std::uint16_t port() const { return mAcceptor.local_endpoint().port(); }
+    };
+
+    TEST_F(NetClientTest, shouldExchangeLines)
+    {
+        std::thread server([this] {
+            tcp::socket socket(mIo);
+            mAcceptor.accept(socket);
+            asio::streambuf buf;
+            asio::read_until(socket, buf, '\n');
+            std::istream in(&buf);
+            std::string line;
+            std::getline(in, line);
+            asio::write(socket, asio::buffer("echo:" + line + "\r\nsecond\n"));
+            boost::system::error_code ec;
+            asio::read(socket, buf, ec); // wait for the client to go away
+        });
+
+        mClient.connect("127.0.0.1", port());
+        auto events = waitForEvents(mClient, 1);
+        ASSERT_EQ(events.size(), 1u);
+        EXPECT_EQ(events[0].mType, Net::Event::Type::Connected);
+        EXPECT_TRUE(mClient.isConnected());
+
+        EXPECT_TRUE(mClient.send("hello"));
+        events = waitForEvents(mClient, 2);
+        ASSERT_EQ(events.size(), 2u);
+        EXPECT_EQ(events[0].mType, Net::Event::Type::Message);
+        EXPECT_EQ(events[0].mData, "echo:hello");
+        EXPECT_EQ(events[1].mData, "second");
+
+        mClient.disconnect();
+        EXPECT_FALSE(mClient.isConnected());
+        server.join();
+    }
+
+    TEST_F(NetClientTest, shouldReportDisconnectFromServer)
+    {
+        std::thread server([this] {
+            tcp::socket socket(mIo);
+            mAcceptor.accept(socket);
+        });
+        mClient.connect("127.0.0.1", port());
+        const auto events = waitForEvents(mClient, 2);
+        server.join();
+        ASSERT_EQ(events.size(), 2u);
+        EXPECT_EQ(events[0].mType, Net::Event::Type::Connected);
+        EXPECT_EQ(events[1].mType, Net::Event::Type::Disconnected);
+        EXPECT_FALSE(mClient.isConnected());
+    }
+
+    TEST_F(NetClientTest, shouldReportConnectionFailure)
+    {
+        const std::uint16_t closedPort = port();
+        mAcceptor.close();
+        mClient.connect("127.0.0.1", closedPort);
+        const auto events = waitForEvents(mClient, 1);
+        ASSERT_EQ(events.size(), 1u);
+        EXPECT_EQ(events[0].mType, Net::Event::Type::Disconnected);
+    }
+
+    TEST_F(NetClientTest, sendShouldRejectInvalidInput)
+    {
+        EXPECT_FALSE(mClient.send("not connected"));
+        std::thread server([this] {
+            tcp::socket socket(mIo);
+            mAcceptor.accept(socket);
+            boost::system::error_code ec;
+            asio::streambuf buf;
+            asio::read(socket, buf, ec);
+        });
+        mClient.connect("127.0.0.1", port());
+        ASSERT_EQ(waitForEvents(mClient, 1).size(), 1u);
+        EXPECT_FALSE(mClient.send("a\nb"));
+        EXPECT_FALSE(mClient.send(std::string(Net::Client::sMaxLineSize + 1, 'x')));
+        mClient.disconnect();
+        server.join();
+    }
+}
