diff --git a/apps/openmw/mwlua/netbindings.cpp b/apps/openmw/mwlua/netbindings.cpp
new file mode 100644
index 0000000000..8a620532d8
--- /dev/null
+++ b/apps/openmw/mwlua/netbindings.cpp
@@ -0,0 +1,161 @@
+#include "netbindings.hpp"
+
+#include <cmath>
+#include <cstdio>
+#include <limits>
+#include <stdexcept>
+
+#include <components/lua/luastate.hpp>
+#include <components/net/client.hpp>
+
+#include "context.hpp"
+
+namespace MWLua
+{
+    namespace
+    {
+        constexpr int sMaxJsonDepth = 32;
+
+        void appendJsonString(std::string& out, std::string_view str)
+        {
+            out.push_back('"');
+            for (const unsigned char c : str)
+            {
+                switch (c)
+                {
+                    case '"':
+                        out += "\\\"";
+                        break;
+                    case '\\':
+                        out += "\\\\";
+                        break;
+                    case '\n':
+                        out += "\\n";
+                        break;
+                    case '\r':
+                        out += "\\r";
+                        break;
+                    case '\t':
+                        out += "\\t";
+                        break;
+                    default:
+                        if (c < 0x20)
+                        {
+                            char buf[8];
+                            std::snprintf(buf, sizeof(buf), "\\u%04x", c);
+                            out += buf;
+                        }
+                        else
+                            out.push_back(static_cast<char>(c));
+                }
+            }
+            out.push_back('"');
+        }
+
+        void appendJson(std::string& out, const sol::object& value, int depth)
+        {
+            if (depth > sMaxJsonDepth)
+                throw std::runtime_error("encodeJson: table is nested too deeply or contains a cycle");
+            switch (value.get_type())
+            {
+                case sol::type::lua_nil:
+                    out += "null";
+                    return;
+                case sol::type::boolean:
+                    out += value.as<bool>() ? "true" : "false";
+                    return;
+                case sol::type::number:
+                {
+                    const double d = value.as<double>();
+                    if (!std::isfinite(d))
+                        throw std::runtime_error("encodeJson: NaN and infinity can not be encoded");
+                    char buf[32];
+                    std::snprintf(buf, sizeof(buf), "%.17g", d);
+                    out += buf;
+                    return;
+                }
+                case sol::type::string:
+                    appendJsonString(out, value.as<std::string_view>());
+                    return;
+                case sol::type::table:
+                {
+                    const sol::table table = value.as<sol::table>();
+                    std::size_t count = 0;
+                    bool isArray = true;
+                    for (const auto& [k, v] : table)
+                    {
+                        ++count;
+                        if (!(k.is<double>() && k.as<double>() >= 1 && k.as<double>() == std::floor(k.as<double>())))
+                            isArray = false;
+                    }
+                    if (count == 0)
+                    {
+                        out += "[]";
+                        return;
+                    }
+                    if (isArray)
+                    {
+                        // Keys must be exactly 1..count
+                        for (std::size_t i = 1; i <= count; ++i)
+                            if (!table[i].valid() || table[i].get_type() == sol::type::lua_nil)
+                                isArray = false;
+                    }
+                    if (isArray)
+                    {
+                        out.push_back('[');
+                        for (std::size_t i = 1; i <= count; ++i)
+                        {
+                            if (i > 1)
+                                out.push_back(',');
+                            appendJson(out, table[i], depth + 1);
+                        }
+                        out.push_back(']');
+                        return;
+                    }
+                    out.push_back('{');
+                    bool first = true;
+                    for (const auto& [k, v] : table)
+                    {
+                        if (!k.is<std::string_view>() || k.get_type() != sol::type::string)
+                            throw std::runtime_error("encodeJson: object keys must be strings");
+                        if (!first)
+                            out.push_back(',');
+                        first = false;
+                        appendJsonString(out, k.as<std::string_view>());
+                        out.push_back(':');
+                        appendJson(out, v, depth + 1);
+                    }
+                    out.push_back('}');
+                    return;
+                }
+                default:
+                    throw std::runtime_error(std::string("encodeJson: unsupported value type: ")
+                        + sol::type_name(value.lua_state(), value.get_type()));
+            }
+        }
+    }
+
+    sol::table initNetPackage(const Context& context, Net::Client& client)
+    {
+        sol::state_view lua = context.sol();
+        sol::table api(lua, sol::create);
+
+        api["connect"] = [&client](std::string_view host, int port) {
+            if (host.empty())
+                throw std::invalid_argument("net.connect: empty host");
+            if (port < 1 || port > std::numeric_limits<std::uint16_t>::max())
+                throw std::invalid_argument("net.connect: port out of range");
+            client.connect(std::string(host), static_cast<std::uint16_t>(port));
+        };
+        api["disconnect"] = [&client]() { client.disconnect(); };
+        api["isConnected"] = [&client]() { return client.isConnected(); };
+        api["send"] = [&client](std::string_view message) { return client.send(message); };
+        api["encodeJson"] = [](const sol::object& value) {
+            std::string out;
+            appendJson(out, value, 0);
+            return out;
+        };
+
+        return LuaUtil::makeReadOnly(api);
+    }
+}
