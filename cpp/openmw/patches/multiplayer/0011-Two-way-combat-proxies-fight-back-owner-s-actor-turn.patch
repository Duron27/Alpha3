From 5a065afbb4a1881fcea0c2c5516f597fa5f3a17f Mon Sep 17 00:00:00 2001
From: Duron27 <duron27@gmail.com>
Date: Wed, 7 Oct 2026 02:56:35 -0400
Subject: [PATCH] Two-way combat: proxies fight back, owner's actor turns on
 its owner, avatars are unhurtable

- remote.lua: a proxy hit by the guest enables its AI and starts Combat against the local player
- damage.lua: damage forwarded to a real actor also makes it fight the local player
- avatars of other players keep full health; hitting one reports to the crime guard (no bounty)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 multiplayer/README.md                  |  5 ++++-
 multiplayer/mod/scripts/mp/damage.lua  | 15 +++++++++++--
 multiplayer/mod/scripts/mp/global.lua  |  1 +
 multiplayer/mod/scripts/mp/proxies.lua |  5 +++++
 multiplayer/mod/scripts/mp/remote.lua  | 30 ++++++++++++++++++++++----
 5 files changed, 49 insertions(+), 7 deletions(-)

diff --git a/multiplayer/README.md b/multiplayer/README.md
index 0e4d9f3368..f6cde39d80 100644
--- a/multiplayer/README.md
+++ b/multiplayer/README.md
@@ -24,5 +24,8 @@ Every player keeps their **own** world; nothing a group member does changes your
 Test with one client: `run-test.sh [--cheat]` starts the relay, a "Bot" player (auto-accepts party invites and trades,
 owns a scrib that doesn't exist in your world) and OpenMW. `server/owner_bot.py --help` lists bot options.
 
-Not done: members' attacks on you, shared fights where both worlds have the actor alive, container contents,
+Combat is two-way: hitting a proxy turns on its AI so it fights you in your world, the owner's real actor takes the damage
+and turns on its owner, and other players' avatars can't be hurt (and hitting one gives no bounty).
+
+Not done: shared fights where both worlds have the actor alive, container contents,
 weather/time, proxies for actors that are alive-but-unloaded in your world, trade of enchanted/generated items.
diff --git a/multiplayer/mod/scripts/mp/damage.lua b/multiplayer/mod/scripts/mp/damage.lua
index bd32775b8c..4d8ca6f499 100644
--- a/multiplayer/mod/scripts/mp/damage.lua
+++ b/multiplayer/mod/scripts/mp/damage.lua
@@ -1,7 +1,10 @@
--- Attached on demand to a real NPC/creature in *this* world when a group member
--- hurts that actor's proxy in their own world. Applies the damage as a fraction of max health.
+-- Attached on demand to a real NPC/creature in *this* world when a group member hurts that actor's
+-- proxy in their own world. Applies the damage as a fraction of max health and makes the actor turn on
+-- the local player, so a fight started by a guest becomes a shared fight.
 local self = require('openmw.self')
 local types = require('openmw.types')
+local nearby = require('openmw.nearby')
+local I = require('openmw.interfaces')
 
 return {
     eventHandlers = {
@@ -9,6 +12,14 @@ return {
             local health = types.Actor.stats.dynamic.health(self)
             local max = health.base + health.modifier
             health.current = math.max(0, health.current - d.frac * max)
+            if health.current > 0 then
+                pcall(function()
+                    local pkg = I.AI.getActivePackage()
+                    if not (pkg and pkg.type == 'Combat') then
+                        I.AI.startPackage({ type = 'Combat', target = nearby.players[1] })
+                    end
+                end)
+            end
         end,
     },
 }
