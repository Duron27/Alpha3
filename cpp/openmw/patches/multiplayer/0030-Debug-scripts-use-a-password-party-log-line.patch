From d58f13a738f3f3ae35a85f0840da899b794850d0 Mon Sep 17 00:00:00 2001
From: Duron27 <duron27@gmail.com>
Date: Fri, 9 Oct 2026 09:23:53 -0400
Subject: [PATCH] Debug scripts use a password; party log line

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 multiplayer/debug/scripts/mp_debug/autohost.lua | 2 +-
 multiplayer/debug/scripts/mp_debug/autojoin.lua | 2 +-
 multiplayer/mod/scripts/mp/global.lua           | 1 +
 multiplayer/run-two.sh                          | 2 +-
 4 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/multiplayer/debug/scripts/mp_debug/autohost.lua b/multiplayer/debug/scripts/mp_debug/autohost.lua
index 2f4dedddd7..6c9eca313d 100644
--- a/multiplayer/debug/scripts/mp_debug/autohost.lua
+++ b/multiplayer/debug/scripts/mp_debug/autohost.lua
@@ -6,7 +6,7 @@ return {
         onUpdate = function()
             if done then return end
             done = true
-            core.sendGlobalEvent('MpCmd', { cmd = 'configure', mode = 'host', host = '127.0.0.1', port = 25565 })
+            core.sendGlobalEvent('MpCmd', { cmd = 'configure', mode = 'host', host = '127.0.0.1', port = 25565, password = 'hunter2' })
         end,
     },
 }
diff --git a/multiplayer/debug/scripts/mp_debug/autojoin.lua b/multiplayer/debug/scripts/mp_debug/autojoin.lua
index e9893cfbe9..9e1043552d 100644
--- a/multiplayer/debug/scripts/mp_debug/autojoin.lua
+++ b/multiplayer/debug/scripts/mp_debug/autojoin.lua
@@ -15,7 +15,7 @@ return {
             end
             if not done then
                 done = true
-                core.sendGlobalEvent('MpCmd', { cmd = 'configure', mode = 'join', host = '127.0.0.1', port = 25565 })
+                core.sendGlobalEvent('MpCmd', { cmd = 'configure', mode = 'join', host = '127.0.0.1', port = 25565, password = 'hunter2' })
             end
         end,
     },
diff --git a/multiplayer/mod/scripts/mp/global.lua b/multiplayer/mod/scripts/mp/global.lua
index 244a0d7fb0..dcd1c561c4 100644
--- a/multiplayer/mod/scripts/mp/global.lua
+++ b/multiplayer/mod/scripts/mp/global.lua
@@ -549,6 +549,7 @@ local function onParty(msg)
     if #members == 0 and #party.members > 1 then notice('You are no longer in a party.') end
     if #members > 1 and #party.members <= 1 then notice('You joined a party.') end
     party = { members = members, leader = msg.leader }
+    log('party: ' .. #members .. ' member(s)')
     for _, m in ipairs(members) do invitesIn[m], invitesOut[m] = nil, nil end -- no invites between party members
     pushUi()
 end
diff --git a/multiplayer/run-two.sh b/multiplayer/run-two.sh
index 947107c60a..b4358d6ced 100755
--- a/multiplayer/run-two.sh
+++ b/multiplayer/run-two.sh
@@ -8,7 +8,7 @@ OPENMW="${1:?path to openmw}"; SAVE="${2:?path to a .omwsave}"; shift 2
 [ "${1:-}" = "--" ] && shift
 OUT="${TMPDIR:-/tmp}/mp-two"; mkdir -p "$OUT/host" "$OUT/join"
 common=(--data "$HERE/mod" --data "$HERE/debug" --load-savegame "$SAVE")
-"$OPENMW" "${common[@]}" --content mp.omwscripts --content autohost.omwscripts --user-data "$OUT/host" "$@" > "$OUT/host.log" 2>&1 &
+"$OPENMW" "${common[@]}" --content mp.omwscripts --content autohost.omwscripts --content autokill.omwscripts --user-data "$OUT/host" "$@" > "$OUT/host.log" 2>&1 &
 HOST=$!
 trap 'kill $HOST ${JOIN:-} 2>/dev/null' EXIT
 sleep 25   # let the host load and start listening
-- 
2.55.0

