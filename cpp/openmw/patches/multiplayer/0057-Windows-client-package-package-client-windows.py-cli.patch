+# The multiplayer sockets (components/net) use Boost.Asio. Upstream's prebuilt Windows dependencies carry a trimmed Boost without
+# it: point this at a full Boost source tree of the same version (the folder that holds boost/asio.hpp) to add its headers.
+set(OPENMW_BOOST_HEADERS_DIR "" CACHE PATH "Full Boost headers to use for Boost.Asio when the Boost found has none")
+if (OPENMW_BOOST_HEADERS_DIR)
+    include_directories(AFTER SYSTEM "${OPENMW_BOOST_HEADERS_DIR}")
+endif ()
+
