@@ -0,0 +1,59 @@
+#ifndef OPENMW_COMPONENTS_NET_SERVER_H
+#define OPENMW_COMPONENTS_NET_SERVER_H
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace Net
+{
+    struct ServerEvent
+    {
+        enum class Type
+        {
+            ClientConnected,
+            ClientDisconnected, // not emitted for kick() or stop()
+            Message, // mData holds one received line, without the line terminator.
+        };
+        Type mType;
+        std::uint32_t mClient;
+        std::string mData;
+    };
+
+    // Line-oriented TCP server. Sockets live on a background thread; the owner drives it with
+    // non-blocking calls and collects results with poll(). Not thread-safe: use from a single thread.
+    class Server
+    {
+    public:
+        static constexpr std::size_t sMaxLineSize = 1024 * 1024;
+        static constexpr std::size_t sMaxPendingOutput = 8 * 1024 * 1024;
+
+        Server();
+        ~Server();
+        Server(const Server&) = delete;
+        Server& operator=(const Server&) = delete;
+
+        // Starts listening on all interfaces. Returns an error message, or an empty string on success.
+        // Stops any previous listening first.
+        std::string listen(std::uint16_t port);
+
+        // Closes the listening socket and every client, and discards pending events.
+        void stop();
+
+        bool isListening() const;
+
+        // Client ids start at 1 and are never reused while listening.
+        bool send(std::uint32_t client, std::string_view line);
+        void kick(std::uint32_t client);
+
+        std::vector<ServerEvent> poll();
+
+    private:
+        class Impl;
+        std::unique_ptr<Impl> mImpl;
+    };
+}
+
+#endif
