new file mode 100644
index 0000000000..e0ff107286
--- /dev/null
+++ b/apps/components_tests/net/server.cpp
@@ -0,0 +1,91 @@
+#include <components/net/server.hpp>
+
+#include <chrono>
+#include <thread>
+
+#include <boost/asio.hpp>
+#include <gtest/gtest.h>
+
+namespace
+{
+    using namespace testing;
+    namespace asio = boost::asio;
+    using asio::ip::tcp;
+
+    std::vector<Net::ServerEvent> waitForEvents(Net::Server& server, std::size_t count)
+    {
+        std::vector<Net::ServerEvent> result;
+        for (int i = 0; i < 500 && result.size() < count; ++i)
+        {
+            for (Net::ServerEvent& e : server.poll())
+                result.push_back(std::move(e));
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        }
+        return result;
+    }
+
+    // Port 0 is not usable through Server::listen, so look for a free one.
+    std::uint16_t listenOnFreePort(Net::Server& server)
+    {
+        for (std::uint16_t port = 47200; port < 47400; ++port)
+            if (server.listen(port).empty())
+                return port;
+        return 0;
+    }
+
+    TEST(NetServerTest, shouldExchangeLinesWithSeveralClients)
+    {
+        Net::Server server;
+        const std::uint16_t port = listenOnFreePort(server);
+        ASSERT_NE(port, 0);
+        EXPECT_TRUE(server.isListening());
+
+        asio::io_context io;
+        tcp::socket a(io), b(io);
+        a.connect(tcp::endpoint(asio::ip::make_address("127.0.0.1"), port));
+        b.connect(tcp::endpoint(asio::ip::make_address("127.0.0.1"), port));
+        auto events = waitForEvents(server, 2);
+        ASSERT_EQ(events.size(), 2u);
+        EXPECT_EQ(events[0].mType, Net::ServerEvent::Type::ClientConnected);
+        EXPECT_EQ(events[0].mClient, 1u);
+        EXPECT_EQ(events[1].mClient, 2u);
+
+        asio::write(b, asio::buffer(std::string("hi\r\n")));
+        events = waitForEvents(server, 1);
+        ASSERT_EQ(events.size(), 1u);
+        EXPECT_EQ(events[0].mType, Net::ServerEvent::Type::Message);
+        EXPECT_EQ(events[0].mClient, 2u);
+        EXPECT_EQ(events[0].mData, "hi");
+
+        EXPECT_TRUE(server.send(1, "to-a"));
+        EXPECT_FALSE(server.send(1, "bad\nline"));
+        asio::streambuf buf;
+        asio::read_until(a, buf, '\n');
+        std::istream in(&buf);
+        std::string line;
+        std::getline(in, line);
+        EXPECT_EQ(line, "to-a");
+
+        b.close();
+        events = waitForEvents(server, 1);
+        ASSERT_EQ(events.size(), 1u);
+        EXPECT_EQ(events[0].mType, Net::ServerEvent::Type::ClientDisconnected);
+        EXPECT_EQ(events[0].mClient, 2u);
+
+        server.kick(1);
+        boost::system::error_code ec;
+        asio::read(a, buf, ec);
+        EXPECT_TRUE(ec); // closed by the server
+        server.stop();
+        EXPECT_FALSE(server.isListening());
+    }
+
+    TEST(NetServerTest, shouldReportListenFailure)
+    {
+        Net::Server first, second;
+        const std::uint16_t port = listenOnFreePort(first);
+        ASSERT_NE(port, 0);
+        EXPECT_FALSE(second.listen(port).empty());
+        EXPECT_FALSE(second.isListening());
+    }
+}
