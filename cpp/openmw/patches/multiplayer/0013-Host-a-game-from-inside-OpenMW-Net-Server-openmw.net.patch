diff --git a/components/net/server.cpp b/components/net/server.cpp
new file mode 100644
index 0000000000..40ecc50c7a
--- /dev/null
+++ b/components/net/server.cpp
@@ -0,0 +1,270 @@
+#include "server.hpp"
+
+#include <deque>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <thread>
+
+#include <boost/asio.hpp>
+
+namespace Net
+{
+    namespace asio = boost::asio;
+    using asio::ip::tcp;
+
+    namespace
+    {
+        struct EventQueue
+        {
+            std::mutex mMutex;
+            std::vector<ServerEvent> mEvents;
+
+            void push(ServerEvent::Type type, std::uint32_t client, std::string data = {})
+            {
+                const std::lock_guard lock(mMutex);
+                mEvents.push_back({ type, client, std::move(data) });
+            }
+        };
+
+        // Lives on the io thread.
+        class Connection : public std::enable_shared_from_this<Connection>
+        {
+        public:
+            Connection(tcp::socket socket, std::uint32_t id, std::shared_ptr<EventQueue> queue)
+                : mSocket(std::move(socket))
+                , mId(id)
+                , mQueue(std::move(queue))
+            {
+            }
+
+            void start()
+            {
+                boost::system::error_code ignored;
+                mSocket.set_option(tcp::no_delay(true), ignored);
+                mQueue->push(ServerEvent::Type::ClientConnected, mId);
+                read();
+            }
+
+            void write(std::string line)
+            {
+                if (mClosed)
+                    return;
+                line.push_back('\n');
+                mPending += line.size();
+                if (mPending > Server::sMaxPendingOutput)
+                    return fail(); // the client is not keeping up
+                const bool idle = mOut.empty();
+                mOut.push_back(std::move(line));
+                if (idle)
+                    doWrite();
+            }
+
+            // Closes without reporting a disconnect.
+            void close()
+            {
+                mClosed = true;
+                boost::system::error_code ignored;
+                mSocket.close(ignored);
+            }
+
+        private:
+            void read()
+            {
+                asio::async_read_until(mSocket, asio::dynamic_buffer(mIn, Server::sMaxLineSize), '\n',
+                    [self = shared_from_this()](const boost::system::error_code& ec, std::size_t n) {
+                        if (ec)
+                            return self->fail();
+                        std::size_t len = n - 1;
+                        if (len > 0 && self->mIn[len - 1] == '\r')
+                            --len;
+                        self->mQueue->push(ServerEvent::Type::Message, self->mId, self->mIn.substr(0, len));
+                        self->mIn.erase(0, n);
+                        self->read();
+                    });
+            }
+
+            void doWrite()
+            {
+                asio::async_write(mSocket, asio::buffer(mOut.front()),
+                    [self = shared_from_this()](const boost::system::error_code& ec, std::size_t n) {
+                        if (ec)
+                            return self->fail();
+                        self->mPending -= n;
+                        self->mOut.pop_front();
+                        if (!self->mOut.empty())
+                            self->doWrite();
+                    });
+            }
+
+            void fail()
+            {
+                if (mClosed)
+                    return;
+                close();
+                mQueue->push(ServerEvent::Type::ClientDisconnected, mId);
+            }
+
+            tcp::socket mSocket;
+            std::uint32_t mId;
+            std::shared_ptr<EventQueue> mQueue;
+            std::string mIn;
+            std::deque<std::string> mOut;
+            std::size_t mPending = 0;
+            bool mClosed = false;
+        };
+    }
+
+    class Server::Impl
+    {
+    public:
+        ~Impl() { stop(); }
+
+        std::string listen(std::uint16_t port)
+        {
+            stop();
+            boost::system::error_code ec;
+            tcp::acceptor acceptor(mIo);
+            const tcp::endpoint endpoint(tcp::v4(), port);
+            acceptor.open(endpoint.protocol(), ec);
+            if (!ec)
+                acceptor.set_option(tcp::acceptor::reuse_address(true), ec);
+            if (!ec)
+                acceptor.bind(endpoint, ec);
+            if (!ec)
+                acceptor.listen(asio::socket_base::max_listen_connections, ec);
+            if (ec)
+                return ec.message();
+            mQueue = std::make_shared<EventQueue>();
+            mAcceptor.emplace(std::move(acceptor));
+            mNextId = 1;
+            mWork.emplace(asio::make_work_guard(mIo));
+            mThread = std::thread([this] { mIo.run(); });
+            asio::post(mIo, [this] { accept(); });
+            return {};
+        }
+
+        void stop()
+        {
+            if (!mThread.joinable())
+                return;
+            asio::post(mIo, [this] {
+                boost::system::error_code ignored;
+                mAcceptor->close(ignored);
+                for (auto& [id, c] : mConnections)
+                    c->close();
+                mConnections.clear();
+            });
+            mWork.reset();
+            mThread.join();
+            mIo.restart();
+            mAcceptor.reset();
+            mQueue.reset();
+        }
+
+        bool isListening() const { return mThread.joinable(); }
+
+        bool send(std::uint32_t client, std::string_view line)
+        {
+            if (!isListening() || line.size() > Server::sMaxLineSize
+                || line.find_first_of("\r\n") != std::string_view::npos)
+                return false;
+            asio::post(mIo, [this, client, l = std::string(line)]() mutable {
+                const auto it = mConnections.find(client);
+                if (it != mConnections.end())
+                    it->second->write(std::move(l));
+            });
+            return true;
+        }
+
+        void kick(std::uint32_t client)
+        {
+            if (!isListening())
+                return;
+            asio::post(mIo, [this, client] {
+                const auto it = mConnections.find(client);
+                if (it != mConnections.end())
+                {
+                    it->second->close();
+                    mConnections.erase(it);
+                }
+            });
+        }
+
+        std::vector<ServerEvent> poll()
+        {
+            std::vector<ServerEvent> result;
+            if (mQueue)
+            {
+                {
+                    const std::lock_guard lock(mQueue->mMutex);
+                    result.swap(mQueue->mEvents);
+                }
+                // Forget connections the io thread has already closed, so ids are not leaked.
+                for (const ServerEvent& e : result)
+                    if (e.mType == ServerEvent::Type::ClientDisconnected)
+                        asio::post(mIo, [this, id = e.mClient] { mConnections.erase(id); });
+            }
+            return result;
+        }
+
+    private:
+        void accept()
+        {
+            mAcceptor->async_accept([this](const boost::system::error_code& ec, tcp::socket socket) {
+                if (ec)
+                    return; // acceptor closed
+                const std::uint32_t id = mNextId++;
+                auto connection = std::make_shared<Connection>(std::move(socket), id, mQueue);
+                mConnections.emplace(id, connection);
+                connection->start();
+                accept();
+            });
+        }
+
+        asio::io_context mIo;
+        std::optional<asio::executor_work_guard<asio::io_context::executor_type>> mWork;
+        std::thread mThread;
+        std::optional<tcp::acceptor> mAcceptor;
+        std::shared_ptr<EventQueue> mQueue;
+        std::map<std::uint32_t, std::shared_ptr<Connection>> mConnections; // io thread only
+        std::uint32_t mNextId = 1;
+    };
+
+    Server::Server()
+        : mImpl(std::make_unique<Impl>())
+    {
+    }
+
+    Server::~Server() = default;
+
+    std::string Server::listen(std::uint16_t port)
+    {
+        return mImpl->listen(port);
+    }
+
+    void Server::stop()
+    {
+        mImpl->stop();
+    }
+
+    bool Server::isListening() const
+    {
+        return mImpl->isListening();
+    }
+
+    bool Server::send(std::uint32_t client, std::string_view line)
+    {
+        return mImpl->send(client, line);
+    }
+
+    void Server::kick(std::uint32_t client)
+    {
+        mImpl->kick(client);
+    }
+
+    std::vector<ServerEvent> Server::poll()
+    {
+        return mImpl->poll();
+    }
+}
