diff --git a/multiplayer/README.md b/multiplayer/README.md
index 9fb1bba7e4..3455dd8c74 100644
--- a/multiplayer/README.md
+++ b/multiplayer/README.md
@@ -76,6 +76,10 @@ By default it opens a **window**: the players (name, latency, address, location,
 Copy address buttons for the selected one, the sky (weather box and time of day), an announcement box, the banned names with
 an Unban button, the log, and a command line for everything else (Help lists the commands). Closing the window asks first if
 players are connected. `--cli-only` runs it in the terminal instead, and so does a machine with no display (a VPS) by itself.
+The build copies the whole `multiplayer/` folder into the build folder (`<build>/multiplayer`); the server finds it next to its
+program and the engine's built-in scripts are copied from it, so a build folder does not need the source tree. `cmake --build .
+--target mpserver-bundle` makes `openmw-mp-server-<system>-<cpu>.zip` with the program, that folder, start scripts and a short
+README, ready to unpack on a server (use `-DBUILD_MP_SERVER_GUI=OFF` for a bundle that needs nothing but the C++ runtime).
 `--help` lists the rest (player limit, weather, how fast time runs...). The passwords can also come from `MP_PASSWORD` and
 `MP_ADMIN_PASSWORD`. The program embeds the same Luau VM as the game and the engine's own sockets (`components/net`), and
 loads `relay.lua` unchanged, so a server behaves exactly like a hosted game (resume tokens, rate limits, trade checks).
diff --git a/multiplayer/stage.cmake b/multiplayer/stage.cmake
new file mode 100644
index 0000000000..057f5837ed
--- /dev/null
+++ b/multiplayer/stage.cmake
@@ -0,0 +1,25 @@
+# Copies the multiplayer folder (the mod, server/server.lua, the README) into the build folder, once:
+#   <build>/multiplayer/mod, <build>/multiplayer/server, <build>/multiplayer/README.md
+# Everything that runs from the build folder uses that copy and not the source tree: openmw-mp-server finds it next to
+# itself, the engine's built-in multiplayer scripts are copied from it (files/data), and the server bundle zip is made from
+# it. Edit the files here as usual; CMake copies them again when it reruns (it reruns by itself when a file changes).
+# (This is included by the main CMakeLists.txt, not a subdirectory, so only the real files land in <build>/multiplayer.)
+if (NOT DEFINED OPENMW_RESOURCES_ROOT)
+    return()
+endif ()
+
+file(GLOB_RECURSE MULTIPLAYER_STAGE_FILES CONFIGURE_DEPENDS RELATIVE "${CMAKE_CURRENT_LIST_DIR}"
+    "${CMAKE_CURRENT_LIST_DIR}/mod/*" "${CMAKE_CURRENT_LIST_DIR}/server/*")
+list(APPEND MULTIPLAYER_STAGE_FILES README.md)
+foreach (f ${MULTIPLAYER_STAGE_FILES})
+    copy_resource_file("${CMAKE_CURRENT_LIST_DIR}/${f}" "${OPENMW_RESOURCES_ROOT}" "multiplayer/${f}")
+endforeach (f)
+
+# With a multi-config generator the copy lives in one folder per configuration: users of the path below then fall back to
+# the source tree.)
+get_generator_is_multi_config(multi_config)
+if (multi_config)
+    set(OPENMW_MULTIPLAYER_STAGED "" CACHE INTERNAL "")
+else ()
+    set(OPENMW_MULTIPLAYER_STAGED "${OPENMW_RESOURCES_ROOT}/multiplayer" CACHE INTERNAL "the multiplayer folder in the build folder")
+endif ()
