From: Duron27 <duron27@gmail.com>
Subject: [PATCH] The multiplayer folder is copied into the build folder; mpserver-bundle makes a self-contained server zip

- multiplayer/stage.cmake (included by the main CMakeLists.txt): copies mod, server and README.md into <build>/multiplayer
  (only those files: it is an include, not a subdirectory, so no CMake files land there). Reruns on change.
- everything that runs from the build folder uses that copy: openmw-mp-server finds it next to itself (before looking in
  the current directory), and the engine's built-in multiplayer scripts are copied from it (files/data)
- target mpserver-bundle: openmw-mp-server-<system>-<cpu>.zip with the stripped program, the multiplayer folder, start-server
  .sh/.bat and a README, ready to unpack and run anywhere (apps/mpserver/bundle.cmake). With -DBUILD_MP_SERVER_GUI=OFF it
  needs nothing but the C++ runtime (the build says so when the window is built in: it then needs Qt 6)

---
diff --git a/CMakeLists.txt b/CMakeLists.txt
index f7e7e2f63e..3f9e151f4a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -579,6 +579,7 @@ if (NOT APPLE)  # this is modified for macOS use later in "apps/open[mw|cs]/CMak
     set(OPENMW_RESOURCES_ROOT ${OpenMW_BINARY_DIR})
 endif ()
 
+include(multiplayer/stage.cmake) # copies the multiplayer folder into the build folder, see there
 add_subdirectory(files/)
 
 # Specify build paths
diff --git a/apps/mpserver/BUNDLE-README.txt b/apps/mpserver/BUNDLE-README.txt
new file mode 100644
index 0000000000..e6e5649c01
--- /dev/null
+++ b/apps/mpserver/BUNDLE-README.txt
@@ -0,0 +1,25 @@
+OpenMW multiplayer server
+=========================
+
+Everything the server needs is in this folder:
+
+  openmw-mp-server          the program
+  multiplayer/mod           the multiplayer mod (the server runs its relay)
+  multiplayer/server        server.lua, what the program runs
+  multiplayer/README.md     how the multiplayer works, the server's commands and settings
+  start-server.sh / .bat    starts it from this folder
+
+Start it:
+
+  ./start-server.sh --port 25565 --password secret --admin-password hunter2
+  ./start-server.sh --help          every option and every console command
+
+Players join with "Join a server" on the multiplayer screen: your address, the port, the password. The port (TCP, 25565
+unless you change it) must be open on this machine's firewall and forwarded on your router if the server is at home.
+Type "help" in the server's terminal for the commands; "quit" stops it. Up to 128 players.
+
+A window (players, kick/ban/mute buttons, the sky, a log) opens by default when there is a screen and this build has it;
+add --cli-only for a plain terminal. A build with the window needs the Qt 6 libraries installed on this machine; a
+terminal-only build needs nothing but the system's C++ runtime.
+
+The mod is found by itself next to the program. To use another copy: --mod <folder holding scripts/mp>.
diff --git a/apps/mpserver/CMakeLists.txt b/apps/mpserver/CMakeLists.txt
index 41611f8311..066fa6cbfb 100644
--- a/apps/mpserver/CMakeLists.txt
+++ b/apps/mpserver/CMakeLists.txt
@@ -48,6 +48,28 @@ endif()
 
 install(TARGETS openmw-mp-server)
 
+# mpserver-bundle: openmw-mp-server-<system>-<cpu>.zip with the program, the multiplayer folder (mod, server.lua, README) and
+# start scripts, ready to unpack anywhere:  cmake --build . --target mpserver-bundle
+# The multiplayer folder comes from the copy in the build folder (multiplayer/stage.cmake).
+if (OPENMW_MULTIPLAYER_STAGED AND EXISTS "${OPENMW_MULTIPLAYER_STAGED}/mod/mp.omwscripts")
+    set(MPSERVER_BUNDLE_FOLDER "${OPENMW_MULTIPLAYER_STAGED}")
+else ()
+    set(MPSERVER_BUNDLE_FOLDER "${CMAKE_SOURCE_DIR}/multiplayer")
+endif ()
+set(MPSERVER_BUNDLE_NAME "openmw-mp-server-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
+add_custom_target(mpserver-bundle
+    COMMAND ${CMAKE_COMMAND}
+        "-DSERVER=$<TARGET_FILE:openmw-mp-server>" "-DMULTIPLAYER_DIR=${MPSERVER_BUNDLE_FOLDER}"
+        "-DFILES_DIR=${CMAKE_CURRENT_SOURCE_DIR}" "-DOUT_DIR=${CMAKE_BINARY_DIR}" "-DNAME=${MPSERVER_BUNDLE_NAME}"
+        "-DSTRIP=${CMAKE_STRIP}" -P "${CMAKE_CURRENT_SOURCE_DIR}/bundle.cmake"
+    DEPENDS openmw-mp-server
+    COMMENT "Making ${MPSERVER_BUNDLE_NAME}.zip"
+    VERBATIM)
+if (MPSERVER_QT_FOUND)
+    message(STATUS "openmw-mp-server has a window: its bundle needs the Qt 6 libraries on the machine it runs on "
+        "(-DBUILD_MP_SERVER_GUI=OFF makes one that needs nothing but the C++ runtime)")
+endif ()
+
 # Where the server looks for the mod when it is installed (<prefix>/share/openmw-mp/mod and .../server/server.lua)
 install(DIRECTORY ${CMAKE_SOURCE_DIR}/multiplayer/mod DESTINATION share/openmw-mp)
 install(FILES ${CMAKE_SOURCE_DIR}/multiplayer/server/server.lua DESTINATION share/openmw-mp/server)
diff --git a/apps/mpserver/bundle.cmake b/apps/mpserver/bundle.cmake
new file mode 100644
index 0000000000..0d646bd1ac
--- /dev/null
+++ b/apps/mpserver/bundle.cmake
@@ -0,0 +1,47 @@
+# Makes <OUT_DIR>/<NAME>.zip: the server program, the multiplayer folder and start scripts, ready to unpack anywhere.
+#   cmake -DSERVER=<program> -DMULTIPLAYER_DIR=<folder with mod, server, README.md> -DFILES_DIR=<apps/mpserver>
+#         -DOUT_DIR=<folder> -DNAME=<name> [-DSTRIP=<strip tool>] -P bundle.cmake
+foreach (required SERVER MULTIPLAYER_DIR FILES_DIR OUT_DIR NAME)
+    if (NOT DEFINED ${required})
+        message(FATAL_ERROR "bundle.cmake: ${required} is not set")
+    endif ()
+endforeach ()
+
+set(stage "${OUT_DIR}/${NAME}-staging")
+set(dir "${stage}/openmw-mp-server")
+file(REMOVE_RECURSE "${stage}")
+file(MAKE_DIRECTORY "${dir}/multiplayer")
+
+get_filename_component(exe "${SERVER}" NAME)
+file(COPY "${SERVER}" DESTINATION "${dir}" FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE
+    WORLD_READ WORLD_EXECUTE)
+if (STRIP AND NOT STRIP MATCHES "NOTFOUND" AND NOT WIN32)
+    execute_process(COMMAND "${STRIP}" "${dir}/${exe}" RESULT_VARIABLE strip_result ERROR_QUIET)
+endif ()
+
+foreach (part mod server README.md)
+    if (NOT EXISTS "${MULTIPLAYER_DIR}/${part}")
+        message(FATAL_ERROR "bundle.cmake: ${MULTIPLAYER_DIR}/${part} is missing")
+    endif ()
+    file(COPY "${MULTIPLAYER_DIR}/${part}" DESTINATION "${dir}/multiplayer")
+endforeach ()
+
+file(COPY "${FILES_DIR}/start-server.sh" DESTINATION "${dir}" FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
+    GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
+# (a batch file wants Windows line endings, whatever git did to the one in the source tree)
+file(READ "${FILES_DIR}/start-server.bat" bat)
+string(REGEX REPLACE "\r?\n" "\r\n" bat "${bat}")
+file(WRITE "${dir}/start-server.bat" "${bat}")
+file(COPY "${FILES_DIR}/BUNDLE-README.txt" DESTINATION "${dir}")
+file(RENAME "${dir}/BUNDLE-README.txt" "${dir}/README.txt")
+
+file(REMOVE "${OUT_DIR}/${NAME}.zip")
+execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUT_DIR}/${NAME}.zip" --format=zip openmw-mp-server
+    WORKING_DIRECTORY "${stage}" RESULT_VARIABLE zip_result)
+if (NOT zip_result EQUAL 0)
+    message(FATAL_ERROR "bundle.cmake: could not make the zip")
+endif ()
+file(REMOVE_RECURSE "${stage}")
+file(SIZE "${OUT_DIR}/${NAME}.zip" size)
+math(EXPR kilobytes "${size} / 1024")
+message(STATUS "${OUT_DIR}/${NAME}.zip (${kilobytes} KB)")
