@@ -0,0 +1,88 @@
+-- Local script attached to the NPC that stands in for a remote player.
+-- Disables AI and steers the actor toward the last known remote position so it
+-- plays real walk/run animations; the global script teleports it if it gets too far off.
+local self = require('openmw.self')
+local core = require('openmw.core')
+local types = require('openmw.types')
+local util = require('openmw.util')
+
+local Actor = types.Actor
+
+local WALK_START, WALK_STOP = 70, 30 -- distance hysteresis (game units)
+local RUN_DIST = 250
+local SNAP_DIST = 700
+local TURN_RATE = 8 -- rad/s
+
+local target -- { pos, yaw, stance }
+local walking = false
+local desiredEquip
+local equipTimer = 0
+local snapTimer = 0
+local aiOff = false
+
+local function wrap(a)
+    while a > math.pi do a = a - 2 * math.pi end
+    while a < -math.pi do a = a + 2 * math.pi end
+    return a
+end
+
+local function equipMatches()
+    local cur = Actor.getEquipment(self)
+    for slot, id in pairs(desiredEquip) do
+        local o = cur[slot]
+        if not o or o.recordId ~= id then return false end
+    end
+    return true
+end
+
+return {
+    engineHandlers = {
+        onActive = function() self:enableAI(false); aiOff = true end,
+        onUpdate = function(dt)
+            if not aiOff then self:enableAI(false); aiOff = true end
+            local c = self.controls
+
+            if desiredEquip then
+                equipTimer = equipTimer - dt
+                if equipTimer <= 0 then
+                    equipTimer = 1
+                    if equipMatches() then desiredEquip = nil else Actor.setEquipment(self, desiredEquip) end
+                end
+            end
+
+            if not target then return end
+            snapTimer = snapTimer - dt
+
+            local delta = target.pos - self.position
+            local dist = math.sqrt(delta.x * delta.x + delta.y * delta.y)
+            if dist > SNAP_DIST and snapTimer <= 0 then
+                snapTimer = 1
+                core.sendGlobalEvent('MpSnap', { actor = self.object })
+            end
+
+            if walking then
+                if dist < WALK_STOP then walking = false end
+            elseif dist > WALK_START then
+                walking = true
+            end
+
+            local wantYaw = walking and math.atan2(delta.x, delta.y) or target.yaw
+            local err = wrap(wantYaw - self.rotation:getYaw())
+            local maxTurn = TURN_RATE * dt
+            c.yawChange = math.max(-maxTurn, math.min(maxTurn, err))
+            c.movement = walking and 1 or 0
+            c.run = walking and dist > RUN_DIST
+            c.sneak = target.sneak or false
+        end,
+    },
+    eventHandlers = {
+        MpTarget = function(d)
+            target = { pos = d.pos, yaw = d.yaw, sneak = d.sneak }
+            if d.stance and Actor.getStance(self) ~= d.stance then Actor.setStance(self, d.stance) end
+        end,
+        MpEquip = function(d)
+            desiredEquip = d.slots
+            equipTimer = 0
+        end,
+    },
+}
