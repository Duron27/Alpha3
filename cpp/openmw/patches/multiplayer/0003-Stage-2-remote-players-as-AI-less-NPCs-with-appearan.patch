             local ok, msg = pcall(markup.decodeYaml, line)
-            if not ok or type(msg) ~= 'table' then return end
-            if msg.t == 'hello' then myId = msg.id; log('my id is ' .. tostring(myId))
-            elseif msg.t == 'state' then applyState(msg)
