+                if sendTimer >= SEND_INTERVAL then sendTimer = 0; sendState() end
+                if equipTimer >= EQUIP_INTERVAL then equipTimer = 0; sendEquipment(false) end
+            elseif player() then
                 retry = retry + dt
                 if retry >= RETRY_INTERVAL then
                     retry = 0
-                    connect()
+                    net.connect(HOST, PORT)
                 end
             end
         end,
@@ -88,10 +214,14 @@ return {
         end,
