+-- Keep each remote's actor in sync with what we know: visible only in our own cell.
+local function updateRemote(r)
+    local p = player()
+    if not (p and r.profile and r.state) then return end
+    local sameCell = r.state.cell == cellKey(p.cell)
+    if not sameCell then
+        if r.obj and r.obj.enabled then r.obj.enabled = false end
+        return
+    end
+    if not r.obj or not r.obj:isValid() then
+        spawnRemote(r)
+        return
+    end
+    if not r.obj.enabled then
+        placeRemote(r)
+        r.obj.enabled = true
+        return
+    end
+    if not r.equipSent and r.equip then stockEquipment(r) end
+    local pos = stateVectors(r)
+    r.obj:sendEvent('MpTarget', {
+        pos = pos, yaw = r.state.yaw, stance = r.state.stance,
+    })
+end
