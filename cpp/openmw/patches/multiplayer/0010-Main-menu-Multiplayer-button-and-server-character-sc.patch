From c5d078d81aeeda699f7287d00b85a40bc870ba15 Mon Sep 17 00:00:00 2001
From: Duron27 <duron27@gmail.com>
Date: Wed, 7 Oct 2026 02:48:46 -0400
Subject: [PATCH] Main menu Multiplayer button and server/character screen

- engine: 'multiplayer' button in the main menu (TGA textures shipped in files/data/textures) that calls a new
  onMainMenuButton menu-script handler; explains itself if no script handles it
- menu.lua: Modal screen with server/port, New/Load character (or apply+reconnect in game); stored in the
  permanent player section MpConnect and forwarded to the global script by player.lua

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 apps/openmw/mwbase/luamanager.hpp             |   2 +
 apps/openmw/mwgui/mainmenu.cpp                |  20 ++-
 apps/openmw/mwlua/luamanagerimp.hpp           |   1 +
 apps/openmw/mwlua/menuscripts.hpp             |  10 +-
 files/data/CMakeLists.txt                     |   3 +
 files/data/textures/menu_multiplayer.tga      | Bin 0 -> 65580 bytes
 files/data/textures/menu_multiplayer_over.tga | Bin 0 -> 65580 bytes
 .../textures/menu_multiplayer_pressed.tga     | Bin 0 -> 65580 bytes
 multiplayer/mod/mp.omwscripts                 |   1 +
 multiplayer/mod/scripts/mp/global.lua         |   3 +
 multiplayer/mod/scripts/mp/menu.lua           | 166 ++++++++++++++++++
 multiplayer/mod/scripts/mp/player.lua         |   6 +
 12 files changed, 207 insertions(+), 5 deletions(-)
 create mode 100644 files/data/textures/menu_multiplayer.tga
 create mode 100644 files/data/textures/menu_multiplayer_over.tga
 create mode 100644 files/data/textures/menu_multiplayer_pressed.tga
 create mode 100644 multiplayer/mod/scripts/mp/menu.lua

diff --git a/apps/openmw/mwbase/luamanager.hpp b/apps/openmw/mwbase/luamanager.hpp
index d38204d852..e1f0ee5043 100644
--- a/apps/openmw/mwbase/luamanager.hpp
+++ b/apps/openmw/mwbase/luamanager.hpp
@@ -109,6 +109,8 @@ namespace MWBase
         virtual void questUpdated(const ESM::RefId& questId, int stage) = 0;
         // `arg` is either forwarded from MWGui::pushGuiMode or empty
         virtual void uiModeChanged(const MWWorld::Ptr& arg) = 0;
+        // A main menu button without built-in behaviour was clicked. Returns false if no script handles it.
+        virtual bool mainMenuButton(const std::string& id) = 0;
         virtual void viewportResized(int width, int height) = 0;
         virtual void savePermanentStorage(const std::filesystem::path& userConfigPath) = 0;
         virtual void applyMagicEffects(ESM::RefId id, const MWWorld::Ptr& caster, ESM::RefNum item,
diff --git a/apps/openmw/mwgui/mainmenu.cpp b/apps/openmw/mwgui/mainmenu.cpp
index 010159be00..ca33da708c 100644
--- a/apps/openmw/mwgui/mainmenu.cpp
+++ b/apps/openmw/mwgui/mainmenu.cpp
@@ -12,6 +12,7 @@
 #include <components/widgets/imagebutton.hpp>
 
 #include "../mwbase/environment.hpp"
+#include "../mwbase/luamanager.hpp"
 #include "../mwbase/statemanager.hpp"
 #include "../mwbase/windowmanager.hpp"
 #include "../mwbase/world.hpp"
@@ -172,6 +173,12 @@ namespace MWGui
         winMgr->playSound(ESM::RefId::stringRefId("Menu Click"));
         if (name == "return")
             winMgr->removeGuiMode(GM_MainMenu);
+        else if (name == "multiplayer")
+        {
+            // Provided by a menu script (the multiplayer mod); without one the button explains itself.
+            if (!MWBase::Environment::get().getLuaManager()->mainMenuButton(name))
+                winMgr->messageBox("Multiplayer is not available: the multiplayer mod is not enabled.");
+        }
         else if (name == "credits")
             winMgr->playVideo("mw_credits.bik", true);
         else if (name == "exitgame")
@@ -326,6 +333,8 @@ namespace MWGui
             != MWBase::Environment::get().getStateManager()->characterEnd())
             buttons.emplace_back("loadgame");
 
+        buttons.emplace_back("multiplayer");
+
         buttons.emplace_back("options");
 
         if (state == MWBase::StateManager::State_NoGame)
@@ -334,16 +343,19 @@ namespace MWGui
         buttons.emplace_back("exitgame");
 
         // Create new buttons if needed
-        for (std::string_view id : { "return", "newgame", "savegame", "loadgame", "options", "credits", "exitgame" })
+        for (std::string_view id :
+            { "return", "newgame", "savegame", "loadgame", "multiplayer", "options", "credits", "exitgame" })
         {
             if (mButtons.find(id) == mButtons.end())
             {
                 Gui::ImageButton* button = mButtonBox->createWidget<Gui::ImageButton>(
                     "ImageBox", MyGUI::IntCoord(0, curH, 0, 0), MyGUI::Align::Default);
                 const std::string& buttonId = mButtons.emplace(id, button).first->first;
-                button->setProperty("ImageHighlighted", "textures\\menu_" + buttonId + "_over.dds");
-                button->setProperty("ImageNormal", "textures\\menu_" + buttonId + ".dds");
-                button->setProperty("ImagePushed", "textures\\menu_" + buttonId + "_pressed.dds");
+                // The multiplayer button's textures ship with OpenMW (TGA); the others come from the game data.
+                const std::string ext = buttonId == "multiplayer" ? ".tga" : ".dds";
+                button->setProperty("ImageHighlighted", "textures\\menu_" + buttonId + "_over" + ext);
+                button->setProperty("ImageNormal", "textures\\menu_" + buttonId + ext);
+                button->setProperty("ImagePushed", "textures\\menu_" + buttonId + "_pressed" + ext);
                 button->eventMouseButtonClick += MyGUI::newDelegate(this, &MainMenu::onButtonClicked);
                 button->setUserData(buttonId);
             }
diff --git a/apps/openmw/mwlua/luamanagerimp.hpp b/apps/openmw/mwlua/luamanagerimp.hpp
index becfb85afb..5d8d638f0c 100644
--- a/apps/openmw/mwlua/luamanagerimp.hpp
+++ b/apps/openmw/mwlua/luamanagerimp.hpp
@@ -168,6 +168,7 @@ namespace MWLua
         void objectTeleported(const MWWorld::Ptr& ptr) override;
         void questUpdated(const ESM::RefId& questId, int stage) override;
         void uiModeChanged(const MWWorld::Ptr& arg) override;
+        bool mainMenuButton(const std::string& id) override { return mMenuScripts.mainMenuButton(id); }
         void viewportResized(int width, int height) override;
         void actorDied(const MWWorld::Ptr& actor) override;
         void onDialogueResponse(
diff --git a/apps/openmw/mwlua/menuscripts.hpp b/apps/openmw/mwlua/menuscripts.hpp
index 4eb56b8ac0..c71a928947 100644
--- a/apps/openmw/mwlua/menuscripts.hpp
+++ b/apps/openmw/mwlua/menuscripts.hpp
@@ -26,7 +26,7 @@ namespace MWLua
             , mInputProcessor(this)
         {
             registerEngineHandlers({ &mOnFrameHandlers, &mStateChanged, &mConsoleCommandHandlers,
-                &mViewportResizedHandlers, &mUiModeChanged });
+                &mViewportResizedHandlers, &mUiModeChanged, &mMainMenuButton });
         }
 
         void processInputEvent(const MWBase::LuaManager::InputEvent& event)
@@ -48,6 +48,13 @@ namespace MWLua
 
         void uiModeChanged() { callEngineHandlers(mUiModeChanged); }
 
+        // Returns whether any script handles main menu buttons that the engine doesn't implement itself.
+        bool mainMenuButton(const std::string& id)
+        {
+            callEngineHandlers(mMainMenuButton, id);
+            return !mMainMenuButton.mList.empty();
+        }
+
     private:
         friend class MWLua::InputProcessor<MenuScripts>;
         MWLua::InputProcessor<MenuScripts> mInputProcessor;
@@ -56,6 +63,7 @@ namespace MWLua
         EngineHandlerList mConsoleCommandHandlers{ "onConsoleCommand" };
         EngineHandlerList mViewportResizedHandlers{ "onViewportResized" };
         EngineHandlerList mUiModeChanged{ "_onUiModeChanged" };
+        EngineHandlerList mMainMenuButton{ "onMainMenuButton" };
     };
 }
 
