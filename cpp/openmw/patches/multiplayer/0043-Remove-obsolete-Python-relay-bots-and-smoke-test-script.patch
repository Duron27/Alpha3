diff --git a/multiplayer/server/relay.py b/multiplayer/server/relay.py
deleted file mode 100644
index 0e06db5..0000000
--- a/multiplayer/server/relay.py
+++ /dev/null
@@ -1,252 +0,0 @@
-#!/usr/bin/env python3
-"""OpenMW multiplayer relay: newline-delimited JSON over TCP.
-
-Everyone connected shares a global channel (presence and global chat). Parties (max 3) are
-formed with invites and additionally share party chat, vitals, and actor rosters/damage.
-Every player keeps their own world; the relay only routes messages.
-
-Client -> server (anything else is stamped with the sender's "id" and routed by type):
-  {"t":"invite","to":ID}   {"t":"accept","from":ID}   {"t":"decline","from":ID}   {"t":"leave_party"}
-  {"t":"chat","scope":"global"|"party","text":"..."}
-  global routing : profile, equip, state, chat(global)         -> everyone else
-  party routing  : actors, vitals, dmg, chat(party)             -> other party members
-  trade_*        : any message with "to":ID is forwarded to that player (trade request/inv/deal/ok/cancel)
-  any message with "to":ID goes only to that player (if allowed for its type)
-Server -> client:
-  {"t":"hello","id":N}  {"t":"leave","id":N} (disconnect)  {"t":"party","members":[..],"leader":ID}
-  {"t":"invite","from":ID}  {"t":"invite_result","ok":bool,"to":ID,"reason":".."}  {"t":"declined","id":ID}
-  {"t":"notice","text":".."}
---mirror: each client also sees a ghost copy of itself (id -N) for one-client testing.
-"""
-import asyncio
-import json
-import sys
-import time
-
-MIRROR = "--mirror" in sys.argv
-sys.argv = [a for a in sys.argv if a != "--mirror"]
-
-MAX_PARTY = 3
-INVITE_TTL = 60
-CHAT_MAX = 240
-GLOBAL_TYPES = ("profile", "equip", "state")
-PARTY_TYPES = ("actors", "vitals", "dmg")
-CACHED = GLOBAL_TYPES + ("actors", "vitals")
-
-clients = {}   # id -> {"w", "party": id|None, "last": {type: msg}, "bucket": [tokens, time]}
-parties = {}   # party id -> {"members": [ids], "leader": id}
-invites = {}   # (from, to) -> expiry time
-next_id = 1
-next_party = 1
-
-
-def enc(msg):
-    return (json.dumps(msg, separators=(",", ":")) + "\n").encode()
-
-
-def send_to(cid, msg):
-    c = clients.get(cid)
-    if c:
-        c["w"].write(enc(msg))
-
-
-def party_members(cid):
-    p = clients[cid]["party"] if cid in clients else None
-    return list(parties[p]["members"]) if p else []
-
-
-def to_party(cid, msg):
-    for m in party_members(cid):
-        if m != cid:
-            send_to(m, msg)
-
-
-def announce_party(pid):
-    p = parties.get(pid)
-    if p:
-        for m in p["members"]:
-            send_to(m, {"t": "party", "members": p["members"], "leader": p["leader"]})
-
-
-def remove_from_party(cid):
-    c = clients.get(cid)
-    pid = c["party"] if c else None
-    if not pid:
-        return
-    p = parties[pid]
-    p["members"].remove(cid)
-    c["party"] = None
-    send_to(cid, {"t": "party", "members": [], "leader": None})
-    if len(p["members"]) <= 1:  # a party of one is no party
-        for m in p["members"]:
-            clients[m]["party"] = None
-            send_to(m, {"t": "party", "members": [], "leader": None})
-        del parties[pid]
-    else:
-        if p["leader"] == cid:
-            p["leader"] = p["members"][0]
-        announce_party(pid)
-
-
-def pending_to(cid):
-    return [t for (f, t), exp in invites.items() if f == cid and exp > time.time()]
-
-
-def purge_invites():
-    now = time.time()
-    for k in [k for k, exp in invites.items() if exp <= now]:
-        del invites[k]
-
-
-def handle_invite(cid, msg):
-    purge_invites()
-    to = msg.get("to")
-    def fail(reason):
-        send_to(cid, {"t": "invite_result", "ok": False, "to": to, "reason": reason})
-    if to not in clients or to == cid:
-        return fail("unknown")
-    if clients[to]["party"] is not None:
-        return fail("busy")  # already in a party: they must leave first
-    size = len(party_members(cid)) or 1
-    waiting = {t for t in pending_to(cid)} | ({t for m in party_members(cid) for t in pending_to(m)})
-    if size + len(waiting - {to}) >= MAX_PARTY:
-        return fail("full")
-    invites[(cid, to)] = time.time() + INVITE_TTL
-    send_to(to, {"t": "invite", "from": cid})
-    send_to(cid, {"t": "invite_result", "ok": True, "to": to})
-
-
-def handle_accept(cid, msg):
-    purge_invites()
-    frm = msg.get("from")
-    if (frm, cid) not in invites or frm not in clients:
-        return send_to(cid, {"t": "invite_result", "ok": False, "to": frm, "reason": "expired"})
-    del invites[(frm, cid)]
-    if clients[cid]["party"] is not None:
-        return send_to(cid, {"t": "invite_result", "ok": False, "to": frm, "reason": "busy"})
-    members = party_members(frm)
-    if len(members) >= MAX_PARTY:
-        return send_to(cid, {"t": "invite_result", "ok": False, "to": frm, "reason": "full"})
-    global next_party
-    if not members:
-        pid, next_party = next_party, next_party + 1
-        parties[pid] = {"members": [frm], "leader": frm}
-        clients[frm]["party"] = pid
-    pid = clients[frm]["party"]
-    parties[pid]["members"].append(cid)
-    clients[cid]["party"] = pid
-    for k in [k for k in invites if k[1] == cid]:
-        del invites[k]
-    announce_party(pid)
-    # bring everyone up to date on each other's actors/vitals
-    for m in parties[pid]["members"]:
-        for t in ("actors", "vitals"):
-            if t in clients[m]["last"]:
-                for o in parties[pid]["members"]:
-                    if o != m:
-                        send_to(o, clients[m]["last"][t])
-
-
-def handle_decline(cid, msg):
-    frm = msg.get("from")
-    if invites.pop((frm, cid), None) is not None:
-        send_to(frm, {"t": "declined", "id": cid})
-
-
-def allow_chat(c):
-    now = time.time()
-    tokens, last = c["bucket"]
-    tokens = min(5.0, tokens + (now - last) * 1.5)
-    if tokens < 1:
-        c["bucket"] = [tokens, now]
-        return False
-    c["bucket"] = [tokens - 1, now]
-    return True
-
-
-async def handle(reader, writer):
-    global next_id
-    cid, next_id = next_id, next_id + 1
-    clients[cid] = {"w": writer, "party": None, "last": {}, "bucket": [5.0, time.time()]}
-    print(f"+ client {cid} from {writer.get_extra_info('peername')}", flush=True)
-    send_to(cid, {"t": "hello", "id": cid})
-    for other, oc in clients.items():  # replay global presence
-        if other != cid:
-            for t in GLOBAL_TYPES:
-                if t in oc["last"]:
-                    send_to(cid, oc["last"][t])
-    try:
-        async for line in reader:
-            try:
-                msg = json.loads(line)
-            except ValueError:
-                continue
-            if not isinstance(msg, dict):
-                continue
-            t = msg.get("t")
-            if t in ("invite", "accept", "decline", "leave_party"):
-                print(f"  {t} from {cid}: {msg}", flush=True)
-            if t == "invite": handle_invite(cid, msg); continue
-            if t == "accept": handle_accept(cid, msg); continue
-            if t == "decline": handle_decline(cid, msg); continue
-            if t == "leave_party": remove_from_party(cid); continue
-            msg["id"] = cid
-            if isinstance(t, str) and t.startswith("trade_"):
-                target = msg.get("to")  # trades are between two players, party or not
-                if target in clients and target != cid:
-                    send_to(target, msg)
-                continue
-            if t in CACHED:
-                clients[cid]["last"][t] = msg
-            if t == "chat":
-                text = str(msg.get("text", ""))[:CHAT_MAX].strip()
-                if not text or not allow_chat(clients[cid]):
-                    continue
-                msg = {"t": "chat", "id": cid, "text": text, "scope": msg.get("scope")}
-                if msg["scope"] == "party":
-                    to_party(cid, msg)
-                else:
-                    msg["scope"] = "global"
-                    for o in clients:
-                        if o != cid:
-                            send_to(o, msg)
-                continue
-            if t in GLOBAL_TYPES:
-                for o in clients:
-                    if o != cid:
-                        send_to(o, msg)
-                if MIRROR:
-                    ghost = dict(msg, id=-cid)
-                    if t == "state" and isinstance(msg.get("pos"), list) and len(msg["pos"]) == 3:
-                        ghost["pos"] = [msg["pos"][0] + 300, msg["pos"][1], msg["pos"][2]]
-                    send_to(cid, ghost)
-            elif t in PARTY_TYPES:
-                target = msg.get("to")
-                if target is not None:
-                    if target in party_members(cid) and target != cid:
-                        send_to(target, msg)
-                else:
-                    to_party(cid, msg)
-    except (ConnectionError, asyncio.LimitOverrunError):
-        pass
-    finally:
-        remove_from_party(cid)
-        for k in [k for k in invites if cid in k]:
-            del invites[k]
-        del clients[cid]
-        writer.close()
-        print(f"- client {cid}", flush=True)
-        for o in clients:
-            send_to(o, {"t": "leave", "id": cid})
-
-
-async def main(host, port):
-    server = await asyncio.start_server(handle, host, port)
-    print(f"relay listening on {host}:{port}", flush=True)
-    async with server:
-        await server.serve_forever()
-
-
-if __name__ == "__main__":
-    asyncio.run(main(sys.argv[1] if len(sys.argv) > 1 else "127.0.0.1",
-                     int(sys.argv[2]) if len(sys.argv) > 2 else 25565))
