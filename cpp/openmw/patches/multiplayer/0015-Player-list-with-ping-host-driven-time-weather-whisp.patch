@@ -0,0 +1,24 @@
+-- Test helper: sets this instance to 'join' mode without touching the menu, and fakes player input
+-- (alternating attacks, jumping, sneaking) so the host can check the avatar animations.
+local core = require('openmw.core')
+local done, t, seq = false, 0, 0
+local kinds = { 'chop', 'slash', 'thrust' }
+return {
+    engineHandlers = {
+        onUpdate = function(dt)
+            if not done then
+                done = true
+                core.sendGlobalEvent('MpCmd', { cmd = 'configure', mode = 'join', host = '127.0.0.1', port = 25565 })
+            end
+            t = t + dt
+            if t > 30 then -- give both sides time to connect
+                local step = math.floor((t - 30) / 4)
+                if step ~= seq then
+                    seq = step
+                    core.sendGlobalEvent('MpInput', { sneak = step % 2 == 1, air = step % 3 == 0,
+                        atk = kinds[step % 3 + 1], seq = step })
+                end
+            end
+        end,
+    },
+}
