-                h = v.h, hm = v.hm, m = v.m, mm = v.mm, f = v.f, fm = v.fm,
+                h = v.h, hm = v.hm, m = v.m, mm = v.mm, f = v.f, fm = v.fm, bad = v.bad,
             }
         end
