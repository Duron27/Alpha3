+local camera = require('openmw.camera')
+local markers = {} -- avatar object id -> { el, name }
+local avatarList = {}
 local playerList, myPlayerId = {}, nil
 local self = require('openmw.self')
 local types = require('openmw.types')
@@ -163,6 +166,52 @@ trade.init({
 })
 
 local closeChat
+local updateMarkers
+
+------------------------------------------------------------------ markers over other players
+
+local ARROW = ui.texture { path = 'textures/mp_arrow.tga' }
+local ARROW_SIZE, HEAD_HEIGHT = 28, 135
+
+-- A green arrow (and name) above every other player in this cell. It is a screen overlay, so walls and
+-- scenery never hide it.
+function updateMarkers()
+    local scr = ui.screenSize()
+    local seen = {}
+    local camPos = camera.getPosition()
+    local forward = camera.viewportToWorldVector(V2(scr.x / 2, scr.y / 2))
+    for _, a in ipairs(avatarList) do
+        local ok, pos = pcall(function() return a.obj.position end)
+        if ok and a.obj:isValid() then
+            local v = camera.worldToViewportVector(pos + util.vector3(0, 0, HEAD_HEIGHT))
+            local key = a.obj.id
+            if (pos - camPos):dot(forward) > 0 and v.x > -50 and v.x < scr.x + 50 and v.y > -50 and v.y < scr.y + 50 then
+                seen[key] = true
+                local m = markers[key]
+                local layout = {
+                    layer = 'HUD', type = ui.TYPE.Widget,
+                    props = { position = V2(v.x - 60, v.y - ARROW_SIZE - 24), size = V2(120, ARROW_SIZE + 22) },
+                    content = ui.content {
+                        { template = I.MWUI.templates.textNormal,
+                          props = { text = a.name, textColor = rgb(0.5, 1, 0.5), textSize = 16,
+                                    position = V2(60, 0), anchor = V2(0.5, 0) } },
+                        { type = ui.TYPE.Image,
+                          props = { resource = ARROW, size = V2(ARROW_SIZE, ARROW_SIZE), position = V2(60, 20), anchor = V2(0.5, 0) } },
+                    },
+                }
+                if m then
+                    m.layout = layout
+                    m:update()
+                else
+                    markers[key] = ui.create(layout)
+                end
+            end
+        end
+    end
+    for key, el in pairs(markers) do
+        if not seen[key] then el:destroy() markers[key] = nil end
+    end
+end
 
 local function sendChat(str)
     str = str:gsub('^%s+', ''):gsub('%s+$', '')
@@ -428,6 +477,7 @@ return {
             end
