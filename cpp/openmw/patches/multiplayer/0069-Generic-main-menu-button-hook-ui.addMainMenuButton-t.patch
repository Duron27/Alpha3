diff --git a/apps/openmw/mwlua/luamanagerimp.cpp b/apps/openmw/mwlua/luamanagerimp.cpp
index 9303ef9a20..dbe944b9d6 100644
--- a/apps/openmw/mwlua/luamanagerimp.cpp
+++ b/apps/openmw/mwlua/luamanagerimp.cpp
@@ -826,6 +826,20 @@ namespace MWLua
         mMenuScripts.stateChanged();
     }
 
+    void LuaManager::addMainMenuButton(MainMenuButton button)
+    {
+        // registering the same id again replaces it (a menu script that is reloaded)
+        for (MainMenuButton& existing : mMainMenuButtons)
+        {
+            if (existing.mId == button.mId)
+            {
+                existing = std::move(button);
+                return;
+            }
+        }
+        mMainMenuButtons.push_back(std::move(button));
+    }
+
     void LuaManager::noGame()
     {
         clear();
