+        if (menu)
+        {
+            // An extra button on the main menu. Clicking it calls onMainMenuButton(id) of the menu scripts.
+            // { id, normal, highlighted, pushed (texture paths), after = id of the button it goes after }
+            api.function("addMainMenuButton", [luaManager = context.mLuaManager](const Lua::TableView& options) {
+                MWBase::LuaManager::MainMenuButton button;
+                button.mId = options.getOptional<std::string>("id").value_or(std::string());
+                button.mNormal = options.getOptional<std::string>("normal").value_or(std::string());
+                button.mHighlighted = options.getOptional<std::string>("highlighted").value_or(button.mNormal);
+                button.mPushed = options.getOptional<std::string>("pushed").value_or(button.mNormal);
+                button.mAfter = options.getOptional<std::string>("after").value_or(std::string());
+                static const std::set<std::string, std::less<>> builtin
+                    = { "return", "newgame", "savegame", "loadgame", "options", "credits", "exitgame" };
+                if (button.mId.empty() || button.mNormal.empty() || builtin.count(button.mId))
+                    throw std::invalid_argument("ui.addMainMenuButton: needs an id (not a built-in button's) and a texture");
+                luaManager->addMainMenuButton(std::move(button));
+            });
+        }
