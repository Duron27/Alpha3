@@ -0,0 +1,97 @@
+-- Multiplayer test client: streams the local player's state to a relay server
+-- and shows every remote player as a placeholder object.
+local net = require('openmw.net')
+local world = require('openmw.world')
+local util = require('openmw.util')
+local markup = require('openmw.markup')
+
+local HOST = '127.0.0.1'
+local PORT = 25565
+local SEND_INTERVAL = 0.2 -- seconds
+local MARKER = 'com_chest_01' -- placeholder record for remote players
+local RETRY_INTERVAL = 3
+
+local timer = 0
+local retry = 0
+local wantConnect = true
+local myId
+local remotes = {} -- id -> { obj = GameObject }
+
+local function log(...) print('[mp]', ...) end
+
+local function connect()
+    log('connecting to ' .. HOST .. ':' .. PORT)
+    net.connect(HOST, PORT)
+end
+
+local function sendState()
+    local p = world.players[1]
+    if not p then return end
+    local pos = p.position
+    net.send(net.encodeJson({
+        t = 'state',
+        name = p.recordId,
+        cell = p.cell.isExterior and '' or p.cell.name,
+        pos = { pos.x, pos.y, pos.z },
+        yaw = p.rotation:getYaw(),
+    }))
+end
+
+local function applyState(msg)
+    if type(msg.pos) ~= 'table' then return end
+    local r = remotes[msg.id]
+    if not r then
+        r = { obj = world.createObject(MARKER, 1) }
+        remotes[msg.id] = r
+        log('remote player ' .. tostring(msg.id) .. ' appeared')
+    end
+    local pos = util.vector3(msg.pos[1], msg.pos[2], msg.pos[3])
+    r.obj:teleport(msg.cell or '', pos, { rotation = util.transform.rotateZ(msg.yaw or 0) })
+end
+
+local function removeRemote(id)
+    local r = remotes[id]
+    if r then
+        r.obj:remove()
+        remotes[id] = nil
+        log('remote player ' .. tostring(id) .. ' left')
+    end
+end
+
+local function clearRemotes()
+    for id in pairs(remotes) do removeRemote(id) end
+end
+
+return {
+    engineHandlers = {
+        onPlayerAdded = function() connect() end,
+        onLoad = function() remotes = {}; wantConnect = true end,
+        onUpdate = function(dt)
+            if net.isConnected() then
+                timer = timer + dt
+                if timer >= SEND_INTERVAL then
+                    timer = 0
+                    sendState()
+                end
+            elseif wantConnect and world.players[1] then
+                retry = retry + dt
+                if retry >= RETRY_INTERVAL then
+                    retry = 0
+                    connect()
+                end
+            end
+        end,
+        onNetConnected = function() log('connected'); retry = 0 end,
+        onNetDisconnected = function(reason)
+            log('disconnected: ' .. tostring(reason))
+            clearRemotes()
+        end,
+        onNetMessage = function(line)
+            local ok, msg = pcall(markup.decodeYaml, line)
+            if not ok or type(msg) ~= 'table' then return end
+            if msg.t == 'hello' then myId = msg.id; log('my id is ' .. tostring(myId))
+            elseif msg.t == 'state' then applyState(msg)
+            elseif msg.t == 'leave' then removeRemote(msg.id) end
+        end,
+    },
+}
