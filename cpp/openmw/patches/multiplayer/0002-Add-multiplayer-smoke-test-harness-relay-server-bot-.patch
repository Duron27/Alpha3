new file mode 100644
index 0000000000..4fa65a5506
--- /dev/null
+++ b/multiplayer/server/relay.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""Minimal OpenMW multiplayer relay: newline-delimited JSON over TCP.
+
+Every line a client sends is stamped with its id and forwarded to all others.
+With --mirror each client also sees a ghost copy of itself (id -N), for one-client testing.
+Sends {"t":"hello","id":N} on connect, {"t":"leave","id":N} when a client goes.
+"""
+import asyncio
+import json
+import sys
+
+MIRROR = "--mirror" in sys.argv
+sys.argv = [a for a in sys.argv if a != "--mirror"]
+clients = {}  # id -> StreamWriter
+next_id = 1
+
+
+async def broadcast(msg, exclude=None):
+    data = (json.dumps(msg, separators=(",", ":")) + "\n").encode()
+    for cid, w in list(clients.items()):
+        if cid != exclude:
+            w.write(data)
+
+
+async def handle(reader, writer):
+    global next_id
+    cid, next_id = next_id, next_id + 1
+    clients[cid] = writer
+    print(f"+ client {cid} from {writer.get_extra_info('peername')}", flush=True)
+    writer.write((json.dumps({"t": "hello", "id": cid}) + "\n").encode())
+    try:
+        async for line in reader:
+            try:
+                msg = json.loads(line)
+            except ValueError:
+                continue
+            if not isinstance(msg, dict):
+                continue
+            msg["id"] = cid
+            await broadcast(msg, exclude=cid)
+            if MIRROR and msg.get("t") == "state" and isinstance(msg.get("pos"), list) and len(msg["pos"]) == 3:
+                # Echo the sender back as a fake second player standing 300 units east of them.
+                ghost = dict(msg, id=-cid, pos=[msg["pos"][0] + 300, msg["pos"][1], msg["pos"][2]])
+                writer.write((json.dumps(ghost, separators=(",", ":")) + "\n").encode())
+    except (ConnectionError, asyncio.LimitOverrunError):
+        pass
+    finally:
+        del clients[cid]
+        writer.close()
+        print(f"- client {cid}", flush=True)
+        await broadcast({"t": "leave", "id": cid})
+
+
+async def main(host, port):
+    server = await asyncio.start_server(handle, host, port)
+    print(f"relay listening on {host}:{port}", flush=True)
+    async with server:
+        await server.serve_forever()
+
+
+if __name__ == "__main__":
+    asyncio.run(main(sys.argv[1] if len(sys.argv) > 1 else "127.0.0.1",
+                     int(sys.argv[2]) if len(sys.argv) > 2 else 25565))
