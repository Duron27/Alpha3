+#!/usr/bin/env bash
+# Smoke test: relay + fake bot player + OpenMW with the mp test mod.
+# usage: multiplayer/run-test.sh [path/to/openmw] [bot cx cy z]
+# With --mirror the relay shows you a ghost chest 300 units east of yourself, so no bot is needed.
+set -e
+HERE="$(cd "$(dirname "$0")" && pwd)"
+OPENMW="${1:-/tmp/claude-1000/-home-arinmal-AndroidStudioProjects-openmw3/46de22f9-4029-44ad-89e9-b4b5c94bec0b/scratchpad/build/openmw}"
+python3 "$HERE/server/relay.py" --mirror & RELAY=$!
+trap 'kill $RELAY ${BOT:-} 2>/dev/null' EXIT
+sleep 1
+if [ -n "$2" ]; then python3 "$HERE/server/bot.py" 127.0.0.1 25565 "$2" "$3" "$4" & BOT=$!; fi
+"$OPENMW" --data "$HERE/mod" --content mp.omwscripts || true
