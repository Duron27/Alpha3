new file mode 100644
index 0000000000..64414ab92c
--- /dev/null
+++ b/multiplayer/server/bot.py
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+"""Fake second player: walks in a circle around (cx, cy, z) so you can test with one game client.
+
+usage: bot.py [host] [port] [cx cy z] [cell]   (cell "" = exterior)
+Get your coordinates from the position line the mod prints in openmw.log.
+"""
+import json
+import math
+import socket
+import sys
+import time
+
+host = sys.argv[1] if len(sys.argv) > 1 else "127.0.0.1"
+port = int(sys.argv[2]) if len(sys.argv) > 2 else 25565
+cx, cy, z = (float(v) for v in sys.argv[3:6]) if len(sys.argv) >= 6 else (0.0, 0.0, 0.0)
+cell = sys.argv[6] if len(sys.argv) > 6 else ""
+
+s = socket.create_connection((host, port))
+t = 0.0
+while True:
+    msg = {"t": "state", "name": "bot", "cell": cell,
+           "pos": [cx + 300 * math.cos(t), cy + 300 * math.sin(t), z],
+           "yaw": t + math.pi / 2}
+    s.sendall((json.dumps(msg) + "\n").encode())
+    t += 0.1
+    time.sleep(0.2)
