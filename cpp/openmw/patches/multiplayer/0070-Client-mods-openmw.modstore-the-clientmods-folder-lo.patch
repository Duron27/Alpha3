diff --git a/components/misc/clientmods.cpp b/components/misc/clientmods.cpp
new file mode 100644
index 0000000000..4a78bab01e
--- /dev/null
+++ b/components/misc/clientmods.cpp
@@ -0,0 +1,435 @@
+#include "clientmods.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <array>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <set>
+#include <system_error>
+
+
+#include "sha256.hpp"
+
+#ifdef _WIN32
+#include <windows.h>
+#elif defined(__linux__) && !defined(__ANDROID__)
+#include <unistd.h>
+#endif
+
+namespace Misc::ClientMods
+{
+    namespace
+    {
+        namespace fs = std::filesystem;
+
+        fs::path sRoot;
+        std::atomic<bool> sRestart{ false };
+
+        bool nameChar(char c)
+        {
+            return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-'
+                || c == '.';
+        }
+
+        bool allowedExtension(std::string_view path)
+        {
+            static const std::set<std::string, std::less<>> allowed = { "lua", "omwscripts", "yaml", "txt", "tga", "dds",
+                "png", "jpg", "nif", "kf", "wav", "mp3", "ogg" };
+            const std::size_t dot = path.rfind('.');
+            if (dot == std::string_view::npos)
+                return false;
+            std::string ext(path.substr(dot + 1));
+            std::transform(ext.begin(), ext.end(), ext.begin(), [](unsigned char c) { return std::tolower(c); });
+            return allowed.count(ext) > 0;
+        }
+
+        std::optional<std::string> readWhole(const fs::path& path, std::uint64_t limit)
+        {
+            std::error_code ec;
+            const auto size = fs::file_size(path, ec);
+            if (ec || size > limit)
+                return std::nullopt;
+            std::ifstream in(path, std::ios::binary);
+            if (!in)
+                return std::nullopt;
+            std::string data(static_cast<std::size_t>(size), '\0');
+            in.read(data.data(), static_cast<std::streamsize>(size));
+            if (static_cast<std::uint64_t>(in.gcount()) != size)
+                return std::nullopt;
+            return data;
+        }
+
+        struct CachedHash
+        {
+            std::uint64_t mSize;
+            fs::file_time_type mTime;
+            std::string mHash;
+        };
+        std::mutex sCacheMutex;
+        std::map<std::string, CachedHash> sCache;
+
+        std::string hashOf(const fs::path& path, std::uint64_t size)
+        {
+            std::error_code ec;
+            const auto time = fs::last_write_time(path, ec);
+            const std::string key = path.generic_string();
+            {
+                const std::lock_guard lock(sCacheMutex);
+                const auto it = sCache.find(key);
+                if (!ec && it != sCache.end() && it->second.mSize == size && it->second.mTime == time)
+                    return it->second.mHash;
+            }
+            const auto data = readWhole(path, sMaxFileSize);
+            if (!data)
+                return {};
+            std::string hash = sha256Hex(*data);
+            if (!ec)
+            {
+                const std::lock_guard lock(sCacheMutex);
+                sCache[key] = { size, time, hash };
+            }
+            return hash;
+        }
+
+        // The files of one mod folder (only plain files with allowed names; anything else is ignored)
+        std::vector<File> filesOf(const fs::path& dir, bool withHashes)
+        {
+            std::vector<File> files;
+            std::error_code ec;
+            for (fs::recursive_directory_iterator it(dir, fs::directory_options::none, ec), end; !ec && it != end;
+                 it.increment(ec))
+            {
+                if (!it->is_regular_file(ec) || it->is_symlink(ec))
+                    continue;
+                const std::string rel = fs::relative(it->path(), dir, ec).generic_string();
+                if (ec || !validPath(rel))
+                    continue;
+                const std::uint64_t size = it->file_size(ec);
+                if (ec || size > sMaxFileSize)
+                    continue;
+                if (files.size() >= sMaxFilesPerMod)
+                    break;
+                File file;
+                file.mPath = rel;
+                file.mSize = size;
+                if (withHashes)
+                    file.mHash = hashOf(it->path(), size);
+                files.push_back(std::move(file));
+            }
+            std::sort(files.begin(), files.end(), [](const File& a, const File& b) { return a.mPath < b.mPath; });
+            return files;
+        }
+
+        std::vector<std::string> modIds()
+        {
+            std::vector<std::string> ids;
+            if (sRoot.empty())
+                return ids;
+            std::error_code ec;
+            for (fs::directory_iterator it(sRoot, ec), end; !ec && it != end; it.increment(ec))
+            {
+                const std::string id = it->path().filename().string();
+                if (it->is_directory(ec) && !it->is_symlink(ec) && validId(id))
+                    ids.push_back(id);
+            }
+            std::sort(ids.begin(), ids.end());
+            if (ids.size() > sMaxMods)
+                ids.resize(sMaxMods);
+            return ids;
+        }
+
+        std::uint64_t totalSize(const std::vector<File>& files)
+        {
+            std::uint64_t total = 0;
+            for (const File& file : files)
+                total += file.mSize;
+            return total;
+        }
+    }
+
+    void setRoot(const fs::path& root)
+    {
+        sRoot = root;
+    }
+
+    const fs::path& root()
+    {
+        return sRoot;
+    }
+
+    bool validId(std::string_view id)
+    {
+        if (id.empty() || id.size() > 40)
+            return false;
+        for (char c : id)
+            if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '-'))
+                return false;
+        return true;
+    }
+
+    bool validPath(std::string_view path)
+    {
+        if (path.empty() || path.size() > 160 || !allowedExtension(path))
+            return false;
+        int parts = 0;
+        std::size_t start = 0;
+        while (start <= path.size())
+        {
+            std::size_t slash = path.find('/', start);
+            if (slash == std::string_view::npos)
+                slash = path.size();
+            const std::string_view part = path.substr(start, slash - start);
+            if (part.empty() || part.front() == '.' || ++parts > 6)
+                return false;
+            for (char c : part)
+                if (!nameChar(c))
+                    return false;
+            start = slash + 1;
+        }
+        return true;
+    }
+
+    std::vector<Mod> installed()
+    {
+        std::vector<Mod> mods;
+        for (const std::string& id : modIds())
+        {
+            Mod mod;
+            mod.mId = id;
+            mod.mFiles = filesOf(sRoot / id, true);
+            if (!mod.mFiles.empty())
+                mods.push_back(std::move(mod));
+        }
+        return mods;
+    }
+
+    std::optional<std::string> read(std::string_view id, std::string_view path)
+    {
+        if (sRoot.empty() || !validId(id) || !validPath(path))
+            return std::nullopt;
+        const fs::path file = sRoot / std::string(id) / std::string(path);
+        std::error_code ec;
+        if (!fs::is_regular_file(file, ec) || fs::is_symlink(file, ec))
+            return std::nullopt;
+        return readWhole(file, sMaxFileSize);
+    }
+
+    std::string write(std::string_view id, std::string_view path, std::string_view data, std::string_view expectedHash)
+    {
+        if (sRoot.empty())
+            return "client mods are not enabled";
+        if (!validId(id))
+            return "bad mod name";
+        if (!validPath(path))
+            return "bad or disallowed file name";
+        if (data.size() > sMaxFileSize)
+            return "file too large";
+        std::string expected(expectedHash);
+        std::transform(expected.begin(), expected.end(), expected.begin(), [](unsigned char c) { return std::tolower(c); });
+        if (sha256Hex(data) != expected)
+            return "hash mismatch";
+
+        const fs::path dir = sRoot / std::string(id);
+        std::error_code ec;
+        if (!fs::exists(dir, ec) && modIds().size() >= sMaxMods)
+            return "too many mods";
+        const fs::path target = dir / std::string(path);
+        // room for it: what the mod holds already, without the file being replaced
+        std::uint64_t others = 0;
+        std::size_t count = 0;
+        for (const File& file : filesOf(dir, false))
+        {
+            ++count;
+            if (file.mPath != path)
+                others += file.mSize;
+        }
+        if (others + data.size() > sMaxModSize || count > sMaxFilesPerMod)
+            return "the mod is too large";
+        if (fs::is_symlink(target, ec))
+            return "refusing to write through a link";
+
+        fs::create_directories(target.parent_path(), ec);
+        if (ec)
+            return "could not create the folder: " + ec.message();
+        // a folder that is not really inside the mods folder (a link somewhere): refuse
+        const fs::path real = fs::weakly_canonical(target.parent_path(), ec);
+        const fs::path rootReal = fs::weakly_canonical(sRoot, ec);
+        if (real.generic_string().rfind(rootReal.generic_string(), 0) != 0)
+            return "outside the mods folder";
+
+        const fs::path temp = target.string() + ".part";
+        {
+            std::ofstream out(temp, std::ios::binary | std::ios::trunc);
+            if (!out)
+                return "could not write the file";
+            out.write(data.data(), static_cast<std::streamsize>(data.size()));
+            if (!out)
+                return "could not write the file";
+        }
+        fs::rename(temp, target, ec);
+        if (ec)
+        {
+            fs::remove(temp, ec);
+            return "could not move the file into place";
+        }
+        return {};
+    }
+
+    std::string remove(std::string_view id, std::string_view path)
+    {
+        if (sRoot.empty() || !validId(id))
+            return "bad mod name";
+        std::error_code ec;
+        if (path.empty())
+        {
+            fs::remove_all(sRoot / std::string(id), ec);
+        }
+        else
+        {
+            if (!validPath(path))
+                return "bad file name";
+            fs::remove(sRoot / std::string(id) / std::string(path), ec);
+        }
+        return ec ? ec.message() : std::string();
+    }
+
+    std::string base64Encode(std::string_view data)
+    {
+        static constexpr char table[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+        std::string out;
+        out.reserve((data.size() + 2) / 3 * 4);
+        std::size_t i = 0;
+        for (; i + 2 < data.size(); i += 3)
+        {
+            const std::uint32_t v = (std::uint8_t(data[i]) << 16) | (std::uint8_t(data[i + 1]) << 8) | std::uint8_t(data[i + 2]);
+            out += table[v >> 18];
+            out += table[(v >> 12) & 63];
+            out += table[(v >> 6) & 63];
+            out += table[v & 63];
+        }
+        if (i + 1 == data.size())
+        {
+            const std::uint32_t v = std::uint8_t(data[i]) << 16;
+            out += table[v >> 18];
+            out += table[(v >> 12) & 63];
+            out += "==";
+        }
+        else if (i + 2 == data.size())
+        {
+            const std::uint32_t v = (std::uint8_t(data[i]) << 16) | (std::uint8_t(data[i + 1]) << 8);
+            out += table[v >> 18];
+            out += table[(v >> 12) & 63];
+            out += table[(v >> 6) & 63];
+            out += '=';
+        }
+        return out;
+    }
+
+    std::optional<std::string> base64Decode(std::string_view text)
+    {
+        if (text.size() % 4 != 0)
+            return std::nullopt;
+        auto value = [](char c) -> int {
+            if (c >= 'A' && c <= 'Z') return c - 'A';
+            if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+            if (c >= '0' && c <= '9') return c - '0' + 52;
+            if (c == '+') return 62;
+            if (c == '/') return 63;
+            return -1;
+        };
+        std::string out;
+        out.reserve(text.size() / 4 * 3);
+        for (std::size_t i = 0; i < text.size(); i += 4)
+        {
+            const bool last = i + 4 == text.size();
+            int v[4];
+            int pad = 0;
+            for (int k = 0; k < 4; ++k)
+            {
+                if (text[i + k] == '=' && last && k >= 2)
+                {
+                    v[k] = 0;
+                    ++pad;
+                }
+                else if ((v[k] = value(text[i + k])) < 0 || pad > 0)
+                    return std::nullopt;
+            }
+            const std::uint32_t n = (v[0] << 18) | (v[1] << 12) | (v[2] << 6) | v[3];
+            out += static_cast<char>(n >> 16);
+            if (pad < 2)
+                out += static_cast<char>((n >> 8) & 0xff);
+            if (pad < 1)
+                out += static_cast<char>(n & 0xff);
+        }
+        return out;
+    }
+
+    void startupEntries(std::vector<fs::path>& dataDirs, std::vector<std::string>& scriptFiles)
+    {
+        for (const std::string& id : modIds())
+        {
+            const fs::path dir = sRoot / id;
+            std::vector<std::string> scripts;
+            std::error_code ec;
+            for (fs::directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec))
+            {
+                const std::string name = it->path().filename().string();
+                if (it->is_regular_file(ec) && !it->is_symlink(ec) && validPath(name)
+                    && it->path().extension() == ".omwscripts")
+                    scripts.push_back(name);
+            }
+            if (scripts.empty())
+                continue;
+            std::sort(scripts.begin(), scripts.end());
+            dataDirs.push_back(dir);
+            scriptFiles.insert(scriptFiles.end(), scripts.begin(), scripts.end());
+        }
+    }
+
+    void requestRestart()
+    {
+        sRestart = true;
+    }
+
+    bool restartRequested()
+    {
+        return sRestart;
+    }
+
+    bool canRelaunch()
+    {
+#if defined(_WIN32) || (defined(__linux__) && !defined(__ANDROID__))
+        return true;
+#else
+        return false;
+#endif
+    }
+
+    bool relaunch(int argc, char** argv)
+    {
+#ifdef _WIN32
+        (void)argc;
+        (void)argv;
+        STARTUPINFOW startup = {};
+        startup.cb = sizeof(startup);
+        PROCESS_INFORMATION info = {};
+        std::wstring command = GetCommandLineW();
+        if (!CreateProcessW(nullptr, command.data(), nullptr, nullptr, FALSE, 0, nullptr, nullptr, &startup, &info))
+            return false;
+        CloseHandle(info.hProcess);
+        CloseHandle(info.hThread);
+        return true;
+#elif defined(__linux__) && !defined(__ANDROID__)
+        std::vector<char*> args(argv, argv + argc);
+        args.push_back(nullptr);
+        execv("/proc/self/exe", args.data()); // (only returns when it failed)
+        return false;
+#else
+        (void)argc;
+        (void)argv;
+        return false;
+#endif
+    }
+}
diff --git a/components/misc/clientmods.hpp b/components/misc/clientmods.hpp
new file mode 100644
index 0000000000..e3b83a04c1
--- /dev/null
+++ b/components/misc/clientmods.hpp
@@ -0,0 +1,74 @@
+#ifndef OPENMW_COMPONENTS_MISC_CLIENTMODS_H
+#define OPENMW_COMPONENTS_MISC_CLIENTMODS_H
+
+#include <cstdint>
+#include <filesystem>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace Misc::ClientMods
+{
+    // Client mods are folders of Lua scripts (and the textures, sounds and translations they use) that a server hands out.
+    // They live in <root>/<id>/..., each folder is added to the game's data directories at startup and its *.omwscripts
+    // files are loaded like the built-in ones. Everything here is checked: names, file types and sizes are limited, and a
+    // file is only written when its SHA-256 matches the one it was announced with.
+    constexpr std::size_t sMaxFileSize = 8 * 1024 * 1024;
+    constexpr std::size_t sMaxModSize = 64 * 1024 * 1024;
+    constexpr std::size_t sMaxFilesPerMod = 500;
+    constexpr std::size_t sMaxMods = 32;
+
+    struct File
+    {
+        std::string mPath; // relative to the mod folder, '/' separated
+        std::uint64_t mSize = 0;
+        std::string mHash; // SHA-256, lowercase hex
+    };
+
+    struct Mod
+    {
+        std::string mId;
+        std::vector<File> mFiles;
+    };
+
+    // The folder everything lives in. Set once at startup; empty means the feature is off.
+    void setRoot(const std::filesystem::path& root);
+    const std::filesystem::path& root();
+
+    // [a-z0-9_-], 1 to 40 characters
+    bool validId(std::string_view id);
+    // A relative path of at most 6 parts made of letters, digits and . _ - (no "..", no hidden files), ending in a file
+    // type a client mod may carry
+    bool validPath(std::string_view path);
+
+    // What is installed (or, for a server, what it hands out): every mod with its files and their hashes.
+    std::vector<Mod> installed();
+
+    // Reads one installed file. Empty if there is no such file.
+    std::optional<std::string> read(std::string_view id, std::string_view path);
+
+    // Writes a file after checking the name, the size limits and that its SHA-256 equals expectedHash. Returns an error
+    // message, or an empty string on success.
+    std::string write(std::string_view id, std::string_view path, std::string_view data, std::string_view expectedHash);
+
+    // Deletes one file of a mod, or the whole mod if path is empty.
+    std::string remove(std::string_view id, std::string_view path);
+
+    // base64 (standard alphabet, padded), for carrying binary files over a line based connection
+    std::string base64Encode(std::string_view data);
+    std::optional<std::string> base64Decode(std::string_view text);
+
+    // The data directories and *.omwscripts files of the installed mods, for the engine to load at startup.
+    void startupEntries(std::vector<std::filesystem::path>& dataDirs, std::vector<std::string>& scriptFiles);
+
+    // Asks the program to start itself again once it has shut down (see relaunch).
+    void requestRestart();
+    bool restartRequested();
+    // Whether relaunch can work on this platform
+    bool canRelaunch();
+    // Starts the program again with the same arguments. Returns false where that is not possible.
+    bool relaunch(int argc, char** argv);
+}
+
+#endif
diff --git a/components/misc/sha256.cpp b/components/misc/sha256.cpp
new file mode 100644
index 0000000000..c4de7f7ff6
--- /dev/null
+++ b/components/misc/sha256.cpp
@@ -0,0 +1,99 @@
+#include "sha256.hpp"
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+
+namespace Misc
+{
+    namespace
+    {
+        constexpr std::array<std::uint32_t, 64> sK = {
+            0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98,
+            0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
+            0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8,
+            0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+            0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819,
+            0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
+            0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7,
+            0xc67178f2
+        };
+
+        constexpr std::uint32_t rotr(std::uint32_t x, int n)
+        {
+            return (x >> n) | (x << (32 - n));
+        }
+
+        void compress(std::array<std::uint32_t, 8>& h, const unsigned char* block)
+        {
+            std::array<std::uint32_t, 64> w;
+            for (int i = 0; i < 16; ++i)
+                w[i] = (std::uint32_t(block[i * 4]) << 24) | (std::uint32_t(block[i * 4 + 1]) << 16)
+                    | (std::uint32_t(block[i * 4 + 2]) << 8) | std::uint32_t(block[i * 4 + 3]);
+            for (int i = 16; i < 64; ++i)
+            {
+                const std::uint32_t s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
+                const std::uint32_t s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
+                w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+            }
+            std::uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7];
+            for (int i = 0; i < 64; ++i)
+            {
+                const std::uint32_t s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
+                const std::uint32_t ch = (e & f) ^ (~e & g);
+                const std::uint32_t t1 = hh + s1 + ch + sK[i] + w[i];
+                const std::uint32_t s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
+                const std::uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
+                const std::uint32_t t2 = s0 + maj;
+                hh = g;
+                g = f;
+                f = e;
+                e = d + t1;
+                d = c;
+                c = b;
+                b = a;
+                a = t1 + t2;
+            }
+            h[0] += a;
+            h[1] += b;
+            h[2] += c;
+            h[3] += d;
+            h[4] += e;
+            h[5] += f;
+            h[6] += g;
+            h[7] += hh;
+        }
+    }
+
+    std::string sha256Hex(std::string_view data)
+    {
+        std::array<std::uint32_t, 8> h = { 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c,
+            0x1f83d9ab, 0x5be0cd19 };
+        const auto* bytes = reinterpret_cast<const unsigned char*>(data.data());
+        std::size_t full = data.size() / 64;
+        for (std::size_t i = 0; i < full; ++i)
+            compress(h, bytes + i * 64);
+
+        // the rest, the 0x80 marker and the length in bits (one or two more blocks)
+        unsigned char tail[128] = {};
+        const std::size_t rest = data.size() - full * 64;
+        if (rest > 0)
+            std::memcpy(tail, bytes + full * 64, rest);
+        tail[rest] = 0x80;
+        const std::size_t tailSize = rest < 56 ? 64 : 128;
+        const std::uint64_t bits = static_cast<std::uint64_t>(data.size()) * 8;
+        for (int i = 0; i < 8; ++i)
+            tail[tailSize - 1 - i] = static_cast<unsigned char>(bits >> (8 * i));
+        compress(h, tail);
+        if (tailSize == 128)
+            compress(h, tail + 64);
+
+        static constexpr char digits[] = "0123456789abcdef";
+        std::string result;
+        result.reserve(64);
+        for (std::uint32_t word : h)
+            for (int shift = 28; shift >= 0; shift -= 4)
+                result += digits[(word >> shift) & 0xf];
+        return result;
+    }
+}
