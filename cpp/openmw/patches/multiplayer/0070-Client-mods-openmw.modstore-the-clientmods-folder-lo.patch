diff --git a/apps/openmw/mwlua/modstorebindings.cpp b/apps/openmw/mwlua/modstorebindings.cpp
new file mode 100644
index 0000000000..c106ce9541
--- /dev/null
+++ b/apps/openmw/mwlua/modstorebindings.cpp
@@ -0,0 +1,82 @@
+#include "modstorebindings.hpp"
+
+#include <optional>
+#include <string>
+
+#include <components/debug/debuglog.hpp>
+#include <components/lua/bindfunction.hpp>
+#include <components/lua/luastate.hpp>
+#include <components/lua/readonlytables.hpp>
+#include <components/misc/clientmods.hpp>
+#include <components/misc/sha256.hpp>
+
+#include "../mwbase/environment.hpp"
+#include "../mwbase/statemanager.hpp"
+
+#include "context.hpp"
+
+namespace MWLua
+{
+    namespace
+    {
+        // Everything that is installed as JSON: [{"id":"x","files":[{"p":"a.lua","s":12,"h":"<sha256>"}]}].
+        // (Names are limited to letters, digits and . _ - /, so nothing needs escaping.)
+        std::string manifestJson()
+        {
+            std::string json = "[";
+            bool firstMod = true;
+            for (const Misc::ClientMods::Mod& mod : Misc::ClientMods::installed())
+            {
+                json += firstMod ? "" : ",";
+                firstMod = false;
+                json += "{\"id\":\"" + mod.mId + "\",\"files\":[";
+                bool firstFile = true;
+                for (const Misc::ClientMods::File& file : mod.mFiles)
+                {
+                    json += firstFile ? "" : ",";
+                    firstFile = false;
+                    json += "{\"p\":\"" + file.mPath + "\",\"s\":" + std::to_string(file.mSize) + ",\"h\":\"" + file.mHash
+                        + "\"}";
+                }
+                json += "]}";
+            }
+            return json + "]";
+        }
+    }
+
+    Lua::Table initModstorePackage(const Context& context)
+    {
+        lua_State* state = context.unsafeState();
+        const Lua::PackageBuilder api(state, "modstore");
+
+        // The installed mods and their files, with SHA-256 hashes, as JSON text
+        api.function("manifest", []() { return manifestJson(); });
+        // One installed file, or nil
+        api.function("read", [](std::string_view id, std::string_view path) -> std::optional<std::string> {
+            return Misc::ClientMods::read(id, path);
+        });
+        // Stores a file; fails (returns the reason) unless the name, size and SHA-256 are right. "" when it worked.
+        api.function("write",
+            [](std::string_view id, std::string_view path, std::string_view data, std::string_view hash) {
+                return Misc::ClientMods::write(id, path, data, hash);
+            });
+        // Deletes a file of a mod, or the whole mod when the path is empty. "" when it worked.
+        api.function("remove", [](std::string_view id, std::string_view path) { return Misc::ClientMods::remove(id, path); });
+        api.function("sha256", [](std::string_view data) { return Misc::sha256Hex(data); });
+        api.function("base64Encode", [](std::string_view data) { return Misc::ClientMods::base64Encode(data); });
+        api.function("base64Decode", [](std::string_view text) -> std::optional<std::string> {
+            return Misc::ClientMods::base64Decode(text);
+        });
+        // Quits and starts the game again, so the installed mods are loaded. Returns false (and does nothing) where the game
+        // cannot start itself again.
+        api.function("restart", []() {
+            if (!Misc::ClientMods::canRelaunch())
+                return false;
+            Misc::ClientMods::requestRestart();
+            MWBase::Environment::get().getStateManager()->requestQuit();
+            return true;
+        });
+
+        return api.readOnly();
+    }
+}
