From d121b97b25a2e11caf432e2c40a0766c4f398122 Mon Sep 17 00:00:00 2001
From: Duron27 <duron27@gmail.com>
Date: Thu, 15 Oct 2026 11:47:09 -0400
Subject: [PATCH 60/61] Load the multiplayer server's window as a module so
 --cli-only needs no Qt

The Qt window code was linked into openmw-mp-server, so the loader needed
the Qt libraries before main() ran. The window is now openmw-mp-server-gui,
a module loaded only when a window is opened; without it or Qt the server
falls back to the terminal. The bundle includes the module.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 apps/mpserver/CMakeLists.txt | 50 ++++++++++++++++++------------------
 apps/mpserver/bundle.cmake   |  8 ++++++
 apps/mpserver/gui.cpp        |  8 +++++-
 apps/mpserver/gui.hpp        |  4 ++-
 apps/mpserver/main.cpp       | 46 +++++++++++++++++++++++++++++++++
 5 files changed, 89 insertions(+), 27 deletions(-)

diff --git a/apps/mpserver/CMakeLists.txt b/apps/mpserver/CMakeLists.txt
index 066fa6cbfb..814a808bce 100644
--- a/apps/mpserver/CMakeLists.txt
+++ b/apps/mpserver/CMakeLists.txt
@@ -5,11 +5,17 @@ find_package(Threads REQUIRED)
 
 option(BUILD_MP_SERVER_GUI "Give openmw-mp-server a window (needs Qt Widgets)" ON)
 
-set(MPSERVER_SOURCES
-    main.cpp
+# The server itself never links Qt: the window is a separate module (openmw-mp-server-gui) that the program loads only
+# when it opens one, so --cli-only and headless machines run without any Qt libraries installed.
+add_library(mpserver-core STATIC
     servercore.cpp
     ${CMAKE_SOURCE_DIR}/components/net/sockets.cpp
 )
+target_include_directories(mpserver-core PRIVATE ${CMAKE_SOURCE_DIR})
+target_link_libraries(mpserver-core PUBLIC Luau.VM Luau.Compiler Boost::headers Threads::Threads)
+if (WIN32)
+    target_link_libraries(mpserver-core PUBLIC ws2_32 mswsock)
+endif()
 
 set(MPSERVER_QT_FOUND OFF)
 if (BUILD_MP_SERVER_GUI)
@@ -21,29 +27,23 @@ if (BUILD_MP_SERVER_GUI)
     endif()
 endif()
 
-if (MPSERVER_QT_FOUND)
-    list(APPEND MPSERVER_SOURCES gui.cpp)
-endif()
-
-add_executable(openmw-mp-server ${MPSERVER_SOURCES})
-
+add_executable(openmw-mp-server main.cpp)
 target_include_directories(openmw-mp-server PRIVATE ${CMAKE_SOURCE_DIR})
-
-target_link_libraries(openmw-mp-server
-    Luau.VM
-    Luau.Compiler
-    Boost::headers
-    Threads::Threads
-)
+target_link_libraries(openmw-mp-server mpserver-core ${CMAKE_DL_LIBS})
 
 if (MPSERVER_QT_FOUND)
+    add_library(openmw-mp-server-gui MODULE gui.cpp)
+    set_target_properties(openmw-mp-server-gui PROPERTIES AUTOMOC OFF) # (no signals or slots are declared)
+    target_include_directories(openmw-mp-server-gui PRIVATE ${CMAKE_SOURCE_DIR})
+    # (the module uses the server's classes from the program that loads it, so the program exports its symbols)
+    set_target_properties(openmw-mp-server PROPERTIES ENABLE_EXPORTS ON)
+    target_link_libraries(openmw-mp-server-gui Qt6::Widgets)
+    if (WIN32)
+        target_link_libraries(openmw-mp-server-gui openmw-mp-server)
+    endif()
+    add_dependencies(openmw-mp-server openmw-mp-server-gui)
     target_compile_definitions(openmw-mp-server PRIVATE MPSERVER_WITH_GUI)
-    target_link_libraries(openmw-mp-server Qt6::Widgets)
-    set_target_properties(openmw-mp-server PROPERTIES AUTOMOC OFF) # (no signals or slots are declared)
-endif()
-
-if (WIN32)
-    target_link_libraries(openmw-mp-server ws2_32 mswsock)
+    install(TARGETS openmw-mp-server-gui DESTINATION ${CMAKE_INSTALL_LIBDIR}/openmw-mp)
 endif()
 
 install(TARGETS openmw-mp-server)
@@ -59,15 +59,15 @@ endif ()
 set(MPSERVER_BUNDLE_NAME "openmw-mp-server-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
 add_custom_target(mpserver-bundle
     COMMAND ${CMAKE_COMMAND}
-        "-DSERVER=$<TARGET_FILE:openmw-mp-server>" "-DMULTIPLAYER_DIR=${MPSERVER_BUNDLE_FOLDER}"
+        "-DSERVER=$<TARGET_FILE:openmw-mp-server>" "-DGUI_MODULE=$<$<BOOL:${MPSERVER_QT_FOUND}>:$<TARGET_FILE:openmw-mp-server-gui>>" "-DMULTIPLAYER_DIR=${MPSERVER_BUNDLE_FOLDER}"
         "-DFILES_DIR=${CMAKE_CURRENT_SOURCE_DIR}" "-DOUT_DIR=${CMAKE_BINARY_DIR}" "-DNAME=${MPSERVER_BUNDLE_NAME}"
         "-DSTRIP=${CMAKE_STRIP}" -P "${CMAKE_CURRENT_SOURCE_DIR}/bundle.cmake"
-    DEPENDS openmw-mp-server
+    DEPENDS openmw-mp-server $<$<BOOL:${MPSERVER_QT_FOUND}>:openmw-mp-server-gui>
     COMMENT "Making ${MPSERVER_BUNDLE_NAME}.zip"
     VERBATIM)
 if (MPSERVER_QT_FOUND)
-    message(STATUS "openmw-mp-server has a window: its bundle needs the Qt 6 libraries on the machine it runs on "
-        "(-DBUILD_MP_SERVER_GUI=OFF makes one that needs nothing but the C++ runtime)")
+    message(STATUS "openmw-mp-server has a window: its bundle holds the window module, which needs the Qt 6 libraries "
+        "(without them the server falls back to the terminal)")
 endif ()
 
 # Where the server looks for the mod when it is installed (<prefix>/share/openmw-mp/mod and .../server/server.lua)
diff --git a/apps/mpserver/bundle.cmake b/apps/mpserver/bundle.cmake
index 0d646bd1ac..e1127f88c5 100644
--- a/apps/mpserver/bundle.cmake
+++ b/apps/mpserver/bundle.cmake
@@ -19,6 +19,14 @@ if (STRIP AND NOT STRIP MATCHES "NOTFOUND" AND NOT WIN32)
     execute_process(COMMAND "${STRIP}" "${dir}/${exe}" RESULT_VARIABLE strip_result ERROR_QUIET)
 endif ()
 
+if (GUI_MODULE AND EXISTS "${GUI_MODULE}")
+    file(COPY "${GUI_MODULE}" DESTINATION "${dir}")
+    get_filename_component(guiname "${GUI_MODULE}" NAME)
+    if (STRIP AND NOT STRIP MATCHES "NOTFOUND" AND NOT WIN32)
+        execute_process(COMMAND "${STRIP}" "${dir}/${guiname}" RESULT_VARIABLE strip_result ERROR_QUIET)
+    endif ()
+endif ()
+
 foreach (part mod server README.md)
     if (NOT EXISTS "${MULTIPLAYER_DIR}/${part}")
         message(FATAL_ERROR "bundle.cmake: ${MULTIPLAYER_DIR}/${part} is missing")
diff --git a/apps/mpserver/gui.cpp b/apps/mpserver/gui.cpp
index be58c64eb8..72bea9d3fe 100644
--- a/apps/mpserver/gui.cpp
+++ b/apps/mpserver/gui.cpp
@@ -444,7 +444,13 @@ namespace
     };
 }
 
-int runWindow(ServerCore& core, int argc, char** argv, std::atomic<bool>& stopFlag)
+#ifdef _WIN32
+#define MPSERVER_EXPORT extern "C" __declspec(dllexport)
+#else
+#define MPSERVER_EXPORT extern "C" __attribute__((visibility("default")))
+#endif
+
+MPSERVER_EXPORT int mpserverRunWindow(ServerCore& core, int argc, char** argv, std::atomic<bool>& stopFlag)
 {
     QApplication app(argc, argv);
     MainWindow window(core);
diff --git a/apps/mpserver/gui.hpp b/apps/mpserver/gui.hpp
index 44a8c63505..fb4c80577e 100644
--- a/apps/mpserver/gui.hpp
+++ b/apps/mpserver/gui.hpp
@@ -7,6 +7,8 @@
 
 // Opens the server window, starts the server and runs until the window is closed, the server is told to stop (the quit
 // command) or stopFlag is set (Ctrl+C). Returns the exit code.
-int runWindow(MpServer::ServerCore& core, int argc, char** argv, std::atomic<bool>& stopFlag);
+// It is exported by the window module (openmw-mp-server-gui), which the program loads only when it wants a window.
+using RunWindowFn = int (*)(MpServer::ServerCore& core, int argc, char** argv, std::atomic<bool>& stopFlag);
+constexpr const char* kRunWindowSymbol = "mpserverRunWindow";
 
 #endif
diff --git a/apps/mpserver/main.cpp b/apps/mpserver/main.cpp
index 1d3f9f5dc2..450cd59cb6 100644
--- a/apps/mpserver/main.cpp
+++ b/apps/mpserver/main.cpp
@@ -17,6 +17,11 @@
 #include "servercore.hpp"
 #ifdef MPSERVER_WITH_GUI
 #include "gui.hpp"
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#endif
 #endif
 
 namespace
@@ -167,6 +172,36 @@ namespace
 #endif
     }
 
+#ifdef MPSERVER_WITH_GUI
+    // Loads the window module next to the program; null (with the reason in why) if it or Qt is not there.
+    RunWindowFn loadWindow(const std::filesystem::path& exeDir, std::string& why)
+    {
+#ifdef _WIN32
+        const std::filesystem::path path = exeDir / "openmw-mp-server-gui.dll";
+        HMODULE lib = LoadLibraryW(path.c_str());
+        if (!lib)
+        {
+            why = "could not load " + path.string();
+            return nullptr;
+        }
+        auto fn = reinterpret_cast<RunWindowFn>(reinterpret_cast<void*>(GetProcAddress(lib, kRunWindowSymbol)));
+#else
+        const std::filesystem::path path = exeDir / "libopenmw-mp-server-gui.so";
+        void* lib = dlopen(path.c_str(), RTLD_NOW);
+        if (!lib)
+        {
+            const char* e = dlerror();
+            why = e ? e : "could not load " + path.string();
+            return nullptr;
+        }
+        auto fn = reinterpret_cast<RunWindowFn>(dlsym(lib, kRunWindowSymbol));
+#endif
+        if (!fn)
+            why = path.string() + " has no window entry point";
+        return fn;
+    }
+#endif
+
     // The terminal: lines typed by the operator are the console.
     int runTerminal(MpServer::ServerCore& core)
     {
@@ -258,9 +293,20 @@ int main(int argc, char** argv)
 
     bool window = false;
 #ifdef MPSERVER_WITH_GUI
+    RunWindowFn runWindow = nullptr;
     window = !gCliOnly && haveDisplay();
     if (!gCliOnly && !window)
         std::puts("[server] no display found: running in the terminal (use --cli-only to skip this check)");
+    if (window)
+    {
+        std::string why;
+        runWindow = loadWindow(executableDir(argv[0]), why);
+        if (!runWindow)
+        {
+            std::printf("[server] no window (%s): running in the terminal\n", why.c_str());
+            window = false;
+        }
+    }
 #else
     if (!gCliOnly)
         std::puts("[server] this build has no window: running in the terminal");
