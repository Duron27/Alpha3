+                for (const std::string& sub : only)
+                    starts.push_back(dir / sub);
+            for (const fs::path& start : starts)
+            for (fs::recursive_directory_iterator it(start, fs::directory_options::none, ec), end; !ec && it != end;
                  it.increment(ec))
             {
                 if (!it->is_regular_file(ec) || it->is_symlink(ec))
@@ -122,18 +132,43 @@ namespace Misc::ClientMods
             return files;
         }
 
+        bool isExtra(std::string_view id)
+        {
+            std::error_code ec;
+            return !sExtraId.empty() && id == sExtraId && !fs::is_directory(sRoot / std::string(id), ec);
+        }
+
+        std::string extraStub()
+        {
+            return "# The client scripts of this server's own mod, kept in step with the server. They replace the copies built into the\n"
+                   "# game, which already registers them, so nothing is listed here.\n";
+        }
+
+        std::vector<File> extraFiles(bool withHashes)
+        {
+            std::vector<File> files = filesOf(sExtraDir, withHashes, sExtraFolders);
+            File stub;
+            stub.mPath = sExtraId + ".omwscripts";
+            stub.mSize = extraStub().size();
+            if (withHashes)
+                stub.mHash = sha256Hex(extraStub());
+            files.push_back(std::move(stub));
+            std::sort(files.begin(), files.end(), [](const File& a, const File& b) { return a.mPath < b.mPath; });
+            return files;
+        }
+
         std::vector<std::string> modIds()
         {
             std::vector<std::string> ids;
-            if (sRoot.empty())
-                return ids;
             std::error_code ec;
-            for (fs::directory_iterator it(sRoot, ec), end; !ec && it != end; it.increment(ec))
+            for (fs::directory_iterator it(sRoot, ec), end; !sRoot.empty() && !ec && it != end; it.increment(ec))
             {
                 const std::string id = it->path().filename().string();
                 if (it->is_directory(ec) && !it->is_symlink(ec) && validId(id))
                     ids.push_back(id);
             }
+            if (!sExtraId.empty() && !fs::is_directory(sRoot / sExtraId, ec))
+                ids.push_back(sExtraId);
             std::sort(ids.begin(), ids.end());
             if (ids.size() > sMaxMods)
                 ids.resize(sMaxMods);
@@ -154,6 +189,12 @@ namespace Misc::ClientMods
         sRoot = root;
     }
 
+    void setExtraMod(const std::string& id, const fs::path& dir)
+    {
+        sExtraId = validId(id) ? id : std::string();
+        sExtraDir = dir;
+    }
+
     const fs::path& root()
     {
         return sRoot;
@@ -198,7 +239,7 @@ namespace Misc::ClientMods
         {
             Mod mod;
             mod.mId = id;
-            mod.mFiles = filesOf(sRoot / id, true);
+            mod.mFiles = isExtra(id) ? extraFiles(true) : filesOf(sRoot / id, true);
             if (!mod.mFiles.empty())
                 mods.push_back(std::move(mod));
         }
@@ -229,7 +270,23 @@ namespace Misc::ClientMods
 
     std::optional<std::string> read(std::string_view id, std::string_view path)
     {
-        if (sRoot.empty() || !validId(id) || !validPath(path))
+        if (!validId(id) || !validPath(path))
+            return std::nullopt;
+        if (isExtra(id))
+        {
+            if (path == sExtraId + ".omwscripts")
+                return extraStub();
+            const std::size_t slash = path.find('/');
+            if (slash == std::string_view::npos
+                || std::find(sExtraFolders.begin(), sExtraFolders.end(), std::string(path.substr(0, slash))) == sExtraFolders.end())
+                return std::nullopt;
+            const fs::path extra = sExtraDir / std::string(path);
+            std::error_code ec;
+            if (!fs::is_regular_file(extra, ec) || fs::is_symlink(extra, ec))
+                return std::nullopt;
+            return readWhole(extra, sMaxFileSize);
+        }
+        if (sRoot.empty())
             return std::nullopt;
         const fs::path file = sRoot / std::string(id) / std::string(path);
         std::error_code ec;
diff --git a/components/misc/clientmods.hpp b/components/misc/clientmods.hpp
