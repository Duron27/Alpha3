From 01ea89198b76a4aacc83b3b108e62ae59d9e9b13 Mon Sep 17 00:00:00 2001
From: Duron27 <duron27@gmail.com>
Date: Thu, 15 Oct 2026 15:32:10 -0400
Subject: [PATCH] The server hands out the multiplayer mod's own client scripts
 straight from its mod folder (stored once), and its bundle has a clientmods
 folder

- clientmods: setExtraMod offers a folder the server already has (scripts, l10n, textures) as one more mod, plus an empty
  <id>.omwscripts so the client adds the folder to its data directories without loading anything twice. A real folder of
  that name in clientmods takes over. The mod's own mp.omwscripts and anything else in the folder is never offered
- openmw-mp-server serves <mod> as "multiplayer", so the bundle no longer holds a second copy of the scripts
- the bundle gets an empty clientmods folder with a note; README and a unit test

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 apps/components_tests/misc/testclientmods.cpp | 45 ++++++++++++
 apps/mpserver/bundle.cmake                    | 12 ++++
 apps/mpserver/servercore.cpp                  |  1 +
 components/misc/clientmods.cpp                | 71 +++++++++++++++++--
 components/misc/clientmods.hpp                |  5 ++
 multiplayer/README.md                         |  3 +
 6 files changed, 130 insertions(+), 7 deletions(-)

diff --git a/apps/components_tests/misc/testclientmods.cpp b/apps/components_tests/misc/testclientmods.cpp
index f85a9c022d..520957775b 100644
--- a/apps/components_tests/misc/testclientmods.cpp
+++ b/apps/components_tests/misc/testclientmods.cpp
@@ -4,6 +4,7 @@
 #include <gtest/gtest.h>
 
 #include <filesystem>
+#include <fstream>
 
 namespace
 {
@@ -102,4 +103,48 @@ namespace
         std::filesystem::remove_all(root);
         CM::setRoot({});
     }
+
+    TEST(MiscClientMods, extraModServedFromAFolder)
+    {
+        const std::filesystem::path base = std::filesystem::temp_directory_path() / "omw_clientmods_extra";
+        std::filesystem::remove_all(base);
+        std::filesystem::create_directories(base / "mod" / "scripts" / "mp");
+        std::filesystem::create_directories(base / "mod" / "secret");
+        std::filesystem::create_directories(base / "root");
+        auto put = [](const std::filesystem::path& p, const std::string& text) { std::ofstream(p, std::ios::binary) << text; };
+        put(base / "mod" / "scripts" / "mp" / "a.lua", "print(1)");
+        put(base / "mod" / "mp.omwscripts", "GLOBAL: scripts/mp/a.lua\n"); // must not be offered: it would load the scripts twice
+        put(base / "mod" / "secret" / "s.lua", "x");
+        CM::setRoot(base / "root");
+        CM::setExtraMod("multiplayer", base / "mod");
+
+        const auto mods = CM::installed();
+        ASSERT_EQ(mods.size(), 1u);
+        EXPECT_EQ(mods[0].mId, "multiplayer");
+        ASSERT_EQ(mods[0].mFiles.size(), 2u);
+        EXPECT_EQ(mods[0].mFiles[0].mPath, "multiplayer.omwscripts");
+        EXPECT_EQ(mods[0].mFiles[1].mPath, "scripts/mp/a.lua");
+        EXPECT_EQ(mods[0].mFiles[1].mHash, Misc::sha256Hex("print(1)"));
+        EXPECT_EQ(CM::read("multiplayer", "scripts/mp/a.lua"), "print(1)");
+        const auto stub = CM::read("multiplayer", "multiplayer.omwscripts");
+        ASSERT_TRUE(stub);
+        EXPECT_EQ(Misc::sha256Hex(*stub), mods[0].mFiles[0].mHash);
+        EXPECT_EQ(stub->find("GLOBAL"), std::string::npos);
+        EXPECT_FALSE(CM::read("multiplayer", "mp.omwscripts"));
+        EXPECT_FALSE(CM::read("multiplayer", "secret/s.lua"));
+
+        // a real folder of the same name takes over
+        put(base / "root" / "x", "");
+        std::filesystem::remove(base / "root" / "x");
+        std::filesystem::create_directories(base / "root" / "multiplayer");
+        EXPECT_EQ(CM::write("multiplayer", "b.lua", "y", Misc::sha256Hex("y")), "");
+        const auto own = CM::installed();
+        ASSERT_EQ(own.size(), 1u);
+        ASSERT_EQ(own[0].mFiles.size(), 1u);
+        EXPECT_EQ(own[0].mFiles[0].mPath, "b.lua");
+
+        std::filesystem::remove_all(base);
+        CM::setExtraMod("", {});
+        CM::setRoot({});
+    }
 }
diff --git a/apps/mpserver/bundle.cmake b/apps/mpserver/bundle.cmake
index e1127f88c5..72ed96dbb4 100644
--- a/apps/mpserver/bundle.cmake
+++ b/apps/mpserver/bundle.cmake
@@ -34,6 +34,18 @@ foreach (part mod server README.md)
     file(COPY "${MULTIPLAYER_DIR}/${part}" DESTINATION "${dir}/multiplayer")
 endforeach ()
 
+# The client mods this server hands out: the multiplayer mod's own client scripts are served straight from the mod folder
+# (so they are stored once), and any mods kept in multiplayer/clientmods are added.
+if (EXISTS "${MULTIPLAYER_DIR}/clientmods")
+    file(COPY "${MULTIPLAYER_DIR}/clientmods" DESTINATION "${dir}/multiplayer")
+endif ()
+# ...and an empty folder for the operator's own: clientmods/<name>/<name>.omwscripts, scripts/...
+file(MAKE_DIRECTORY "${dir}/clientmods")
+file(WRITE "${dir}/clientmods/README.txt"
+    "Client mods this server hands out go here, one folder each:  clientmods/<name>/<name>.omwscripts, scripts/..., textures/...\n"
+    "Players are asked before anything is installed, and only the files that differ are downloaded. The multiplayer mod's own\n"
+    "client scripts are handed out automatically from multiplayer/mod. See multiplayer/README.md (Client mods kept on the server).\n")
+
 file(COPY "${FILES_DIR}/start-server.sh" DESTINATION "${dir}" FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
     GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
 # (a batch file wants Windows line endings, whatever git did to the one in the source tree)
