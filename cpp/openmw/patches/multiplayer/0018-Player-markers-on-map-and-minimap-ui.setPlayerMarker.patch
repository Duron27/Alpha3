+        // Markers for other players on the map and minimap. Each entry: { cell = '' for the exterior or an
+        // interior cell name, x, y (world position), name }. Replaces the previous list; not saved.
+        api.function("setPlayerMarkers", [](const Lua::TableView& list) {
+            std::vector<ESM::CustomMarker> markers;
+            list.forEach([&](const Lua::ValueView&, const Lua::ValueView& value) {
+                const Lua::TableView entry = value.asTable();
+                ESM::CustomMarker marker;
+                marker.mWorldX = entry.getOptional<float>("x").value_or(0.f);
+                marker.mWorldY = entry.getOptional<float>("y").value_or(0.f);
+                marker.mNote = entry.getOptional<std::string>("name").value_or(std::string());
+                const std::string cell = entry.getOptional<std::string>("cell").value_or(std::string());
+                if (cell.empty())
+                    marker.mCell = ESM::RefId::esm3ExteriorCell(static_cast<int>(std::floor(marker.mWorldX / 8192.f)),
+                        static_cast<int>(std::floor(marker.mWorldY / 8192.f)));
+                else
+                    marker.mCell = ESM::RefId::stringRefId(cell);
+                markers.push_back(std::move(marker));
+            });
+            MWBase::Environment::get().getWindowManager()->setPlayerMarkers(std::move(markers));
+        });
         api.function("showMessage",
             [luaManager = context.mLuaManager](std::string_view message, std::optional<Lua::TableView> options) {
                 MWGui::ShowInDialogueMode mode = MWGui::ShowInDialogueMode_IfPossible;
