 local function pushInput(force)
     inputData.atk, inputData.seq, inputData.jseq = lastAttack, attackSeq, jumpSeq
-    local sig = table.concat({ tostring(inputData.sneak), tostring(inputData.reading), tostring(inputData.mode), attackSeq, releaseSeq, jumpSeq,
+    local sig = table.concat({ tostring(inputData.sneak), tostring(inputData.reading), tostring(inputData.mode), tostring(inputData.fly), attackSeq, releaseSeq, jumpSeq,
         math.floor(inputData.pitch * 20 + 0.5) }, '|')
     local t = core.getRealTime()
     if force or sig ~= lastInputSig or t - inputSentAt > 1 then
         lastInputSig, inputSentAt = sig, t
-        core.sendGlobalEvent('MpInput', { sneak = inputData.sneak, reading = inputData.reading, pitch = inputData.pitch, mode = inputData.mode,
+        core.sendGlobalEvent('MpInput', { sneak = inputData.sneak, reading = inputData.reading, pitch = inputData.pitch, mode = inputData.mode, fly = inputData.fly,
             atk = lastAttack, seq = attackSeq, jseq = jumpSeq, rkind = releaseKind, rseq = releaseSeq, str = releaseStrength })
     end
 end
@@ -666,7 +667,17 @@ return {
             end
             wasUsing = using
             local air = not types.Actor.isOnGround(self) and not types.Actor.isSwimming(self)
-            if air and not wasAir then jumpSeq = jumpSeq + 1 end
+            -- a jump is a take-off after standing on the ground for a moment; flickering on and off the ground while
+            -- floating (levitation, flying cheats) is not a string of jumps
+            if air then
+                if not wasAir and groundTime >= 0.1 then jumpSeq = jumpSeq + 1 end
+                groundTime = 0
+                airTime = airTime + dt
+            else
+                groundTime = groundTime + dt
+                airTime = 0
+            end
+            inputData.fly = airTime >= 0.8 -- off the ground for good (levitation, flying), not just a jump
             wasAir = air
             inputData.sneak = self.controls.sneak and true or false
             pushInput(false)
diff --git a/multiplayer/mod/scripts/mp/remote.lua b/multiplayer/mod/scripts/mp/remote.lua
index cef69a1f04..ecd831aea3 100644
--- a/multiplayer/mod/scripts/mp/remote.lua
+++ b/multiplayer/mod/scripts/mp/remote.lua
@@ -12,6 +12,35 @@ local anim = require('openmw.animation')
 
 local Actor = types.Actor
 
+-- A player who floats in place (levitating, flying) is shown by giving the avatar the effect of a levitation potion, so
+-- it hangs there instead of falling and being put back. Whichever of these potions the loaded content has.
+local LEVITATE_POTIONS = { 'p_levitation_s', 'p_levitation_q', 'p_levitation_e', 'p_levitation_c', 'p_levitation_b' }
+local floatOn, floatCheck = false, 0
+
+local function levitatePotion()
+    for _, id in ipairs(LEVITATE_POTIONS) do
+        local ok, rec = pcall(function() return types.Potion.records[id] end)
+        if ok and rec then return id end
+    end
+    return nil
+end
+
+local function applyFloat(on)
+    local id = levitatePotion()
+    if not id then return end
+    local spells = Actor.activeSpells(self)
+    pcall(function()
+        local active = spells:isSpellActive(id)
+        if on and not active then
+            spells:add({ id = id, effects = { 0 }, quiet = true })
+        elseif not on and active then
+            for _, spell in pairs(spells) do
+                if spell.id == id and spell.temporary then spells:remove(spell.activeSpellId) end
+            end
+        end
+    end)
+end
+
 local WALK_START, WALK_STOP = 18, 6 -- distance hysteresis (game units); the target is already extrapolated
 local RUN_SPEED = 230 -- the player's speed (units/s) above which they are shown running
 local SNAP_DIST = 350
@@ -270,6 +299,13 @@ return {
         end,
         onActive = function() if not aggro then self:enableAI(false); aiOff = true end end,
         onUpdate = function(dt)
+            if floatOn then
+                floatCheck = floatCheck - dt
+                if floatCheck <= 0 then
+                    floatCheck = 2 -- (the potion wears off after a while: put it back)
+                    applyFloat(true)
+                end
+            end
             if not aiOff and not aggro then self:enableAI(false); aiOff = true end
             local c = self.controls
             if attackGroup then
@@ -369,6 +405,11 @@ return {
         -- Another player attacked or cast: show the animation only. (The avatar has no AI and never deals damage.)
         MpAttack = function(d) playAttack(d) end,
         MpJump = function() jumpLeft = 0.15 end,
+        MpFloat = function(d)
+            floatOn = d.on and true or false
+            floatCheck = 0
+            applyFloat(floatOn)
+        end,
         -- The player cast a spell: its cast effect on their hands, or its effect on themselves
         MpCastVfx = function(d)
             local function static(id)
