From: Duron27 <duron27@gmail.com>
Subject: [PATCH] Ship the multiplayer mod with the engine's built-in scripts

The Multiplayer button on the main menu is in the engine, but the Lua behind it was a separate mod that had to be added to
openmw.cfg by hand. On desktop the build now copies multiplayer/mod into resources/vfs and appends mp.omwscripts to
builtin.omwscripts (and, through files/data-mw, to the Morrowind one), so the button works out of the box. The scripts do
nothing until a game is started from the Multiplayer screen.

- OPENMW_BUILTIN_MULTIPLAYER, ON by default, OFF on Android and iOS, which package the mod themselves (do not load it twice)
- l10n/Multiplayer/en.yaml: the words of the settings page choices (join / host)

---
diff --git a/files/data-mw/CMakeLists.txt b/files/data-mw/CMakeLists.txt
index 175eb75deb..a1b4790276 100644
--- a/files/data-mw/CMakeLists.txt
+++ b/files/data-mw/CMakeLists.txt
@@ -46,6 +46,9 @@ endforeach (f)
 
 # Concat data/builtin.omwscripts and data-mw/builtin.omwscripts.in to create vfs-mw/builtin.omwscripts
 set(builtinBase "${CMAKE_CURRENT_SOURCE_DIR}/../data/builtin.omwscripts")
+if (OPENMW_BUILTIN_OMWSCRIPTS) # (files/data: builtin.omwscripts with the multiplayer scripts added, when they are built in)
+    set(builtinBase "${OPENMW_BUILTIN_OMWSCRIPTS}")
+endif ()
 
 # https://gitlab.kitware.com/cmake/cmake/-/issues/20181
 if (NOT CMAKE_GENERATOR MATCHES "Ninja")
diff --git a/files/data/CMakeLists.txt b/files/data/CMakeLists.txt
index e1440a29de..a0786d887f 100644
--- a/files/data/CMakeLists.txt
+++ b/files/data/CMakeLists.txt
@@ -128,8 +128,6 @@ set(BUILTIN_DATA_FILES
     openmw_aux/calendarconfig.lua
     openmw_aux/ui.lua
 
-    builtin.omwscripts
-
     scripts/omw/activationhandlers.lua
     scripts/omw/ai.lua
     scripts/omw/camera/camera.lua
@@ -276,3 +274,32 @@ set(BUILTIN_DATA_FILES
 foreach (f ${BUILTIN_DATA_FILES})
     copy_resource_file("${CMAKE_CURRENT_SOURCE_DIR}/${f}" "${OPENMW_RESOURCES_ROOT}" "resources/vfs/${f}")
 endforeach (f)
+
+# The multiplayer mod (multiplayer/mod) ships with the engine: its scripts are appended to builtin.omwscripts, so the
+# Multiplayer button on the main menu works without editing openmw.cfg. They do nothing until a game is started from the
+# Multiplayer screen. Phone builds (Android, iOS) package the mod themselves and leave this off.
+if (ANDROID OR IOS)
+    set(OPENMW_BUILTIN_MULTIPLAYER_DEFAULT OFF)
+else ()
+    set(OPENMW_BUILTIN_MULTIPLAYER_DEFAULT ON)
+endif ()
+option(OPENMW_BUILTIN_MULTIPLAYER "Ship the multiplayer mod (multiplayer/mod) with the engine's built-in scripts" ${OPENMW_BUILTIN_MULTIPLAYER_DEFAULT})
+
+set(builtinScripts "${CMAKE_CURRENT_SOURCE_DIR}/builtin.omwscripts")
+set(MULTIPLAYER_MOD_DIR "${OpenMW_SOURCE_DIR}/multiplayer/mod")
+if (OPENMW_BUILTIN_MULTIPLAYER AND EXISTS "${MULTIPLAYER_MOD_DIR}/mp.omwscripts")
+    file(GLOB MULTIPLAYER_MOD_FILES CONFIGURE_DEPENDS RELATIVE "${MULTIPLAYER_MOD_DIR}"
+        "${MULTIPLAYER_MOD_DIR}/scripts/mp/*.lua" "${MULTIPLAYER_MOD_DIR}/l10n/*/*.yaml" "${MULTIPLAYER_MOD_DIR}/textures/*")
+    foreach (f ${MULTIPLAYER_MOD_FILES})
+        copy_resource_file("${MULTIPLAYER_MOD_DIR}/${f}" "${OPENMW_RESOURCES_ROOT}" "resources/vfs/${f}")
+    endforeach (f)
+    # builtin.omwscripts + the mod's script list. (files/data-mw builds its own copy from this one, so Morrowind games get it too.)
+    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${builtinScripts}" "${MULTIPLAYER_MOD_DIR}/mp.omwscripts")
+    file(READ "${builtinScripts}" BUILTIN_SCRIPTS_BASE)
+    file(READ "${MULTIPLAYER_MOD_DIR}/mp.omwscripts" MULTIPLAYER_SCRIPTS)
+    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/builtin.omwscripts" "${BUILTIN_SCRIPTS_BASE}\n# Multiplayer (multiplayer/mod)\n${MULTIPLAYER_SCRIPTS}\n")
+    set(builtinScripts "${CMAKE_CURRENT_BINARY_DIR}/builtin.omwscripts")
+    message(STATUS "Multiplayer mod: built in (OPENMW_BUILTIN_MULTIPLAYER)")
+endif ()
+set(OPENMW_BUILTIN_OMWSCRIPTS "${builtinScripts}" CACHE INTERNAL "builtin.omwscripts to ship (data-mw adds to it)")
+copy_resource_file("${builtinScripts}" "${OPENMW_RESOURCES_ROOT}" "resources/vfs/builtin.omwscripts")
diff --git a/multiplayer/mod/l10n/Multiplayer/en.yaml b/multiplayer/mod/l10n/Multiplayer/en.yaml
new file mode 100644
index 0000000000..6cda44925b
--- /dev/null
+++ b/multiplayer/mod/l10n/Multiplayer/en.yaml
@@ -0,0 +1,3 @@
+# Words the multiplayer settings page shows for its choices
+join: "Join a server"
+host: "Host a game"
