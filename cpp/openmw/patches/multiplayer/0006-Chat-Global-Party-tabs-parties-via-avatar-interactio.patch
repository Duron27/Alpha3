+        chatLine(d.scope, 'You', d.text, true)
+    elseif cmd == 'invite' then
+        net.send(net.encodeJson({ t = 'invite', to = d.id }))
+    elseif cmd == 'accept' then
+        net.send(net.encodeJson({ t = 'accept', from = d.id }))
