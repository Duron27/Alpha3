+-- DEBUG ONLY: gives the player a strong weapon (once per session, if they don't have one).
+local world = require('openmw.world')
+local types = require('openmw.types')
+
+local WEAPON = 'daedric longsword'
+local timer = 0
+local done = false
+
+return { engineHandlers = { onUpdate = function(dt)
+    local p = world.players[1]
+    if done or not p then return end
+    timer = timer + dt
+    if timer < 1 then return end
+    done = true
+    local inv = types.Actor.inventory(p)
+    if inv:countOf(WEAPON) == 0 then
+        world.createObject(WEAPON, 1):moveInto(inv)
+        print('[mp-debug] gave ' .. WEAPON)
+    end
+end } }
