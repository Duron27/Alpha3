+        writer.write((json.dumps(m, separators=(",", ":")) + "\n").encode())
+    await elect_host()
     try:
         async for line in reader:
             try:
@@ -43,6 +78,9 @@ async def handle(reader, writer):
             if not isinstance(msg, dict):
                 continue
             msg["id"] = cid
