index 0000000000..97aec82f53
--- /dev/null
+++ b/multiplayer/mod/scripts/mp/worldsync.lua
@@ -0,0 +1,186 @@
+-- Shared world state for the multiplayer test mod: game time, doors, picked-up items, dropped items.
+-- The relay server is the source of truth for the log of changes and replays it to late joiners.
+-- Objects are addressed by GameObject.id (identical on every client for content-file objects) or,
+-- for items dropped at runtime, by a canonical id "<senderId>/<senderLocalId>".
+local core = require('openmw.core')
+local world = require('openmw.world')
+local types = require('openmw.types')
+local util = require('openmw.util')
+
+local M = {}
+
+local ACTIVATION_CHECK_DELAY = 0.15
+local TIME_INTERVAL = 5
+local TIME_TOLERANCE = 0.05 -- game hours
+
+local ctx -- { send = function(table), log = function(...), myId = function() }
+local isHost = false
+local timeTimer = 0
+local checks = {} -- { obj, kind, wait }
+local pending = {} -- object id -> { take = true } | { door = bool }  (waiting for the object to load)
+local canon = {} -- local object id -> canonical id
+local byCanon = {} -- canonical id -> local object
+
+function M.init(context) ctx = context end
+
+function M.reset()
+    checks, pending, canon, byCanon = {}, {}, {}, {}
+    timeTimer = 0
+end
+
+function M.setHost(v) isHost = v end
+
+-- Stable cross-client id for an object defined by a content file: "<file>:<index within file>".
+-- GameObject.id embeds the load-order index of the file, so it can't be shared as is.
+local function contentId(obj)
+    local n = tonumber(obj.id)
+    if not obj.contentFile or not n then return nil end
+    return obj.contentFile .. ':' .. (n % 0x1000000)
+end
+
+local function netId(obj) return canon[obj.id] or contentId(obj) end
+
+local function objectById(id)
+    local file, index = tostring(id):match('^(.+):(%d+)$')
+    if not file then return nil end
+    local ok, obj = pcall(function() return world.getObjectByFormId(core.getFormId(file, tonumber(index))) end)
+    if ok and obj and obj:isValid() then return obj end
+    return nil
+end
+
+local function resolve(id)
+    local obj = byCanon[id]
+    if obj and obj:isValid() then return obj end
+    return objectById(id)
+end
+
+local function cellKey(cell) return cell.isExterior and '' or cell.name end
+
+------------------------------------------------------------------ outbound (local player actions)
+
+-- Called from the global onActivate handler. Never blocks activation.
+function M.onActivate(obj, actor)
+    if actor.type ~= types.Player or not netId(obj) then return end
+    if obj.type == types.Door then
+        if not types.Door.isTeleport(obj) then
+            checks[#checks + 1] = { obj = obj, kind = 'door', wait = ACTIVATION_CHECK_DELAY }
+        end
+    elseif types.Item.objectIsInstance(obj) then
+        checks[#checks + 1] = { obj = obj, kind = 'take', wait = ACTIVATION_CHECK_DELAY, nid = netId(obj) }
+    end
+end
+
+function M.onDropped(obj, actor, position, rotation)
+    if actor.type ~= types.Player then return end
+    local cid = tostring(ctx.myId()) .. '/' .. obj.id
+    canon[obj.id] = cid
+    byCanon[cid] = obj
+    ctx.send({
+        t = 'drop', cid = cid, rec = obj.recordId, count = obj.count,
+        cell = cellKey(actor.cell), pos = { position.x, position.y, position.z },
+        yaw = rotation:getYaw(),
+    })
+end
+
+local function runChecks(dt)
+    for i = #checks, 1, -1 do
+        local c = checks[i]
+        c.wait = c.wait - dt
+        if c.wait <= 0 then
+            table.remove(checks, i)
+            if c.kind == 'door' then
+                if c.obj:isValid() then
+                    local state = types.Door.getDoorState(c.obj)
+                    if state ~= types.Door.STATE.Idle then
+                        ctx.send({ t = 'door', oid = netId(c.obj), open = state == types.Door.STATE.Opening })
+                    end
+                end
+            elseif c.kind == 'take' then
+                if not c.obj:isValid() or c.obj.count == 0 then
+                    ctx.send({ t = 'take', oid = c.nid })
+                end
+            end
+        end
+    end
+end
+
+------------------------------------------------------------------ inbound
+
+local function applyDoor(obj, open)
+    if (open and types.Door.isClosed(obj)) or (not open and types.Door.isOpen(obj)) then
+        types.Door.activateDoor(obj, open)
+    end
+end
+
+local function applyTime(msg)
+    local ok, g = pcall(function() return world.mwscript.getGlobalVariables() end)
+    if not ok then return end
+    pcall(function()
+        local hourDiff = math.abs((g.gamehour or 0) - msg.hour)
+        if g.day ~= msg.day or g.month ~= msg.month or g.year ~= msg.year or hourDiff > TIME_TOLERANCE then
+            g.year, g.month, g.day, g.gamehour = msg.year, msg.month, msg.day, msg.hour
+        end
+    end)
+end
+
+local function sendTime()
+    local ok, g = pcall(function() return world.mwscript.getGlobalVariables() end)
+    if not ok then return end
+    ctx.send({ t = 'time', hour = g.gamehour, day = g.day, month = g.month, year = g.year })
+end
+
+-- Returns true if the message was a world-state message.
+function M.onMessage(msg)
+    if msg.t == 'door' then
+        local obj = objectById(msg.oid)
+        if obj then applyDoor(obj, msg.open) else pending[msg.oid] = { door = msg.open } end
+        return true
+    elseif msg.t == 'take' then
+        local obj = resolve(msg.oid)
+        if obj then
+            obj:remove()
+        else
+            pending[msg.oid] = { take = true }
+        end
+        return true
+    elseif msg.t == 'drop' then
+        if resolve(msg.cid) then return true end
+        local ok, obj = pcall(world.createObject, msg.rec, msg.count or 1)
+        if not ok then ctx.log('cannot create dropped item ' .. tostring(msg.rec)) return true end
+        canon[obj.id] = msg.cid
+        byCanon[msg.cid] = obj
+        obj:teleport(msg.cell or '', util.vector3(msg.pos[1], msg.pos[2], msg.pos[3]),
+            { rotation = util.transform.rotateZ(msg.yaw or 0) })
+        return true
+    elseif msg.t == 'time' then
+        applyTime(msg)
+        return true
+    end
+    return false
+end
+
+-- An object finished loading: apply changes that arrived while it was unloaded.
+function M.onObjectActive(obj)
+    local nid = netId(obj)
+    local p = nid and pending[nid]
+    if not p then return end
+    pending[nid] = nil
+    if p.take then
+        obj:remove()
+    elseif p.door ~= nil and obj.type == types.Door then
+        applyDoor(obj, p.door)
+    end
+end
+
+function M.onUpdate(dt)
+    runChecks(dt)
+    if isHost then
+        timeTimer = timeTimer + dt
+        if timeTimer >= TIME_INTERVAL then
+            timeTimer = 0
+            sendTime()
+        end
+    end
+end
+
+return M
