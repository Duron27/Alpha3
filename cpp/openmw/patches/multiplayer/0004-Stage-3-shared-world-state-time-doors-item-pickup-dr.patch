@@ -23,6 +24,37 @@ async def broadcast(msg, exclude=None):
             w.write(data)
 
 
+def world_replay():
+    for oid, open_ in world["doors"].items():
+        yield {"t": "door", "oid": oid, "open": open_}
+    for oid in world["takes"]:
+        yield {"t": "take", "oid": oid}
+    yield from world["drops"].values()
+    if world["time"]:
+        yield world["time"]
+
+
+def record_world(msg):
+    t = msg.get("t")
+    if t == "door" and "oid" in msg:
+        world["doors"][msg["oid"]] = bool(msg.get("open"))
+    elif t == "take" and "oid" in msg:
+        world["takes"].add(msg["oid"])
+        world["drops"].pop(msg["oid"], None)
+    elif t == "drop" and "cid" in msg:
+        world["drops"][msg["cid"]] = msg
+    elif t == "time":
+        world["time"] = msg
+    else:
+        return False
+    return True
+
+
+async def elect_host():
+    if clients:
+        await broadcast({"t": "host", "id": min(clients)})
+
+
 async def handle(reader, writer):
     global next_id
     cid, next_id = next_id, next_id + 1
@@ -34,6 +66,9 @@ async def handle(reader, writer):
