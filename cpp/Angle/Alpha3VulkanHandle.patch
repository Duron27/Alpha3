 #include "common/system_utils.h"
 
+#include <cstdlib>
+
 namespace angle
 {
 namespace vk
 {
+namespace
+{
+// Alpha3: the app loads a custom Vulkan driver (Turnip) through libadrenotools before the first Vulkan call and hands
+// the libvulkan handle over in ALPHA3_VULKAN_HANDLE (hex). The system libvulkan.so would bypass it, so use that one.
+void *AppLibVulkan()
+{
+    const char *text = getenv("ALPHA3_VULKAN_HANDLE");
+    return text && *text ? reinterpret_cast<void *>(strtoull(text, nullptr, 16)) : nullptr;
+}
+}  // namespace
+
+bool IsAppLibVulkan(void *library)
+{
+    return library && library == AppLibVulkan();
+}
+
 void *OpenLibVulkan()
 {
+    if (void *appLibrary = AppLibVulkan())
+    {
+        return appLibrary;
+    }
+
