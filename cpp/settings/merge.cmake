# Writes the template for the user's settings.cfg: OpenMW's own defaults (its files/settings-default.cfg, from the
# engine source being built) with Alpha3's changes on top (alpha3.cfg, then ios.cfg or fork.cfg where they apply).
#
#   cmake -DDEFAULTS=<openmw source>/files/settings-default.cfg -DOVERLAYS=a.cfg|b.cfg -DOUT=<file> -P merge.cmake
#
# A setting in an overlay replaces the default's value, and its comment when the overlay gives one; a setting the
# defaults do not have is added at the end of its section, and a section they do not have at the end of the file.
# Later overlays win. Everything else (order, comments, blank lines) stays as OpenMW has it.

cmake_minimum_required(VERSION 3.20)

if(NOT EXISTS "${DEFAULTS}")
    message(FATAL_ERROR "merge.cmake: no OpenMW defaults at '${DEFAULTS}'")
endif()

# A file as a CMake list of its lines; the characters that mean something in a list are swapped out first
function(alpha3_read_lines path out)
    file(READ "${path}" text)
    string(REPLACE "\r" "" text "${text}")
    string(REPLACE "\\" "@A3BS@" text "${text}")
    string(REPLACE ";" "@A3SC@" text "${text}")
    string(REPLACE "[" "@A3LB@" text "${text}")
    string(REPLACE "]" "@A3RB@" text "${text}")
    string(REPLACE "\n" ";" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# ---- the overlays
set(sections "")
string(REPLACE "|" ";" overlays "${OVERLAYS}")
foreach(overlay IN LISTS overlays)
    if(NOT EXISTS "${overlay}")
        message(FATAL_ERROR "merge.cmake: no overlay '${overlay}'")
    endif()
    alpha3_read_lines("${overlay}" lines)
    set(section "")
    set(comment "")
    foreach(line IN LISTS lines)
        string(STRIP "${line}" t)
        if(t STREQUAL "")
            set(comment "")
        elseif(t MATCHES "^#")
            string(APPEND comment "${t}\n")
        elseif(t MATCHES "^@A3LB@(.*)@A3RB@$")
            set(section "${CMAKE_MATCH_1}")
            set(comment "")
            string(MAKE_C_IDENTIFIER "${section}" sid)
            if(NOT DEFINED seen_${sid})
                set(seen_${sid} 1)
                list(APPEND sections "${section}")
                set(keys_${sid} "")
            endif()
        elseif(t MATCHES "^([^=]*)=(.*)$")
            string(STRIP "${CMAKE_MATCH_1}" key)
            string(STRIP "${CMAKE_MATCH_2}" value)
            if(section STREQUAL "")
                message(FATAL_ERROR "merge.cmake: '${key}' outside a section in '${overlay}'")
            endif()
            string(MAKE_C_IDENTIFIER "${section}__${key}" id)
            if(NOT DEFINED has_${id})
                set(has_${id} 1)
                list(APPEND keys_${sid} "${key}")
            endif()
            set(value_${id} "${value}")
            if(NOT comment STREQUAL "")
                set(comment_${id} "${comment}")
            endif()
            set(comment "")
        endif()
    endforeach()
endforeach()

# the overlay's settings of a section that the defaults did not have, after the defaults' own
macro(alpha3_add_new section_name)
    string(MAKE_C_IDENTIFIER "${section_name}" _sid)
    set(_added FALSE)
    foreach(_key IN LISTS keys_${_sid})
        string(MAKE_C_IDENTIFIER "${section_name}__${_key}" _id)
        if(NOT DEFINED done_${_id})
            set(done_${_id} 1)
            string(APPEND out "\n${comment_${_id}}${_key} = ${value_${_id}}\n")
            set(_added TRUE)
        endif()
    endforeach()
    if(_added)
        string(APPEND out "\n")
    endif()
endmacro()

# ---- the defaults, with the overlays applied
alpha3_read_lines("${DEFAULTS}" lines)
set(out "")
set(pending "")
set(section "")
set(started FALSE)
foreach(line IN LISTS lines)
    string(STRIP "${line}" t)
    # OpenMW's header ("users should NOT edit this file") does not belong in the user's settings.cfg
    if(NOT started)
        if(NOT t MATCHES "^@A3LB@")
            continue()
        endif()
        set(started TRUE)
    endif()
    if(t STREQUAL "")
        string(APPEND out "${pending}\n")
        set(pending "")
    elseif(t MATCHES "^#")
        string(APPEND pending "${line}\n")
    elseif(t MATCHES "^@A3LB@(.*)@A3RB@$")
        set(next "${CMAKE_MATCH_1}")
        if(NOT section STREQUAL "")
            alpha3_add_new("${section}")
        endif()
        string(APPEND out "${pending}${line}\n")
        set(pending "")
        set(section "${next}")
        string(MAKE_C_IDENTIFIER "${section}" sid)
        set(in_defaults_${sid} 1)
    elseif(t MATCHES "^([^=]*)=(.*)$")
        string(STRIP "${CMAKE_MATCH_1}" key)
        string(MAKE_C_IDENTIFIER "${section}__${key}" id)
        if(DEFINED has_${id})
            set(done_${id} 1)
            if(DEFINED comment_${id})
                set(pending "${comment_${id}}")
            endif()
            string(APPEND out "${pending}${key} = ${value_${id}}\n")
        else()
            string(APPEND out "${pending}${line}\n")
        endif()
        set(pending "")
    else()
        string(APPEND out "${pending}${line}\n")
        set(pending "")
    endif()
endforeach()
string(APPEND out "${pending}")
if(NOT section STREQUAL "")
    alpha3_add_new("${section}")
endif()
foreach(s IN LISTS sections)
    string(MAKE_C_IDENTIFIER "${s}" sid)
    if(NOT DEFINED in_defaults_${sid})
        string(APPEND out "\n@A3LB@${s}@A3RB@\n")
        alpha3_add_new("${s}")
    endif()
endforeach()

string(REPLACE "@A3LB@" "[" out "${out}")
string(REPLACE "@A3RB@" "]" out "${out}")
string(REPLACE "@A3SC@" ";" out "${out}")
string(REPLACE "@A3BS@" "\\" out "${out}")
string(REGEX REPLACE "\n\n\n+" "\n\n" out "${out}")

set(names "")
foreach(overlay IN LISTS overlays)
    get_filename_component(name "${overlay}" NAME)
    list(APPEND names "${name}")
endforeach()
list(JOIN names ", " names)
file(WRITE "${OUT}" "# Your OpenMW settings. Made from OpenMW's own defaults with Alpha3's changes (${names}) on top.
# Edit what you like: OpenMW reads this over its defaults (defaults.bin).

${out}")
